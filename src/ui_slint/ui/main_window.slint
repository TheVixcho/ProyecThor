import { ScrollView, LineEdit, TextEdit, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { GlassCard, GlassButton, IconButton, IslandIconButton, ItemRowActionBtn, ItemMoreBtn, SlideTile, SwitchRow, PadTile, ThemeSwatchButton, StyleGalleryCard, StyleScreenTarget, ScrubBar, SupportLinkCard } from "components.slint";
import { TopBar } from "topbar.slint";
import { StyledTextBlock } from "projector_window.slint";
import { AppleSettingsView } from "settings_view.slint";
export { Theme } from "theme.slint";
export { ProjectorWindow, StageWindow } from "projector_window.slint";
export { SplashWindow } from "splash_window.slint";
export { StyleScreenTarget } from "components.slint";

export struct LibraryItem {
    title: string,
    subtitle: string,
    path: string,
    thumbnail: image,
    has-thumbnail: bool,
}

export struct SlideItem {
    badge: string,
    body: string,
    ref-text: string,
}

export struct QueueItem {
    title: string,
    kind: string,
}

export struct PadItem {
    name: string,
    summary: string,
    assigned: bool,
}

export struct CaptureDeviceItem {
    name: string,
    uri: string,
}

export struct SmartTvItem {
    name: string,
    info: string,
    ip: string,
    active: bool,
}

export struct StyleCardItem {
    name: string,
    summary: string,
    text-color: color,
    box-bg: bool,
    font-family-name: string,
    font-weight-val: int,
    active-on-target: bool,
    assigned-screens-label: string,
    screen-targets: [StyleScreenTarget],
}

export struct VideoQueueItem {
    title: string,
    path: string,
    kind: string,
    playing: bool,
}

export struct BibleBookItem {
    name: string,
    chapters: int,
    is-nt: bool,
}

export struct SlideGridCell {
    index: int,
    badge: string,
    body: string,
    valid: bool,
}

export struct SlideGridRow {
    cells: [SlideGridCell],
}

export struct MusicTrackItem {
    title: string,
    subtitle: string,
    path: string,
    playing: bool,
    cover: image,
    has-cover: bool,
}

export struct MusicGridCell {
    index: int,
    title: string,
    subtitle: string,
    path: string,
    playing: bool,
    cover: image,
    has-cover: bool,
    valid: bool,
}

export struct MusicGridRow {
    cells: [MusicGridCell],
}

export struct BgFolderItem {
    name: string,
    rel-path: string,
    count: int,
}

export struct DocPageItem {
    number: int,
    preview: image,
    has-preview: bool,
}

export struct ActiveLayerItem {
    id: string,
    kind: string,
    title: string,
    subtitle: string,
    accent: color,
    thumbnail: image,
    has-thumbnail: bool,
}

export struct ScreenMatrixItem {
    id: int,
    name: string,
    role-badge: string,
    is-live: bool,
    is-targeted: bool,
    is-inspected: bool,
    is-custom-room: bool,
    bg-color: color,
    bg-image: image,
    has-bg-image: bool,
    bg-name: string,
    overlay-image: image,
    has-overlay-image: bool,
    overlay-name: string,
    live-text: string,
    live-ref: string,
    live-is-bible: bool,
    show-clock: bool,
    clock-text: string,
    alert-text: string,
    show-pleca: bool,
    pleca-title: string,
    queue-summary: string,
    use-own-style: bool,
    assigned-style-idx: int,
    style-name: string,
    text-size: float,
    text-align: int,
    text-valign: int,
    text-color: color,
    font-family-name: string,
    font-weight-val: int,
    text-shadow: bool,
    text-outline: bool,
    text-glow: bool,
    text-neon: bool,
    text-3d: bool,
    text-underline: bool,
    text-box-bg: bool,
    lyrics-pos-x: float,
    lyrics-pos-y: float,
    lyrics-width: float,
    lyrics-height: float,
}

export component MainWindow inherits Window {
    title: "ProyecThor — Open Source (Slint + libmpv)";
    preferred-width: 1420px;
    preferred-height: 860px;
    min-width: 1100px;
    min-height: 660px;
    background: Theme.bg-root;
    forward-focus: main-keys;

    // ── App State ──
    in-out property <int> active-tab: 13; // Opens on Biblioteca Hub
    in-out property <bool> library-menu-open: false;
    in-out property <bool> design-menu-open: false;
    in-out property <bool> net-menu-open: false;
    in-out property <bool> island-prefer-music: false;
    in-out property <bool> island-expanded: false;
    in-out property <bool> island-hidden: false;
    in property <string> app-version: "1.2.0";
    in property <image> logo-image;
    in property <bool> has-logo: false;
    in-out property <string> search-query: "";

    // Library, Slides & Service Queue
    in property <[LibraryItem]> library-items: [];
    in-out property <int> selected-library-index: -1;
    in property <string> selected-library-path: "";
    in property <string> selected-item-title: "Selecciona una canción o pasaje";

    // Unified Item Action / Rename / Delete Modal state
    // kind: 0=Canción, 1=Multimedia, 2=Documento, 3=Música, 4=Fondo, 5=Overlay
    // mode: 0=Acciones, 1=Cambiar Nombre, 2=Confirmar Eliminar
    in-out property <bool>   item-modal-open: false;
    in-out property <int>    item-modal-mode: 0;
    in-out property <int>    item-modal-kind: 0;
    in-out property <string> item-modal-title: "";
    in-out property <string> item-modal-subtitle: "";
    in-out property <string> item-modal-path: "";
    in-out property <string> item-modal-rename-input: "";

    function open-item-modal(mode: int, kind: int, title: string, subtitle: string, path: string) {
        root.item-modal-mode = mode;
        root.item-modal-kind = kind;
        root.item-modal-title = title;
        root.item-modal-subtitle = subtitle;
        root.item-modal-path = path;
        root.item-modal-rename-input = title;
        root.item-modal-open = true;
    }

    in property <[SlideItem]> slides: [];
    in property <[SlideGridRow]> slide-rows: [];
    in-out property <int> slide-columns: 3;   // 1..4 columns for song stanzas
    in-out property <int> slide-card-size: 1; // 0=Pequeño, 1=Medio, 2=Grande
    in-out property <int> active-slide-index: -1;
    in property <string> selected-song-author: "";
    in-out property <bool> media-seeking: false;
    in-out property <bool> music-seeking: false;

    in property <[QueueItem]> queue-items: [];
    in-out property <int> queue-category: 0; // 0=Letras, 1=Videos, 2=Overlays
    in property <[QueueItem]> overlay-queue-items: [];

    // Song Playlists state
    in property <[string]> song-playlist-names: [];
    in-out property <int> active-song-playlist-idx: -1;
    in-out property <bool> playlist-filter-active: false;
    in-out property <string> new-playlist-name: "";
    in property <int> active-playlist-song-count: 0;

    // Song Editor inline state
    in-out property <bool> song-editor-open: false;
    in-out property <string> editor-song-title: "";
    in-out property <string> editor-song-author: "";
    in-out property <string> editor-song-body: "";

    // Bible fullscreen state
    in property <string> current-bible-name: "Sin Biblia";
    in property <[string]> bible-version-names: [];
    in-out property <int> selected-bible-version-idx: 0;
    in-out property <bool> bible-version-menu-open: false;
    in-out property <string> bible-search-query: "";
    in-out property <int> bible-testament-filter: 0; // 0=Todos, 1=AT, 2=NT
    in-out property <int> bible-submode: 0;          // 0=Libros/Capítulos, 1=Historial, 2=Favoritos
    in property <[BibleBookItem]> bible-books: [];
    in-out property <int> selected-bible-book-idx: -1;
    in property <[int]> bible-chapter-numbers: [];
    in-out property <int> selected-chapter: 1;
    in property <int> chapter-count: 1;
    in property <[SlideItem]> bible-history: [];
    in property <[SlideItem]> bible-favorites: [];

    // Backgrounds vs Overlays sub-tab (when active-tab == 3)
    in-out property <int> bg-subtab: 0; // 0=Fondos, 1=Overlays PNG

    // Live Projection State
    in-out property <bool> audience-live: false;
    in-out property <bool> stage-live: false;
    in-out property <bool> audience-frozen: false;
    in-out property <bool> scale-menu-open: false;
    in-out property <int> bg-scale-mode: 0; // 0=Recortar/Llenar, 1=Estirar, 2=Original
    in-out property <int> output-res-preset: 1; // 0=720p, 1=1080p, 2=16:10, 3=4:3, 4=2160p
    in-out property <int> target-fps: 60; // 30, 60, 120
    in property <bool> bg-is-static-image: false;
    in property <string> live-text: "";
    in property <string> live-ref: "";
    in property <bool> live-is-bible: false;
    in property <string> live-bg-name: "Sin fondo";
    in property <color> live-bg-solid-color: #030304;
    in property <string> live-overlay-name: "Sin overlay";
    in property <[LibraryItem]> bg-dock-items: [];
    in property <[BgFolderItem]> bg-folders: [];
    in property <string> bg-current-folder-label: "Raíz";
    in property <bool> bg-can-go-up: false;
    in-out property <bool> bg-new-folder-open: false;
    in-out property <string> bg-new-folder-name: "";
    in property <[LibraryItem]> overlay-layer-items: [];
    in-out property <int> bg-dock-tab: 0; // Contenido panel: 0=Fondos, 1=Overlays PNG, 2=Estilos rápidos
    in-out property <bool> bg-dock-expanded: true;
    in-out property <string> custom-overlay-title: "";
    in-out property <string> custom-overlay-sub: "";
    in-out property <bool> custom-overlay-active: false;
    in property <image> live-preview-image;
    in property <bool> has-live-preview-image: false;
    in property <image> live-overlay-image;
    in property <bool> has-live-overlay-image: false;

    // Media Playback State (libmpv)
    in-out property <bool> media-paused: false;
    in-out property <bool> media-muted: false;
    in-out property <bool> media-loop: false;
    in-out property <float> media-volume: 100.0;
    in-out property <float> media-position: 0.0;
    in property <string> media-time-label: "00:00 / 00:00";

    // Design, Typography, Shaders, Transitions, Tiles & Alerts (Tab 4)
    in-out property <int> design-subtab: 0; // 0=Estilos, 1=Shaders/EQ, 2=Transiciones, 3=Tiles
    in-out property <float> text-size: 60.0;
    in-out property <int> text-align: 1;   // 0=Left, 1=Center, 2=Right
    in-out property <int> text-valign: 1;  // 0=Top, 1=Center, 2=Bottom
    in-out property <int> text-color-idx: 0;
    in property <color> text-color: #ffffff;
    in-out property <int> font-family-idx: 0; // 0=Default, 1=Sans, 2=Serif, 3=Mono
    in-out property <string> font-family-name: "";
    in-out property <int> font-weight-idx: 1; // 0=Regular(400), 1=Bold(700), 2=Black(900)
    in-out property <bool> text-shadow: true;
    in-out property <bool> text-outline: false;
    in-out property <bool> text-glow: false;
    in-out property <bool> text-neon: false;
    in-out property <bool> text-3d: false;
    in-out property <bool> text-underline: false;
    in-out property <bool> text-uppercase: false;
    in-out property <bool> text-box-bg: false;
    in-out property <int> text-fit-mode: 0; // 0=Normal, 1=Auto-Achicar si no cabe, 2=Auto-Cortar en bloques
    in-out property <float> text-margin-h: 64.0;
    in-out property <float> lyrics-pos-x: 0.5;
    in-out property <float> lyrics-pos-y: 0.5;
    in-out property <float> lyrics-width: 0.90;
    in-out property <float> lyrics-height: 0.55;
    in-out property <bool> index-box-enabled: true;
    in-out property <float> index-pos-x: 0.5;
    in-out property <float> index-pos-y: 0.86;
    in-out property <float> index-width: 0.50;
    in-out property <float> index-height: 0.14;
    in-out property <float> index-size: 30.0;
    in-out property <int> index-align: 1;
    in-out property <int> index-font-family-idx: 0;
    in-out property <string> index-font-family-name: "";
    in-out property <int> index-font-weight-idx: 1;
    in property <[string]> system-font-names: [];
    in-out property <bool> font-picker-open: false;
    in-out property <int> font-picker-target: 0; // 0=Letras, 1=Índice
    in-out property <string> font-picker-search: "";
    in property <color> index-color: #fbbf24;
    in-out property <float> index-color-r: 251.0;
    in-out property <float> index-color-g: 191.0;
    in-out property <float> index-color-b: 36.0;
    in-out property <bool> index-shadow: true;
    in-out property <bool> index-outline: false;
    in-out property <bool> index-glow: false;
    in-out property <bool> index-box-bg: true;
    in-out property <bool> index-uppercase: false;
    in-out property <int> style-editor-box: 0;    // 0=Caja Letras, 1=Caja Índice (Solo Biblia)
    in-out property <bool> style-editor-open: false;
    property <bool> is-style-editor-active: root.active-tab == 4 && root.design-subtab == 0 && root.style-editor-open;
    in-out property <string> editing-style-name: "";
    in-out property <float> text-color-r: 255.0;
    in-out property <float> text-color-g: 255.0;
    in-out property <float> text-color-b: 255.0;
    in-out property <int> active-saved-style-idx: -1;
    in-out property <int> style-target-mode: 0; // 0=Todas, 1=Público, 2=LAN, 3=Stage, >=4=Sala Extra
    in property <string> style-target-label: "Todas las pantallas";
    in property <[StyleCardItem]> saved-style-cards: [];

    // Media / Background Preview, Hover Video Preview & Video Queue
    in property <image> selected-media-preview;
    in property <bool> has-selected-media-preview: false;
    in property <string> selected-media-info: "";
    in-out property <int> hovered-library-index: -1;
    in-out property <int> hovered-dock-index: -1;
    in property <image> hover-video-frame;
    in-out property <bool> has-hover-video-frame: false;
    in property <[VideoQueueItem]> video-queue-items: [];
    in-out property <bool> video-queue-playing: false;
    in-out property <bool> video-queue-loop: false;

    // Shaders & Video/Audio Filters (libmpv)
    in-out property <float> shader-brightness: 0.0;
    in-out property <float> shader-contrast: 0.0;
    in-out property <float> shader-saturation: 0.0;
    in-out property <float> shader-gamma: 0.0;
    in-out property <bool> shader-blur: false;
    in-out property <bool> shader-vignette: false;
    in-out property <int> shader-preset: 0;
    in-out property <bool> eq-enabled: false;
    in-out property <float> eq-bass: 0.0;
    in-out property <float> eq-mid: 0.0;
    in-out property <float> eq-treble: 0.0;

    // Transitions + Live Animated Preview
    in-out property <int> transition-type: 1; // 0=None, 1=Fade, 2=SlideLeft, 3=SlideUp, 4=SlideRight
    in-out property <float> transition-duration-ms: 350.0;
    in-out property <int> active-transition-preset: 1;
    in-out property <bool> trans-preview-visible: true;
    in-out property <duration> trans-preview-dur: 350ms;

    // Tiles (Split Screen)
    in-out property <bool> tiles-enabled: false;
    in-out property <int> tiles-layout: 0;      // 0=2 Cols, 1=2 Rows
    in-out property <bool> tiles-divider: true;
    in-out property <int> tiles-continuity: 0;  // 0=Actual+Siguiente, 1=Anterior+Actual

    in-out property <string> alert-input: "";
    in property <string> active-public-alert: "";
    in property <string> active-stage-alert: "";
    in-out property <int> alert-anim-mode: 1; // 0=Estático, 1=Letrero (Marquee), 2=Deslizar, 3=Pulso
    in-out property <int> alert-position: 0;  // 0=Abajo, 1=Arriba
    in-out property <int> alert-theme: 0;     // 0=Oscuro, 1=Rojo Urgente, 2=Ámbar, 3=Azul
    in property <float> alert-ticker-pos: 0.0;
    in property <float> alert-pulse-alpha: 1.0;

    // Clock & Countdown Timer
    in property <string> clock-now-text: "00:00:00";
    in property <string> timer-display-text: "05:00";
    in-out property <bool> timer-running: false;
    in-out property <bool> show-clock-on-public: false;
    in-out property <bool> timer-mode-countdown: true;

    // Photoshop-Style Real Active Layers & Multi-Screen / Multi-Room Output Matrix
    in property <[ActiveLayerItem]> active-layers: [];
    in property <[ScreenMatrixItem]> screen-matrix-items: [];
    in-out property <int> output-target-mode: 0; // 0=Todas, 1=Solo Público, 2=Solo LAN, 3=Solo Stage, >=4=Sala Extra
    in-out property <int> inspected-screen-idx: 0; // 0=Público, 1=LAN, 2=Stage, >=3=Sala Extra
    in property <string> inspected-screen-name: "Público";
    in property <bool> preview-has-video-bg: false;
    in property <bool> preview-show-clock: false;
    in property <string> preview-clock-text: "";
    in property <bool> preview-show-pleca: false;
    in property <string> preview-pleca-title: "";
    in property <string> preview-pleca-sub: "";
    in property <string> preview-style-name: "Predeterminado";
    in property <bool> preview-own-style: false;
    in property <float> preview-text-size: 60.0;
    in property <int> preview-text-align: 1;
    in property <int> preview-text-valign: 1;
    in property <color> preview-text-color: #ffffff;
    in property <string> preview-font-family-name: "";
    in property <int> preview-font-weight-val: 700;
    in property <bool> preview-text-shadow: true;
    in property <bool> preview-text-outline: false;
    in property <bool> preview-text-glow: false;
    in property <bool> preview-text-neon: false;
    in property <bool> preview-text-3d: false;
    in property <bool> preview-text-underline: false;
    in property <bool> preview-text-box-bg: false;
    in property <int> preview-text-fit-mode: 0;
    in property <float> preview-lyrics-pos-x: 0.5;
    in property <float> preview-lyrics-pos-y: 0.5;
    in property <float> preview-lyrics-width: 0.90;
    in property <float> preview-lyrics-height: 0.55;
    in property <bool> preview-index-box-enabled: true;
    in property <float> preview-index-pos-x: 0.5;
    in property <float> preview-index-pos-y: 0.86;
    in property <float> preview-index-width: 0.50;
    in property <float> preview-index-height: 0.14;
    in property <float> preview-index-size: 30.0;
    in property <int> preview-index-align: 1;
    in property <color> preview-index-color: #fbbf24;
    in property <string> preview-index-font-family-name: "";
    in property <int> preview-index-font-weight-val: 700;
    in property <bool> preview-index-shadow: true;
    in property <bool> preview-index-outline: false;
    in property <bool> preview-index-glow: false;
    in property <bool> preview-index-box-bg: true;
    in-out property <string> new-room-name: "";

    // Pads (8 quick scene pads)
    in property <[PadItem]> pads: [];

    // Capture Devices (Tab 8)
    in property <string> capture-status: "Conecta una capturadora HDMI o cámara USB y pulsa Refrescar.";
    in property <[CaptureDeviceItem]> capture-devices: [];
    in-out property <int> selected-capture-idx: -1;

    // Network Hub (Tab 5): Servicios 100% independientes (Video LAN, Smart TV Cast, Chat LAN, Celular, Reloj, OSC)
    in-out property <int> net-subtab: 0; // 0=Transmisión LAN, 1=Chat LAN, 2=Celular, 3=Reloj, 4=Luces OSC
    in-out property <bool> lan-running: false;
    in property <string> lan-url: "Inactivo — pulsa Iniciar para transmitir video/letras en tu red local";
    in-out property <string> lan-host-ip: "";
    in-out property <string> lan-port-input: "8080";
    in-out property <bool> lan-transparent: false;
    in-out property <bool> lan-send-bg: true;
    in-out property <bool> lan-send-text: true;
    in-out property <bool> lan-send-overlay: true;
    in-out property <bool> lan-own-style: false;
    in property <int> lan-assigned-style-idx: -1;
    in property <string> lan-style-summary: "Siguiendo estilo de Público";
    in-out property <bool> lan-high-quality: true;
    in-out property <int> lan-res-preset: 1;     // 0=640x360, 1=1280x720, 2=1920x1080
    in-out property <int> lan-video-mode: 1;     // 0=Ahorro(LowLatency), 1=Normal(HighQuality), 2=Máxima(UltraStable)
    in-out property <int> lan-target-fps: 30;    // 30 or 60 (for UltraStable)
    in-out property <float> lan-jpeg-quality: 80.0;
    in-out property <string> lan-copy-feedback: "Copiar";
    in property <image> lan-qr-image;
    in property <bool> has-lan-qr: false;

    // Smart TV Screen Sharing (DLNA / UPnP + IP directa) & Firewall Diagnosis
    in property <[SmartTvItem]> smart-tv-devices: [];
    in-out property <string> smart-tv-manual-ip: "";
    in property <string> smart-tv-status: "Pulsa 'Buscar Smart TVs' o escribe la IP de tu Smart TV para enviar la pantalla (DLNA / Wi-Fi).";
    in property <bool> smart-tv-scanning: false;
    in property <string> lan-firewall-status: "Comprobando firewall local...";
    in property <bool> lan-firewall-warning: false;

    // Tab 9: Música (Grid de Audio Independiente + Carpetas de Escaneo)
    in property <[MusicTrackItem]> music-tracks: [];
    in property <[MusicGridRow]> music-grid-rows: [];
    in property <[string]> music-scan-folders: [];
    in-out property <string> music-folder-input: "";

    // Tab 13: Biblioteca Principal (Hub Unificado)
    in property <int> hub-songs-count: 0;
    in property <int> hub-media-count: 0;
    in property <int> hub-music-count: 0;
    in property <int> hub-docs-count: 0;
    in property <int> hub-bibles-count: 0;
    in property <[LibraryItem]> hub-recent-songs: [];
    in property <[LibraryItem]> hub-recent-media: [];
    in property <[MusicTrackItem]> hub-recent-music: [];
    in property <[LibraryItem]> hub-recent-docs: [];
    in property <string> music-now-playing: "Sin pista en reproducción";
    in property <string> music-now-subtitle: "Selecciona una pista para reproducir";
    in-out property <bool> music-playing: false;
    in-out property <bool> music-paused: false;
    in-out property <bool> music-loop: false;
    in-out property <float> music-volume: 85.0;
    in-out property <float> music-position: 0.0;
    in property <string> music-time-label: "00:00 / 00:00";
    in property <image> music-now-cover;
    in property <bool> has-music-now-cover: false;

    // Real-Time Audio Waveform + 5-Band Music EQ + ProyecThor Dynamic EQ
    in property <[float]> music-live-wave: [0.12, 0.16, 0.22, 0.14, 0.26, 0.18, 0.24, 0.15, 0.20, 0.16, 0.18, 0.12];
    in property <[float]> music-track-waveform: [
        0.18, 0.24, 0.35, 0.42, 0.30, 0.52, 0.68, 0.60, 0.48, 0.72,
        0.84, 0.76, 0.65, 0.58, 0.70, 0.90, 0.85, 0.72, 0.55, 0.64,
        0.78, 0.88, 0.92, 0.80, 0.68, 0.74, 0.82, 0.70, 0.56, 0.62,
        0.76, 0.84, 0.72, 0.60, 0.48, 0.52, 0.42, 0.34, 0.26, 0.18
    ];
    in-out property <bool> music-eq-enabled: false;
    in-out property <bool> music-dynamic-eq: false;
    in property <string> music-dynamic-eq-status: "Inactiva — activa para nivelación y balance espectral adaptativo";
    in-out property <int> music-eq-preset: 0;
    in-out property <float> music-eq-60: 0.0;
    in-out property <float> music-eq-230: 0.0;
    in-out property <float> music-eq-910: 0.0;
    in-out property <float> music-eq-3600: 0.0;
    in-out property <float> music-eq-12000: 0.0;

    // Tab 10: Documentos (PDF / Presentaciones)
    in property <[DocPageItem]> doc-pages: [];
    in property <string> doc-title: "Documentos — Selecciona un PDF o documento";
    in property <string> doc-status: "Coloca archivos .pdf o imágenes en assets/documents o pulsa Importar.";
    in-out property <int> active-doc-page-idx: -1;

    // Tab 11: Ayuda y Novedades (Changelog)
    in-out property <int> help-subtab: 0; // 0=Guía y Atajos, 1=Novedades / Changelog
    in-out property <bool> tutorial-modal-open: true;
    in-out property <bool> show-tutorial-on-start: true;
    in-out property <bool> tutorial-dont-show-again: false;
    in-out property <int> help-qr-idx: 1; // 0=Web, 1=Discord, 2=Instagram, 3=WhatsApp
    in-out property <image> help-qr-image;
    in-out property <string> help-qr-label: "Discord (Soporte y Comunidad)";
    in-out property <string> help-qr-url: "https://discord.gg/FKqgPDZpBF";
    in property <string> changelog-text: "";

    // Tab 12: Consola Debug
    in property <string> debug-stats: "";
    in property <string> debug-fps-text: "0.0";
    in property <string> debug-video-fps-text: "Sin video";
    in property <string> debug-cpu-text: "0.0%";
    in property <string> debug-ram-text: "0.0 MB";
    in property <string> debug-peak-ram-text: "Pico 0.0 MB";
    in property <string> debug-paths: "";
    in property <string> debug-log: "";

    in-out property <bool> chat-running: false;
    in property <string> chat-url: "Inactivo — inicia el Chat de Equipo sin activar transmisión de video";
    in property <image> chat-qr-image;
    in property <bool> has-chat-qr: false;

    in-out property <bool> mobile-running: false;
    in property <string> mobile-url: "Inactivo — pulsa Iniciar para conectar tu celular";
    in property <string> mobile-pin: "000000";
    in property <image> mobile-qr-image;
    in property <bool> has-mobile-qr: false;

    in property <string> chat-log: "Pulsa 'Iniciar Chat LAN (Puerto 8082)' para abrir el chat ligero sin video.";
    in-out property <string> chat-input: "";

    in-out property <string> osc-host: "127.0.0.1";
    in-out property <string> osc-port: "9000";
    in-out property <string> osc-address: "/cue/1";
    in-out property <string> osc-args: "1";
    in property <string> osc-status: "Listo para enviar mensajes OSC (QLC+, grandMA, Resolume, TouchOSC)";

    // Settings, Themes, GPU/NVENC, Upscalers & Updater
    in-out property <int> active-theme-idx: 0;
    in-out property <bool> fsr-enabled: true;
    in-out property <int> gpu-hwdec-mode: 0;        // 0=Auto, 1=NVIDIA(NVDEC/CUDA), 2=D3D11VA, 3=VAAPI/Vulkan, 4=CPU
    in-out property <bool> nvenc-enabled: false;
    in property <string> gpu-status-label: "Detectando aceleración de hardware GPU...";
    in-out property <int> upscaler-mode: 2;         // 0=Off(Bilinear), 1=FSR 1.0, 2=FidelityFX CAS+, 3=NVIDIA NIS, 4=LanczosHQ 4K
    in-out property <float> upscaler-sharpness: 55.0; // 0..100%
    in-out property <bool> smooth-motion-60: false; // Interpolación 24/30 -> 60 FPS
    in-out property <bool> performance-mode: false;
    in-out property <bool> fullscreen-output: true;
    in-out property <bool> enable-glass-translucency: true;
    in-out property <bool> enable-glass-sheen: true;
    in-out property <bool> enable-ambient-bg: true;
    in property <string> update-status: "Listo para comprobar en GitHub Releases (TheVixcho/ProyecThor)";

    // ── Callbacks to C++ Core ──
    callback tab-changed(int);
    callback bg-subtab-changed(int);
    callback search-changed(string);
    callback library-item-selected(int);
    callback slide-clicked(int);
    callback slide-columns-changed(int);
    callback next-slide();
    callback prev-slide();

    // Song Editor
    callback new-song-clicked();
    callback edit-song-clicked();
    callback save-song-clicked(string, string, string);
    callback cancel-song-editor();

    // Service Queue (3 categories: Letras, Videos, Overlays) & Song Playlists
    callback add-current-to-queue();
    callback queue-item-clicked(int);
    callback clear-queue();
    callback add-overlay-to-queue();
    callback overlay-queue-clicked(int);
    callback clear-overlay-queue();
    callback create-song-playlist(string);
    callback select-song-playlist(int);
    callback toggle-playlist-filter();
    callback add-song-to-playlist();
    callback send-playlist-to-queue();
    callback delete-song-playlist(int);

    // Bible Fullscreen
    callback cycle-bible-version();
    callback bible-version-selected(int);
    callback import-bible-clicked();
    callback bible-search-submitted(string);
    callback bible-search-edited(string);
    callback bible-filter-changed(int);
    callback bible-book-selected(int);
    callback bible-chapter-changed(int);
    callback bible-favorite-current();
    callback bible-history-clicked(int);
    callback bible-favorite-clicked(int);

    // Media Preview, Hover Preview & Video Queue
    callback library-item-hovered(int);
    callback dock-bg-hovered(int);
    callback project-selected-media();
    callback add-selected-to-video-queue();
    callback toggle-video-queue-play();
    callback prev-video-queue();
    callback next-video-queue();
    callback play-video-queue-item(int);
    callback move-video-queue-item(int, int);
    callback remove-video-queue-item(int);
    callback clear-video-queue();

    // Live Output, Freeze, Scaling/FSR & Manual Scan
    callback toggle-audience();
    callback close-audience-if-open();
    callback toggle-stage();
    callback toggle-freeze();
    callback scale-mode-changed(int);
    callback output-res-changed(int);
    callback target-fps-changed(int);
    callback scan-libraries();
    callback bg-folder-entered(string);
    callback bg-folder-up();
    callback bg-folder-created(string);
    callback clear-text();
    callback clear-background();
    callback clear-overlay();
    callback clear-all();

    // Music Player (Tab 9)
    callback music-track-clicked(int);
    callback music-toggle-pause();
    callback music-stop();
    callback music-prev();
    callback music-next();
    callback music-toggle-loop();
    callback music-volume-changed(float);
    callback music-seek-changed(float);
    callback import-music-clicked();
    callback browse-music-folder();
    callback add-music-folder(string);
    callback remove-music-folder(int);
    callback music-eq-changed();
    callback music-eq-preset-selected(int);
    callback music-dynamic-eq-toggled(bool);

    // Library Hub (Tab 13)
    callback hub-open-song(string);
    callback hub-open-media(string);
    callback hub-play-music(int);
    callback hub-open-doc(string);

    // Documents (Tab 10)
    callback doc-page-clicked(int);
    callback doc-prev-page();
    callback doc-next-page();
    callback import-document-clicked();

    // Debug (Tab 12) & Firewall
    callback debug-clear-log();
    callback debug-refresh();
    callback open-firewall-ports();

    // Media Transport
    callback toggle-pause();
    callback stop-media();
    callback toggle-mute();
    callback toggle-loop();
    callback volume-changed(float);
    callback seek-changed(float);

    // Design, Full Style Editor, Shaders, Transitions, Tiles & Alerts
    callback style-changed();
    callback font-preset-selected(int, int);       // (targetBox 0=Letras/1=Index, preset 0..3)
    callback system-font-selected(int, string);    // (targetBox 0=Letras/1=Index, familyName)
    callback font-search-changed(string);
    callback open-new-style-editor();
    callback open-edit-style-editor(int);
    callback save-style-editor(string);
    callback cancel-style-editor();
    callback duplicate-custom-style(int);
    callback load-custom-style(int);
    callback delete-custom-style(int);
    callback select-style-target(int);
    callback apply-style-to-screen(int, int); // (styleIdx, screenIdx: -1=Todas, >=0=screen)
    callback set-screen-own-style(int, bool); // (screenIdx, useOwnStyle)
    callback text-color-rgb-changed(float, float, float);
    callback text-color-selected(int);
    callback index-color-rgb-changed(float, float, float);
    callback index-color-selected(int);
    callback shaders-changed();
    callback reset-shaders();
    callback eq-changed();
    callback apply-eq-preset(int);
    callback transition-changed();
    callback select-transition-preset(int);
    callback replay-transition-preview();
    callback test-transition();
    callback tiles-changed();
    callback send-public-alert(string);
    callback send-stage-alert(string);
    callback alert-config-changed();
    callback clear-alerts();

    // Clock & Timer
    callback timer-set-minutes(int);
    callback timer-toggle();
    callback timer-reset();
    callback clock-overlay-toggled(bool);

    // Real Active Layer Stack (Photoshop-style) & Multi-Screen / Multi-Room Routing
    callback remove-active-layer(string);
    callback select-output-target(int);
    callback inspect-screen(int);
    callback screen-toggle-layer(int, string);
    callback screen-send-current(int);
    callback screen-clone-public(int);
    callback screen-clear-all(int);
    callback create-extra-screen(string);
    callback delete-extra-screen(int);

    // Pads
    callback pad-triggered(int);
    callback pad-saved(int);

    // Capture Devices
    callback refresh-capture-devices();
    callback start-capture-device(int);
    callback stop-capture-or-url();

    // Network Hub (Servicios independientes — LAN con paridad completa de ImGui)
    callback toggle-lan-stream();
    callback lan-config-changed();
    callback copy-lan-url();
    callback scan-smart-tvs();
    callback cast-to-smart-tv(int);
    callback cast-to-smart-tv-ip(string);
    callback stop-smart-tv-cast(int);
    callback toggle-chat-server();
    callback toggle-mobile-server();
    callback regenerate-mobile-pin();
    callback send-chat-message(string);
    callback send-osc(string, string, string, string);

    // Themes & Settings
    callback theme-selected(int);
    callback import-file-clicked();
    callback import-background-clicked();
    callback import-overlay-clicked();
    callback dock-bg-selected(int);
    callback overlay-layer-selected(int);
    callback overlay-layer-add-to-queue(int);
    callback dock-solid-color-selected(int);
    callback custom-overlay-toggled(string, string, bool);
    callback open-legacy-imgui();
    callback fsr-changed(bool);
    callback gpu-config-changed();
    callback apply-low-spec-preset();
    callback purge-ram-cache();
    callback performance-mode-changed(bool);
    callback fullscreen-changed(bool);
    callback visual-effects-changed();
    callback check-github-updates();
    callback open-kofi-donations();
    callback open-website();
    callback open-discord();
    callback open-instagram();
    callback open-whatsapp();
    callback select-help-qr(int);
    callback tutorial-preference-changed(bool);

    // Unified Library File Management (Play/Screen, Queue, Rename, Delete)
    callback item-action-play(int, string);
    callback item-action-queue(int, string);
    callback item-action-rename(int, string, string);
    callback item-action-delete(int, string);

    changed active-tab => {
        root.tab-changed(root.active-tab);
    }

    main-keys := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.item-modal-open) {
                    root.item-modal-open = false;
                    return accept;
                }
                if (root.font-picker-open) {
                    root.font-picker-open = false;
                    return accept;
                }
                if (root.island-expanded) {
                    root.island-expanded = false;
                    return accept;
                }
                if (root.library-menu-open) {
                    root.library-menu-open = false;
                    return accept;
                }
                if (root.design-menu-open) {
                    root.design-menu-open = false;
                    return accept;
                }
                if (root.net-menu-open) {
                    root.net-menu-open = false;
                    return accept;
                }
                if (root.scale-menu-open) {
                    root.scale-menu-open = false;
                    return accept;
                }
                if (root.bible-version-menu-open) {
                    root.bible-version-menu-open = false;
                    return accept;
                }
                if (root.audience-live) {
                    root.close-audience-if-open();
                    return accept;
                }
                return reject;
            }
            if (!root.song-editor-open && !root.is-style-editor-active) {
                if (event.text == Key.RightArrow || event.text == Key.DownArrow || event.text == Key.PageDown) {
                    if (root.active-tab == 10) {
                        root.doc-next-page();
                        return accept;
                    }
                    if (root.active-tab == 0 || root.active-tab == 1) {
                        root.next-slide();
                        return accept;
                    }
                }
                if (event.text == Key.LeftArrow || event.text == Key.UpArrow || event.text == Key.PageUp) {
                    if (root.active-tab == 10) {
                        root.doc-prev-page();
                        return accept;
                    }
                    if (root.active-tab == 0 || root.active-tab == 1) {
                        root.prev-slide();
                        return accept;
                    }
                }
            }
            return reject;
        }

        // Ambient Liquid Glass depth backdrop (toggleable in Ajustes > Apariencia)
        Rectangle {
            width: 100%;
            height: 100%;
            background: root.enable-ambient-bg
                ? @linear-gradient(135deg, Theme.accent.transparentize(0.90) 0%, Theme.bg-root 42%, Theme.accent-strong.transparentize(0.93) 100%)
                : Theme.bg-root;
        }

        VerticalLayout {
            // ── Top Floating Bar (Apple Liquid Glass islands + circular buttons) ──
        topbar := TopBar {
            active-tab <=> root.active-tab;
            design-subtab <=> root.design-subtab;
            net-subtab <=> root.net-subtab;
            app-version: root.app-version;
            logo-image: root.logo-image;
            has-logo: root.has-logo;
            audience-live: root.audience-live;
            stage-live: root.stage-live;
            audience-frozen: root.audience-frozen;
            scale-menu-open <=> root.scale-menu-open;
            library-menu-open <=> root.library-menu-open;
            design-menu-open <=> root.design-menu-open;
            net-menu-open <=> root.net-menu-open;
            bg-scale-mode: root.bg-scale-mode;
            toggle-audience => { root.toggle-audience(); }
            toggle-stage => { root.toggle-stage(); }
            toggle-freeze => { root.toggle-freeze(); }
            clear-all => { root.clear-all(); }
            scan-libraries => { root.scan-libraries(); }
            open-kofi-donations => { root.open-kofi-donations(); }
        }

        // ── Main 3-Column Workspace (Full-Screen when Style Editor or Settings is active) ──
        HorizontalLayout {
            padding: root.active-tab == 7 ? 6px : 10px;
            spacing: root.active-tab == 7 ? 0px : 10px;
            vertical-stretch: 1;

            // ═════════════════════════════════════════════════════════════════
            //  COLUMN 1: LIBRARY SIDEBAR + PANEL DE CONTENIDO (Fondos, Overlays, Estilos)
            // ═════════════════════════════════════════════════════════════════
            if !root.is-style-editor-active && root.active-tab != 7 : VerticalLayout {
                width: 306px;
                spacing: 10px;

                if root.active-tab == 0 || root.active-tab == 2 || root.active-tab == 10 : GlassCard {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 11px;
                        spacing: 9px;

                        // Sidebar header + essential actions (no redundant '+' buttons!)
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: root.active-tab == 0 ? "Canciones"
                                    : root.active-tab == 2 ? "Multimedia"
                                    : "Documentos";
                                color: Theme.text-primary;
                                font-size: 13.5px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            HorizontalLayout {
                                spacing: 5px;
                                IconButton {
                                    icon: @image-url("icons/upload.svg");
                                    clicked => {
                                        if (root.active-tab == 10) { root.import-document-clicked(); }
                                        else { root.import-file-clicked(); }
                                    }
                                }
                                if root.active-tab == 0 : IconButton {
                                    icon: @image-url("icons/plus.svg");
                                    clicked => { root.new-song-clicked(); }
                                }
                                Text {
                                    text: root.library-items.length;
                                    color: Theme.text-muted;
                                    font-size: 11.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Sub-tabs for Fondos vs Overlays
                        if root.active-tab == 3 : HorizontalLayout {
                            spacing: 6px;
                            GlassButton {
                                label: "Fondos";
                                icon: @image-url("icons/film.svg");
                                has-icon: true;
                                primary: root.bg-subtab == 0;
                                horizontal-stretch: 1;
                                clicked => { root.bg-subtab = 0; root.bg-subtab-changed(0); }
                            }
                            GlassButton {
                                label: "Overlays";
                                icon: @image-url("icons/layers.svg");
                                has-icon: true;
                                primary: root.bg-subtab == 1;
                                horizontal-stretch: 1;
                                clicked => { root.bg-subtab = 1; root.bg-subtab-changed(1); }
                            }
                        }

                        // Search box with icon
                        Rectangle {
                            height: 34px;
                            border-radius: Theme.radius-md;
                            background: Theme.bg-input;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 8px;
                                spacing: 6px;

                                Image {
                                    source: @image-url("icons/search.svg");
                                    width: 14px;
                                    height: 14px;
                                    y: (parent.height - self.height) / 2;
                                    colorize: Theme.text-muted;
                                }

                                LineEdit {
                                    placeholder-text: "Buscar...";
                                    text <=> root.search-query;
                                    edited(txt) => { root.search-changed(txt); }
                                }
                            }
                        }

                        // Song Playlists Strip (Canciones)
                        if root.active-tab == 0 : Rectangle {
                            border-radius: Theme.radius-md;
                            background: Theme.bg-surface-1;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 7px;
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 5px;
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        placeholder-text: "Nueva playlist...";
                                        text <=> root.new-playlist-name;
                                        accepted(txt) => {
                                            if (txt != "") {
                                                root.create-song-playlist(txt);
                                                root.new-playlist-name = "";
                                            }
                                        }
                                    }
                                    GlassButton {
                                        label: "Crear";
                                        compact: true;
                                        clicked => {
                                            if (root.new-playlist-name != "") {
                                                root.create-song-playlist(root.new-playlist-name);
                                                root.new-playlist-name = "";
                                            }
                                        }
                                    }
                                }

                                if root.song-playlist-names.length > 0 : ScrollView {
                                    height: 30px;
                                    HorizontalLayout {
                                        spacing: 4px;
                                        Rectangle {
                                            width: pl-all-lbl.preferred-width + 14px;
                                            height: 24px;
                                            border-radius: 5px;
                                            background: root.active-song-playlist-idx < 0 ? Theme.accent : (pl-all-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-2);
                                            border-width: 1px;
                                            border-color: root.active-song-playlist-idx < 0 ? Theme.accent-strong : Theme.border-subtle;
                                            pl-all-lbl := Text {
                                                text: "Todas";
                                                color: root.active-song-playlist-idx < 0 ? Theme.accent-fg : Theme.text-secondary;
                                                font-size: 10.5px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            pl-all-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.select-song-playlist(-1); }
                                            }
                                        }
                                        for plName[pidx] in root.song-playlist-names : Rectangle {
                                            width: pl-lbl.preferred-width + 16px;
                                            height: 24px;
                                            border-radius: 5px;
                                            background: pidx == root.active-song-playlist-idx ? Theme.accent : (pl-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-2);
                                            border-width: 1px;
                                            border-color: pidx == root.active-song-playlist-idx ? Theme.accent-strong : Theme.border-subtle;
                                            pl-lbl := Text {
                                                text: plName;
                                                color: pidx == root.active-song-playlist-idx ? Theme.accent-fg : Theme.text-primary;
                                                font-size: 10.5px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            pl-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.select-song-playlist(pidx); }
                                            }
                                        }
                                    }
                                }

                                if root.active-song-playlist-idx >= 0 : HorizontalLayout {
                                    spacing: 4px;
                                    GlassButton {
                                        label: root.playlist-filter-active ? "Ver Todas" : ("Ver (" + root.active-playlist-song-count + ")");
                                        horizontal-stretch: 1;
                                        primary: root.playlist-filter-active;
                                        clicked => { root.toggle-playlist-filter(); }
                                    }
                                    GlassButton {
                                        label: "→ Cola";
                                        primary: true;
                                        clicked => { root.send-playlist-to-queue(); }
                                    }
                                    IconButton {
                                        icon: @image-url("icons/trash.svg");
                                        danger: true;
                                        clicked => { root.delete-song-playlist(root.active-song-playlist-idx); }
                                    }
                                }
                            }
                        }

                        // Bible chapter quick selector
                        if root.active-tab == 1 && root.chapter-count > 1 : HorizontalLayout {
                            spacing: 6px;
                            IconButton {
                                icon: @image-url("icons/prev.svg");
                                clicked => {
                                    if (root.selected-chapter > 1) {
                                        root.selected-chapter -= 1;
                                        root.bible-chapter-changed(root.selected-chapter);
                                    }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 33px;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-surface-1;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                Text {
                                    text: "Cap. " + root.selected-chapter + " / " + root.chapter-count;
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            IconButton {
                                icon: @image-url("icons/next.svg");
                                clicked => {
                                    if (root.selected-chapter < root.chapter-count) {
                                        root.selected-chapter += 1;
                                        root.bible-chapter-changed(root.selected-chapter);
                                    }
                                }
                            }
                        }

                        // Scrollable Library List
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 3px;
                                padding-right: 4px;

                                for item[idx] in root.library-items : Rectangle {
                                    height: item.has-thumbnail ? 54px : (item.subtitle == "" ? 36px : 46px);
                                    border-radius: Theme.radius-sm;
                                    background: idx == root.selected-library-index
                                        ? Theme.bg-surface-hover
                                        : (item-ta.has-hover ? Theme.bg-surface-1 : transparent);
                                    border-width: 1px;
                                    border-color: idx == root.selected-library-index
                                        ? Theme.border-accent
                                        : (item-ta.has-hover ? Theme.border-subtle : transparent);
                                    animate background { duration: 110ms; }
                                    animate border-color { duration: 110ms; }

                                    item-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            main-keys.focus();
                                            root.selected-library-index = idx;
                                            root.library-item-selected(idx);
                                        }
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                root.open-item-modal(0, root.active-tab == 0 ? 0 : (root.active-tab == 2 ? 1 : 2), item.title, item.subtitle, item.path);
                                            }
                                        }
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                root.has-hover-video-frame = false;
                                                root.hovered-library-index = idx;
                                                root.library-item-hovered(idx);
                                            } else if (root.hovered-library-index == idx) {
                                                root.has-hover-video-frame = false;
                                                root.hovered-library-index = -1;
                                                root.library-item-hovered(-1);
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: item.has-thumbnail ? 6px : 10px;
                                        padding-right: 6px;
                                        spacing: 6px;

                                        if item.has-thumbnail : Rectangle {
                                            width: 68px;
                                            height: 40px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 6px;
                                            background: #050507;
                                            border-width: (idx == root.hovered-library-index && root.has-hover-video-frame) ? 1.5px : 1px;
                                            border-color: (idx == root.hovered-library-index && root.has-hover-video-frame) ? Theme.accent-strong : Theme.border-subtle;
                                            clip: true;

                                            Image {
                                                source: (idx == root.hovered-library-index && root.has-hover-video-frame)
                                                    ? root.hover-video-frame
                                                    : item.thumbnail;
                                                image-fit: cover;
                                            }

                                            if idx == root.hovered-library-index && root.has-hover-video-frame : Rectangle {
                                                x: 4px;
                                                y: 4px;
                                                width: 16px;
                                                height: 14px;
                                                border-radius: 3px;
                                                background: #08080ad8;
                                                Text {
                                                    text: "▶";
                                                    color: Theme.live-green;
                                                    font-size: 8px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 1px;

                                            Text {
                                                text: item.title;
                                                color: idx == root.selected-library-index ? Theme.text-primary : Theme.text-secondary;
                                                font-size: 12px;
                                                font-weight: idx == root.selected-library-index ? 600 : 400;
                                                overflow: elide;
                                            }
                                            if item.subtitle != "" : Text {
                                                text: item.subtitle;
                                                color: Theme.text-muted;
                                                font-size: 10px;
                                                overflow: elide;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 2px;
                                            ItemMoreBtn {
                                                y: (parent.height - self.height) / 2;
                                                clicked => {
                                                    root.open-item-modal(0, root.active-tab == 0 ? 0 : (root.active-tab == 2 ? 1 : 2), item.title, item.subtitle, item.path);
                                                }
                                            }
                                            ItemRowActionBtn {
                                                icon: @image-url("icons/trash.svg");
                                                danger: true;
                                                y: (parent.height - self.height) / 2;
                                                clicked => {
                                                    root.open-item-modal(2, root.active-tab == 0 ? 0 : (root.active-tab == 2 ? 1 : 2), item.title, item.subtitle, item.path);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Left Bottom Card: CONTENIDO (Fondos en Bucle | Overlays PNG | Estilos Rápidos) ──
                GlassCard {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 11px;
                        spacing: 8px;

                        // Contenido Header + Quick Import / Clear
                        HorizontalLayout {
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 6px;
                                Image {
                                    source: @image-url("icons/layers.svg");
                                    width: 15px;
                                    height: 15px;
                                    y: (parent.height - self.height) / 2;
                                    colorize: Theme.accent-strong;
                                }
                                Text {
                                    text: "Contenido";
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                if root.bg-dock-tab == 0 || root.bg-dock-tab == 1 : GlassButton {
                                    label: root.bg-dock-tab == 0 ? "Importar Fondo" : "Importar Overlay";
                                    icon: @image-url("icons/upload.svg");
                                    has-icon: true;
                                    compact: true;
                                    clicked => {
                                        if (root.bg-dock-tab == 0) { root.import-background-clicked(); }
                                        else { root.import-overlay-clicked(); }
                                    }
                                }
                                if root.bg-dock-tab == 0 || root.bg-dock-tab == 1 : IconButton {
                                    icon: @image-url("icons/trash.svg");
                                    danger: true;
                                    clicked => {
                                        if (root.bg-dock-tab == 1) { root.clear-overlay(); }
                                        else { root.clear-background(); }
                                    }
                                }
                            }
                        }

                        // 3 Contenido Category Tabs: Fondos | Overlays | Estilos
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 28px;
                                border-radius: 6px;
                                background: root.bg-dock-tab == 0 ? Theme.accent : (cp0-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-1);
                                border-width: 1px;
                                border-color: root.bg-dock-tab == 0 ? Theme.accent-strong : Theme.border-subtle;
                                animate background { duration: 120ms; }
                                Text {
                                    text: "Fondos (" + root.bg-dock-items.length + ")";
                                    color: root.bg-dock-tab == 0 ? Theme.accent-fg : Theme.text-secondary;
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                cp0-ta := TouchArea { mouse-cursor: pointer; clicked => { root.bg-dock-tab = 0; } }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 28px;
                                border-radius: 6px;
                                background: root.bg-dock-tab == 1 ? Theme.accent : (cp1-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-1);
                                border-width: 1px;
                                border-color: root.bg-dock-tab == 1 ? Theme.accent-strong : Theme.border-subtle;
                                animate background { duration: 120ms; }
                                Text {
                                    text: "Overlays (" + root.overlay-layer-items.length + ")";
                                    color: root.bg-dock-tab == 1 ? Theme.accent-fg : Theme.text-secondary;
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                cp1-ta := TouchArea { mouse-cursor: pointer; clicked => { root.bg-dock-tab = 1; } }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 28px;
                                border-radius: 6px;
                                background: root.bg-dock-tab == 2 ? Theme.accent : (cp2-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-1);
                                border-width: 1px;
                                border-color: root.bg-dock-tab == 2 ? Theme.accent-strong : Theme.border-subtle;
                                animate background { duration: 120ms; }
                                Text {
                                    text: "Estilos (" + root.saved-style-cards.length + ")";
                                    color: root.bg-dock-tab == 2 ? Theme.accent-fg : Theme.text-secondary;
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                cp2-ta := TouchArea { mouse-cursor: pointer; clicked => { root.bg-dock-tab = 2; } }
                            }
                        }

                        // Capas Tab 0: Fondos en Bucle con Árbol de Carpetas + Hover Preview
                        if root.bg-dock-tab == 0 : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 4px;
                                if root.bg-can-go-up : GlassButton {
                                    label: "⬆";
                                    compact: true;
                                    width: 28px;
                                    clicked => { root.bg-folder-up(); }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 26px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.bg-surface-0;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "📁 " + root.bg-current-folder-label;
                                            color: Theme.text-secondary;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                                GlassButton {
                                    label: "+ Carpeta";
                                    compact: true;
                                    clicked => { root.bg-new-folder-open = !root.bg-new-folder-open; }
                                }
                            }

                            if root.bg-new-folder-open : HorizontalLayout {
                                spacing: 4px;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    placeholder-text: "Nombre de subcarpeta...";
                                    text <=> root.bg-new-folder-name;
                                    accepted(n) => {
                                        if (n != "") {
                                            root.bg-folder-created(n);
                                            root.bg-new-folder-name = "";
                                            root.bg-new-folder-open = false;
                                        }
                                    }
                                }
                                GlassButton {
                                    label: "Crear";
                                    compact: true;
                                    primary: true;
                                    clicked => {
                                        if (root.bg-new-folder-name != "") {
                                            root.bg-folder-created(root.bg-new-folder-name);
                                            root.bg-new-folder-name = "";
                                            root.bg-new-folder-open = false;
                                        }
                                    }
                                }
                            }

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 5px;
                                    padding-right: 4px;

                                    for fld in root.bg-folders : Rectangle {
                                        height: 36px;
                                        border-radius: Theme.radius-sm;
                                        background: fld-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-1;
                                        border-width: 1px;
                                        border-color: fld-ta.has-hover ? Theme.border-accent : Theme.border-subtle;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            Text { text: "📁"; font-size: 13px; vertical-alignment: center; }
                                            Text {
                                                text: fld.name;
                                                color: Theme.text-primary;
                                                font-size: 12px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: fld.count + " ›";
                                                color: Theme.text-muted;
                                                font-size: 10.5px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }

                                        fld-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.bg-folder-entered(fld.rel-path); }
                                        }
                                    }

                                    if root.bg-dock-items.length == 0 && root.bg-folders.length == 0 : Text {
                                        text: "Carpeta vacía — pulsa 'Importar Fondo' o '+ Carpeta' para organizar tus fondos.";
                                        color: Theme.text-muted;
                                        font-size: 11.5px;
                                        wrap: word-wrap;
                                    }

                                    for bg[bidx] in root.bg-dock-items : Rectangle {
                                        height: 58px;
                                        border-radius: Theme.radius-sm;
                                        background: bg-ta.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-1;
                                        border-width: 1px;
                                        border-color: (bidx == root.hovered-dock-index && root.has-hover-video-frame)
                                            ? Theme.accent-strong
                                            : (bg-ta.has-hover ? Theme.border-medium : Theme.border-subtle);
                                        animate background { duration: 110ms; }
                                        animate border-color { duration: 110ms; }

                                        bg-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.dock-bg-selected(bidx); }
                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                    root.open-item-modal(0, 4, bg.title, bg.subtitle, bg.path);
                                                }
                                            }
                                            changed has-hover => {
                                                if (self.has-hover) {
                                                    root.has-hover-video-frame = false;
                                                    root.hovered-dock-index = bidx;
                                                    root.dock-bg-hovered(bidx);
                                                } else if (root.hovered-dock-index == bidx) {
                                                    root.has-hover-video-frame = false;
                                                    root.hovered-dock-index = -1;
                                                    root.dock-bg-hovered(-1);
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            padding: 4px;
                                            padding-right: 6px;
                                            spacing: 7px;

                                            Rectangle {
                                                width: 78px;
                                                height: 48px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 4px;
                                                background: #050507;
                                                clip: true;

                                                if bg.has-thumbnail || (bidx == root.hovered-dock-index && root.has-hover-video-frame) : Image {
                                                    x: 0px;
                                                    y: 0px;
                                                    width: 100%;
                                                    height: 100%;
                                                    source: (bidx == root.hovered-dock-index && root.has-hover-video-frame)
                                                        ? root.hover-video-frame
                                                        : bg.thumbnail;
                                                    image-fit: cover;
                                                }

                                                if bidx == root.hovered-dock-index && root.has-hover-video-frame : Rectangle {
                                                    x: 4px;
                                                    y: 4px;
                                                    width: 16px;
                                                    height: 14px;
                                                    border-radius: 2px;
                                                    background: #08080ad8;
                                                    Text { text: "▶"; color: Theme.live-green; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: bg.title;
                                                    color: Theme.text-primary;
                                                    font-size: 11.5px;
                                                    font-weight: 600;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: (bidx == root.hovered-dock-index && root.has-hover-video-frame) ? "▶ Vista previa" : bg.subtitle;
                                                    color: (bidx == root.hovered-dock-index && root.has-hover-video-frame) ? Theme.live-green : Theme.text-muted;
                                                    font-size: 9.5px;
                                                    font-weight: 600;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 2px;
                                                ItemMoreBtn {
                                                    y: (parent.height - self.height) / 2;
                                                    clicked => { root.open-item-modal(0, 4, bg.title, bg.subtitle, bg.path); }
                                                }
                                                ItemRowActionBtn {
                                                    icon: @image-url("icons/trash.svg");
                                                    danger: true;
                                                    y: (parent.height - self.height) / 2;
                                                    clicked => { root.open-item-modal(2, 4, bg.title, bg.subtitle, bg.path); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Capas Tab 1: Overlays PNG Transparentes
                        if root.bg-dock-tab == 1 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 6px;
                                padding-right: 4px;

                                if root.overlay-layer-items.length == 0 : Text {
                                    text: "Sin overlays PNG en assets/overlays — pulsa 'Importar Overlay' para agregar gráficos transparentes.";
                                    color: Theme.text-muted;
                                    font-size: 11.5px;
                                    wrap: word-wrap;
                                }

                                for ov[oidx] in root.overlay-layer-items : Rectangle {
                                    height: 54px;
                                    border-radius: Theme.radius-sm;
                                    background: ov.subtitle == "● ACTIVO"
                                        ? Theme.live-green.transparentize(0.84)
                                        : (ov-ta.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-1);
                                    border-width: 1px;
                                    border-color: ov.subtitle == "● ACTIVO" ? Theme.live-green : (ov-ta.has-hover ? Theme.border-medium : Theme.border-subtle);
                                    animate background { duration: 110ms; }

                                    ov-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.overlay-layer-selected(oidx); }
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                root.open-item-modal(0, 5, ov.title, ov.subtitle, ov.path);
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding: 5px;
                                        padding-right: 6px;
                                        spacing: 6px;

                                        Rectangle {
                                            width: 60px;
                                            height: 42px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 5px;
                                            background: #141418;
                                            border-width: 1px;
                                            border-color: Theme.border-subtle;
                                            clip: true;

                                            if ov.has-thumbnail : Image {
                                                source: ov.thumbnail;
                                                image-fit: contain;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: ov.title;
                                                color: Theme.text-primary;
                                                font-size: 11.5px;
                                                font-weight: 600;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: ov.subtitle;
                                                color: ov.subtitle == "● ACTIVO" ? Theme.live-green : Theme.text-muted;
                                                font-size: 9.5px;
                                                font-weight: 700;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 2px;
                                            ItemRowActionBtn {
                                                icon: @image-url("icons/plus.svg");
                                                accent: true;
                                                y: (parent.height - self.height) / 2;
                                                clicked => { root.overlay-layer-add-to-queue(oidx); }
                                            }
                                            ItemMoreBtn {
                                                y: (parent.height - self.height) / 2;
                                                clicked => { root.open-item-modal(0, 5, ov.title, ov.subtitle, ov.path); }
                                            }
                                            ItemRowActionBtn {
                                                icon: @image-url("icons/trash.svg");
                                                danger: true;
                                                y: (parent.height - self.height) / 2;
                                                clicked => { root.open-item-modal(2, 5, ov.title, ov.subtitle, ov.path); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Contenido Tab 2: Selector Rápido de Estilos Guardados (sin editor/creación)
                        if root.bg-dock-tab == 2 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: 7px;
                                padding-right: 4px;

                                // Selector rápido de pantalla destino
                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    VerticalLayout {
                                        padding: 7px;
                                        spacing: 5px;
                                        Text {
                                            text: "Enviar estilo a:";
                                            color: Theme.text-muted;
                                            font-size: 10px;
                                            font-weight: 700;
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            GlassButton {
                                                label: "Todas";
                                                compact: true;
                                                horizontal-stretch: 1;
                                                primary: root.style-target-mode == 0;
                                                clicked => { root.select-style-target(0); }
                                            }
                                            for scr in root.screen-matrix-items : GlassButton {
                                                label: scr.id == 0 ? "Público" : (scr.id == 1 ? "LAN" : (scr.id == 2 ? "Stage" : scr.name));
                                                compact: true;
                                                horizontal-stretch: 1;
                                                primary: root.style-target-mode == (scr.id + 1);
                                                clicked => { root.select-style-target(scr.id + 1); }
                                            }
                                        }
                                    }
                                }

                                if root.saved-style-cards.length == 0 : Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 4px;
                                        Text {
                                            text: "Sin estilos guardados todavía.";
                                            color: Theme.text-primary;
                                            font-size: 11.5px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: "Créalos desde el botón de Estilos (🎨) en la barra superior.";
                                            color: Theme.text-muted;
                                            font-size: 10.5px;
                                            horizontal-alignment: center;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                for sc[sidx] in root.saved-style-cards : Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: sc.active-on-target
                                        ? Theme.bg-surface-hover
                                        : (qs-ta.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-1);
                                    border-width: sc.active-on-target ? 1.5px : 1px;
                                    border-color: sc.active-on-target
                                        ? Theme.live-green
                                        : (qs-ta.has-hover ? Theme.border-accent : Theme.border-subtle);
                                    animate background   { duration: 140ms; easing: ease-out; }
                                    animate border-color { duration: 140ms; easing: ease-out; }

                                    qs-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.active-saved-style-idx = sidx;
                                            root.load-custom-style(sidx);
                                        }
                                    }

                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 6px;

                                        HorizontalLayout {
                                            spacing: 8px;

                                            // Mini preview negro del estilo
                                            Rectangle {
                                                width: 58px;
                                                height: 38px;
                                                border-radius: 5px;
                                                background: #050507;
                                                border-width: 1px;
                                                border-color: Theme.border-subtle;
                                                clip: true;

                                                Rectangle {
                                                    width: 86%;
                                                    height: 68%;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 3px;
                                                    background: sc.box-bg ? #00000099 : transparent;
                                                    Text {
                                                        text: "Aa Bb";
                                                        color: sc.text-color;
                                                        font-family: sc.font-family-name;
                                                        font-size: 11px;
                                                        font-weight: sc.font-weight-val;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;

                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    alignment: space-between;
                                                    Text {
                                                        text: sc.name;
                                                        color: Theme.text-primary;
                                                        font-size: 11.5px;
                                                        font-weight: 700;
                                                        overflow: elide;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    if sc.assigned-screens-label != "" : Rectangle {
                                                        height: 17px;
                                                        border-radius: 4px;
                                                        background: Theme.live-green-soft;
                                                        border-width: 1px;
                                                        border-color: Theme.live-green.transparentize(0.4);
                                                        HorizontalLayout {
                                                            padding-left: 5px;
                                                            padding-right: 5px;
                                                            Text {
                                                                text: "● " + sc.assigned-screens-label;
                                                                color: Theme.live-green;
                                                                font-size: 9px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }

                                                Text {
                                                    text: sc.summary;
                                                    color: Theme.text-secondary;
                                                    font-size: 10px;
                                                    overflow: elide;
                                                }
                                            }
                                        }

                                        // Botones rápidos por pantalla (Todas / Público / LAN / Stage...)
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Rectangle {
                                                height: 21px;
                                                border-radius: 4px;
                                                background: qall-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-0;
                                                border-width: 1px;
                                                border-color: qall-ta.has-hover ? Theme.border-accent : Theme.border-subtle;
                                                animate background   { duration: 120ms; }
                                                animate border-color { duration: 120ms; }
                                                HorizontalLayout {
                                                    padding-left: 6px; padding-right: 6px;
                                                    Text {
                                                        text: "Todas";
                                                        color: Theme.text-secondary;
                                                        font-size: 9.5px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                qall-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.active-saved-style-idx = sidx;
                                                        root.apply-style-to-screen(sidx, -1);
                                                    }
                                                }
                                            }
                                            for tgt in sc.screen-targets : Rectangle {
                                                height: 21px;
                                                border-radius: 4px;
                                                background: tgt.active
                                                    ? (tgt.screen-id == 1 ? #0284c7 : (tgt.screen-id == 2 ? #d97706 : Theme.accent))
                                                    : (qtgt-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-0);
                                                border-width: 1px;
                                                border-color: tgt.active
                                                    ? (tgt.screen-id == 1 ? #38bdf8 : (tgt.screen-id == 2 ? #fbbf24 : Theme.accent-strong))
                                                    : (qtgt-ta.has-hover ? Theme.border-accent : Theme.border-subtle);
                                                animate background   { duration: 130ms; }
                                                animate border-color { duration: 130ms; }
                                                HorizontalLayout {
                                                    padding-left: 6px; padding-right: 6px;
                                                    Text {
                                                        text: tgt.active ? ("✓ " + tgt.label) : tgt.label;
                                                        color: tgt.active
                                                            ? (tgt.screen-id == 0 ? Theme.accent-fg : #ffffff)
                                                            : Theme.text-secondary;
                                                        font-size: 9.5px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                qtgt-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.active-saved-style-idx = sidx;
                                                        root.apply-style-to-screen(sidx, tgt.screen-id);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ═════════════════════════════════════════════════════════════════
            //  COLUMN 2: CENTER WORKSPACE + BOTTOM BACKGROUNDS DOCK
            // ═════════════════════════════════════════════════════════════════
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 10px;

                GlassCard {
                    vertical-stretch: 1;

                    VerticalLayout {
                    padding: root.active-tab == 7 ? 0px : 15px;
                    spacing: root.active-tab == 7 ? 0px : 12px;

                    // ── Inline Song Editor (when active-tab == 0 && song-editor-open) ──
                    if root.active-tab == 0 && root.song-editor-open : VerticalLayout {
                        spacing: 10px;
                        vertical-stretch: 1;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Editor de Canciones";
                                color: Theme.text-primary;
                                font-size: 16px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                GlassButton {
                                    label: "Cancelar";
                                    clicked => { root.cancel-song-editor(); }
                                }
                                GlassButton {
                                    label: "Guardar (.txt)";
                                    icon: @image-url("icons/save.svg");
                                    has-icon: true;
                                    primary: true;
                                    clicked => { root.save-song-clicked(root.editor-song-title, root.editor-song-author, root.editor-song-body); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                horizontal-stretch: 2;
                                placeholder-text: "Título de la canción...";
                                text <=> root.editor-song-title;
                            }
                            LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: "Autor / Artista...";
                                text <=> root.editor-song-author;
                            }
                        }

                        Text {
                            text: "Separa cada estrofa con una línea en blanco:";
                            color: Theme.text-muted;
                            font-size: 11.5px;
                        }

                        TextEdit {
                            vertical-stretch: 1;
                            text <=> root.editor-song-body;
                        }
                    }

                    // ── Mode 1: BIBLIA PANTALLA COMPLETA (Libros + Capítulos + Versículos / Búsqueda / Historial / Favoritos) ──
                    if root.active-tab == 1 : VerticalLayout {
                        spacing: 10px;
                        vertical-stretch: 1;

                        // Bible Top Bar (Buscador rápido + Versión + Importar + Submodos + Prev/Next)
                        HorizontalLayout {
                            spacing: 8px;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-input;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    padding-left: 9px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    Image {
                                        source: @image-url("icons/search.svg");
                                        width: 14px;
                                        height: 14px;
                                        y: (parent.height - self.height) / 2;
                                        colorize: Theme.text-muted;
                                    }
                                    LineEdit {
                                        placeholder-text: "Ir a cita (ej. Ester 4:14, Juan 3:16) o buscar palabra...";
                                        text <=> root.bible-search-query;
                                        edited(txt) => { root.bible-search-edited(txt); }
                                        accepted(txt) => { root.bible-search-submitted(txt); }
                                    }
                                }
                            }

                            GlassButton {
                                label: "Buscar";
                                icon: @image-url("icons/search.svg");
                                has-icon: true;
                                primary: true;
                                clicked => { root.bible-search-submitted(root.bible-search-query); }
                            }
                            GlassButton {
                                label: root.current-bible-name + " ▾";
                                icon: @image-url("icons/book.svg");
                                has-icon: true;
                                primary: root.bible-version-menu-open;
                                clicked => { root.bible-version-menu-open = !root.bible-version-menu-open; }
                            }
                            IconButton {
                                icon: @image-url("icons/upload.svg");
                                clicked => { root.import-bible-clicked(); }
                            }
                        }

                        // Bible Submodes + Quick Verse Nav
                        HorizontalLayout {
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 6px;
                                GlassButton { label: "Libros y Capítulos"; primary: root.bible-submode == 0; clicked => { root.bible-submode = 0; } }
                                GlassButton { label: "Historial (" + root.bible-history.length + ")"; primary: root.bible-submode == 1; clicked => { root.bible-submode = 1; } }
                                GlassButton { label: "Favoritos (" + root.bible-favorites.length + ")"; primary: root.bible-submode == 2; clicked => { root.bible-submode = 2; } }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                if root.active-slide-index >= 0 : GlassButton {
                                    label: "★ Favorito";
                                    clicked => { root.bible-favorite-current(); }
                                }
                                GlassButton {
                                    label: "Anterior";
                                    icon: @image-url("icons/prev.svg");
                                    has-icon: true;
                                    clicked => { root.prev-slide(); }
                                }
                                GlassButton {
                                    label: "Siguiente";
                                    icon: @image-url("icons/next.svg");
                                    has-icon: true;
                                    primary: true;
                                    clicked => { root.next-slide(); }
                                }
                            }
                        }

                        // Submode 0: 3-Column Fullscreen Bible Browser (Libros | Capítulos | Versículos)
                        if root.bible-submode == 0 : HorizontalLayout {
                            spacing: 10px;
                            vertical-stretch: 1;

                            // Column A: Books (AT / NT filter)
                            Rectangle {
                                width: 204px;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-surface-1;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                clip: true;

                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 7px;

                                    HorizontalLayout {
                                        spacing: 4px;
                                        GlassButton { label: "Todos"; horizontal-stretch: 1; primary: root.bible-testament-filter == 0; clicked => { root.bible-testament-filter = 0; root.bible-filter-changed(0); } }
                                        GlassButton { label: "AT";    horizontal-stretch: 1; primary: root.bible-testament-filter == 1; clicked => { root.bible-testament-filter = 1; root.bible-filter-changed(1); } }
                                        GlassButton { label: "NT";    horizontal-stretch: 1; primary: root.bible-testament-filter == 2; clicked => { root.bible-testament-filter = 2; root.bible-filter-changed(2); } }
                                    }

                                    ScrollView {
                                        vertical-stretch: 1;
                                        VerticalLayout {
                                            spacing: 3px;
                                            for book[bidx] in root.bible-books : Rectangle {
                                                height: 34px;
                                                border-radius: 6px;
                                                background: bidx == root.selected-bible-book-idx
                                                    ? Theme.bg-surface-hover
                                                    : (bk-ta.has-hover ? Theme.bg-surface-2 : transparent);
                                                border-width: 1px;
                                                border-color: bidx == root.selected-bible-book-idx ? Theme.border-accent : transparent;

                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 8px;
                                                    spacing: 7px;
                                                    Rectangle {
                                                        width: 3px;
                                                        height: 18px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 2px;
                                                        background: book.is-nt ? #38bdf8 : #f59e0b;
                                                    }
                                                    Text {
                                                        text: book.name;
                                                        color: bidx == root.selected-bible-book-idx ? Theme.text-primary : Theme.text-secondary;
                                                        font-size: 12px;
                                                        font-weight: bidx == root.selected-bible-book-idx ? 700 : 500;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                        horizontal-stretch: 1;
                                                    }
                                                    Text {
                                                        text: book.chapters;
                                                        color: Theme.text-muted;
                                                        font-size: 10px;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                bk-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.selected-bible-book-idx = bidx;
                                                        root.bible-book-selected(bidx);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Column B: Chapters List (quick click jump)
                            Rectangle {
                                width: 108px;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-surface-1;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                clip: true;

                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 6px;
                                    Text { text: "Capítulos"; color: Theme.text-secondary; font-size: 11.5px; font-weight: 700; horizontal-alignment: center; }

                                    ScrollView {
                                        vertical-stretch: 1;
                                        VerticalLayout {
                                            spacing: 4px;
                                            for chNum in root.bible-chapter-numbers : Rectangle {
                                                height: 32px;
                                                border-radius: 6px;
                                                background: chNum == root.selected-chapter
                                                    ? Theme.accent
                                                    : (ch-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-2);
                                                border-width: 1px;
                                                border-color: chNum == root.selected-chapter ? Theme.accent-strong : Theme.border-subtle;

                                                Text {
                                                    text: "Cap. " + chNum;
                                                    color: chNum == root.selected-chapter ? Theme.accent-fg : Theme.text-primary;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }

                                                ch-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.selected-chapter = chNum;
                                                        root.bible-chapter-changed(chNum);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Column C: Verses Cards (Click to Project Live)
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-surface-1;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                clip: true;

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 8px;

                                    Text {
                                        text: root.selected-item-title;
                                        color: Theme.text-primary;
                                        font-size: 14.5px;
                                        font-weight: 700;
                                    }

                                    ScrollView {
                                        vertical-stretch: 1;
                                        VerticalLayout {
                                            alignment: start;
                                            spacing: 6px;
                                            padding-right: 4px;

                                            if root.slides.length == 0 : Text {
                                                text: "Selecciona un libro y capítulo para proyectar versículos, o escribe una cita arriba (ej. Juan 3:16).";
                                                color: Theme.text-muted;
                                                font-size: 13px;
                                                wrap: word-wrap;
                                            }

                                            for slide[sidx] in root.slides : SlideTile {
                                                badge: slide.badge;
                                                body: slide.body;
                                                card-height: 84px;
                                                active: sidx == root.active-slide-index;
                                                clicked => {
                                                    main-keys.focus();
                                                    root.active-slide-index = sidx;
                                                    root.slide-clicked(sidx);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Submode 1: Bible History
                        if root.bible-submode == 1 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: 6px;
                                if root.bible-history.length == 0 : Text { text: "Aún no has proyectado versículos en esta sesión."; color: Theme.text-muted; font-size: 13px; }
                                for h[hidx] in root.bible-history : SlideTile {
                                    badge: h.badge;
                                    body: h.body;
                                    card-height: 82px;
                                    clicked => { main-keys.focus(); root.bible-history-clicked(hidx); }
                                }
                            }
                        }

                        // Submode 2: Bible Favorites
                        if root.bible-submode == 2 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: 6px;
                                if root.bible-favorites.length == 0 : Text { text: "Sin versículos favoritos aún. Proyecta un versículo y pulsa '★ Favorito'."; color: Theme.text-muted; font-size: 13px; }
                                for fav[fidx] in root.bible-favorites : SlideTile {
                                    badge: fav.badge;
                                    body: fav.body;
                                    card-height: 82px;
                                    clicked => { main-keys.focus(); root.bible-favorite-clicked(fidx); }
                                }
                            }
                        }
                    }

                    // ── Modes 0, 2: Canciones (Autor/Título + Columnas/Tamaño) & Multimedia (Preview + Cola) ──
                    if (root.active-tab == 0 || root.active-tab == 2) && !(root.active-tab == 0 && root.song-editor-open) : VerticalLayout {
                        spacing: 10px;
                        vertical-stretch: 1;

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: root.selected-item-title;
                                    color: Theme.text-primary;
                                    font-size: 15px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                if root.active-tab == 0 && root.selected-song-author != "" : Text {
                                    text: "Autor: " + root.selected-song-author;
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                if root.active-tab == 0 && root.selected-library-index >= 0 : GlassButton {
                                    label: "Editar";
                                    icon: @image-url("icons/edit.svg");
                                    has-icon: true;
                                    compact: true;
                                    clicked => { root.edit-song-clicked(); }
                                }
                                if root.active-tab == 0 && root.selected-library-index >= 0 && root.selected-library-path != "" : GlassButton {
                                    label: "Renombrar";
                                    compact: true;
                                    clicked => { root.open-item-modal(1, 0, root.selected-item-title, root.selected-song-author, root.selected-library-path); }
                                }
                                if root.active-tab == 2 && root.selected-library-index >= 0 : GlassButton {
                                    label: "Enviar a Pantalla";
                                    icon: @image-url("icons/tv.svg");
                                    has-icon: true;
                                    primary: true;
                                    clicked => { root.project-selected-media(); }
                                }
                                if root.active-tab == 2 && root.selected-library-index >= 0 : GlassButton {
                                    label: "A Cola";
                                    icon: @image-url("icons/list.svg");
                                    has-icon: true;
                                    compact: true;
                                    clicked => { root.add-selected-to-video-queue(); }
                                }
                                if root.active-tab == 2 && root.selected-library-index >= 0 && root.selected-library-path != "" : GlassButton {
                                    label: "Renombrar";
                                    icon: @image-url("icons/edit.svg");
                                    has-icon: true;
                                    compact: true;
                                    clicked => { root.open-item-modal(1, 1, root.selected-item-title, root.selected-media-info, root.selected-library-path); }
                                }
                                if root.active-tab == 2 && root.selected-library-index >= 0 && root.selected-library-path != "" : IconButton {
                                    icon: @image-url("icons/trash.svg");
                                    danger: true;
                                    clicked => { root.open-item-modal(2, 1, root.selected-item-title, root.selected-media-info, root.selected-library-path); }
                                }
                                if root.active-tab == 0 && root.active-song-playlist-idx >= 0 && root.selected-library-index >= 0 : GlassButton {
                                    label: "A Playlist";
                                    compact: true;
                                    clicked => { root.add-song-to-playlist(); }
                                }
                                if root.active-tab == 0 && root.selected-library-index >= 0 : GlassButton {
                                    label: "A Cola";
                                    icon: @image-url("icons/list.svg");
                                    has-icon: true;
                                    compact: true;
                                    clicked => { root.add-current-to-queue(); }
                                }
                                if root.active-tab == 0 && root.selected-library-index >= 0 && root.selected-library-path != "" : IconButton {
                                    icon: @image-url("icons/trash.svg");
                                    danger: true;
                                    clicked => { root.open-item-modal(2, 0, root.selected-item-title, root.selected-song-author, root.selected-library-path); }
                                }
                                if root.active-tab == 0 : IconButton {
                                    icon: @image-url("icons/prev.svg");
                                    clicked => { root.prev-slide(); }
                                }
                                if root.active-tab == 0 : IconButton {
                                    icon: @image-url("icons/next.svg");
                                    clicked => { root.next-slide(); }
                                }
                            }
                        }

                        // Song Stanza Grid Controls (Columnas 1..4 + Tamaño P/M/G)
                        if root.active-tab == 0 && root.slides.length > 0 : HorizontalLayout {
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 4px;
                                Text { text: "Columnas:"; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
                                GlassButton { label: "1"; compact: true; width: 28px; primary: root.slide-columns == 1; clicked => { root.slide-columns = 1; root.slide-columns-changed(1); } }
                                GlassButton { label: "2"; compact: true; width: 28px; primary: root.slide-columns == 2; clicked => { root.slide-columns = 2; root.slide-columns-changed(2); } }
                                GlassButton { label: "3"; compact: true; width: 28px; primary: root.slide-columns == 3; clicked => { root.slide-columns = 3; root.slide-columns-changed(3); } }
                                GlassButton { label: "4"; compact: true; width: 28px; primary: root.slide-columns == 4; clicked => { root.slide-columns = 4; root.slide-columns-changed(4); } }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                Text { text: "Tamaño:"; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
                                GlassButton { label: "Pequeño"; compact: true; primary: root.slide-card-size == 0; clicked => { root.slide-card-size = 0; } }
                                GlassButton { label: "Medio";   compact: true; primary: root.slide-card-size == 1; clicked => { root.slide-card-size = 1; } }
                                GlassButton { label: "Grande";  compact: true; primary: root.slide-card-size == 2; clicked => { root.slide-card-size = 2; } }
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: 7px;
                                padding-right: 6px;

                                // Media / Background Large 16:9 Preview Card (also shows live hover preview!)
                                if (root.active-tab == 2 || root.active-tab == 3) && (root.selected-library-index >= 0 || root.has-hover-video-frame) : Rectangle {
                                    height: 248px;
                                    border-radius: 3px;
                                    background: #050507;
                                    border-width: 1px;
                                    border-color: root.has-hover-video-frame ? Theme.accent-strong : Theme.border-medium;
                                    clip: true;

                                    if root.has-hover-video-frame : Image {
                                        x: 0px;
                                        y: 0px;
                                        width: 100%;
                                        height: 100%;
                                        source: root.hover-video-frame;
                                        image-fit: contain;
                                    }

                                    if !root.has-hover-video-frame && root.has-selected-media-preview : Image {
                                        x: 0px;
                                        y: 0px;
                                        width: 100%;
                                        height: 100%;
                                        source: root.selected-media-preview;
                                        image-fit: contain;
                                    }

                                    if !root.has-hover-video-frame && !root.has-selected-media-preview : Text {
                                        text: root.selected-media-info;
                                        color: Theme.text-secondary;
                                        font-size: 13px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    Rectangle {
                                        y: parent.height - 34px;
                                        width: 100%;
                                        height: 34px;
                                        background: #09090bd8;
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            alignment: space-between;
                                            Text {
                                                text: root.has-hover-video-frame ? "▶ VISTA PREVIA EN VIVO (HOVER)" : ("PREVIEW: " + root.selected-item-title);
                                                color: root.has-hover-video-frame ? Theme.live-green : #ffffff;
                                                font-size: 11.5px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            Text { text: root.selected-media-info; color: Theme.text-secondary; font-size: 11px; vertical-alignment: center; }
                                        }
                                    }
                                }

                                // Video Queue Panel (MonitorQueueEngine parity in Multimedia Tab!)
                                if root.active-tab == 2 : Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: root.video-queue-playing ? Theme.live-green.transparentize(0.45) : Theme.border-subtle;
                                    animate border-color { duration: 180ms; easing: ease-out; }

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 10px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            spacing: 8px;
                                            HorizontalLayout {
                                                spacing: 7px;
                                                Image {
                                                    source: @image-url("icons/list.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    y: (parent.height - self.height) / 2;
                                                    colorize: Theme.accent-strong;
                                                }
                                                Text {
                                                    text: "Cola de Reproducción (" + root.video-queue-items.length + ")";
                                                    color: Theme.text-primary;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: 5px;
                                                IslandIconButton {
                                                    y: (parent.height - self.height) / 2;
                                                    icon: @image-url("icons/prev.svg");
                                                    clicked => { root.prev-video-queue(); }
                                                }
                                                GlassButton {
                                                    height: 30px;
                                                    y: (parent.height - self.height) / 2;
                                                    label: root.video-queue-playing ? "Detener" : "Reproducir";
                                                    icon: root.video-queue-playing ? @image-url("icons/stop.svg") : @image-url("icons/play.svg");
                                                    has-icon: true;
                                                    compact: true;
                                                    primary: !root.video-queue-playing;
                                                    danger: root.video-queue-playing;
                                                    clicked => { root.toggle-video-queue-play(); }
                                                }
                                                IslandIconButton {
                                                    y: (parent.height - self.height) / 2;
                                                    icon: @image-url("icons/next.svg");
                                                    clicked => { root.next-video-queue(); }
                                                }
                                                IslandIconButton {
                                                    y: (parent.height - self.height) / 2;
                                                    icon: @image-url("icons/repeat.svg");
                                                    active: root.video-queue-loop;
                                                    clicked => { root.video-queue-loop = !root.video-queue-loop; }
                                                }
                                                IslandIconButton {
                                                    y: (parent.height - self.height) / 2;
                                                    icon: @image-url("icons/trash.svg");
                                                    danger: true;
                                                    clicked => { root.clear-video-queue(); }
                                                }
                                            }
                                        }

                                        if root.video-queue-items.length == 0 : Text {
                                            text: "Selecciona videos a la izquierda y pulsa '+ Cola Videos' para reproducirlos uno tras otro automáticamente.";
                                            color: Theme.text-muted;
                                            font-size: 11.5px;
                                            wrap: word-wrap;
                                        }

                                        for vq[vidx] in root.video-queue-items : Rectangle {
                                            height: 44px;
                                            border-radius: 7px;
                                            background: vq.playing ? Theme.live-green-soft : (vq-row-ta.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-0);
                                            border-width: 1px;
                                            border-color: vq.playing ? Theme.live-green.transparentize(0.2) : (vq-row-ta.has-hover ? Theme.border-medium : Theme.border-subtle);
                                            animate background   { duration: 140ms; easing: ease-out; }
                                            animate border-color { duration: 140ms; easing: ease-out; }

                                            vq-row-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.play-video-queue-item(vidx); }
                                            }

                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 8px;
                                                spacing: 6px;

                                                Text {
                                                    width: 18px;
                                                    text: (vidx + 1) + ".";
                                                    color: vq.playing ? Theme.live-green : Theme.text-muted;
                                                    font-size: 11.5px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: vq.title;
                                                    color: vq.playing ? Theme.live-green : Theme.text-primary;
                                                    font-size: 12px;
                                                    font-weight: vq.playing ? 700 : 500;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                                Rectangle {
                                                    height: 20px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 4px;
                                                    background: Theme.bg-surface-2;
                                                    HorizontalLayout {
                                                        padding-left: 6px;
                                                        padding-right: 6px;
                                                        Text {
                                                            text: vq.kind;
                                                            color: Theme.text-muted;
                                                            font-size: 9.5px;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                IslandIconButton {
                                                    y: (parent.height - self.height) / 2;
                                                    icon: @image-url("icons/play.svg");
                                                    active: vq.playing;
                                                    clicked => { root.play-video-queue-item(vidx); }
                                                }
                                                IslandIconButton {
                                                    y: (parent.height - self.height) / 2;
                                                    label: "▲";
                                                    clicked => { root.move-video-queue-item(vidx, vidx - 1); }
                                                }
                                                IslandIconButton {
                                                    y: (parent.height - self.height) / 2;
                                                    label: "▼";
                                                    clicked => { root.move-video-queue-item(vidx, vidx + 1); }
                                                }
                                                IslandIconButton {
                                                    y: (parent.height - self.height) / 2;
                                                    icon: @image-url("icons/trash.svg");
                                                    danger: true;
                                                    clicked => { root.remove-video-queue-item(vidx); }
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.slides.length == 0 && root.active-tab == 0 : Rectangle {
                                    height: 220px;
                                    Text {
                                        text: "Selecciona una canción a la izquierda o pulsa '+' para crear una nueva.";
                                        color: Theme.text-muted;
                                        font-size: 13px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.active-tab >= 2 && root.selected-library-index < 0 : Rectangle {
                                    height: 120px;
                                    Text {
                                        text: root.active-tab == 2
                                            ? "Selecciona un video, imagen o audio de tu biblioteca para previsualizarlo antes de enviarlo a pantalla."
                                            : "Selecciona un fondo de tu carpeta Fondos (backgrounds/) o un Overlay PNG.";
                                        color: Theme.text-muted;
                                        font-size: 12.5px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                for row in root.slide-rows : HorizontalLayout {
                                    spacing: 7px;
                                    height: root.slide-card-size == 0 ? 78px : (root.slide-card-size == 2 ? 128px : 98px);
                                    for cell in row.cells : Rectangle {
                                        horizontal-stretch: 1;
                                        height: 100%;
                                        if cell.valid : SlideTile {
                                            width: 100%;
                                            height: 100%;
                                            badge: cell.badge;
                                            body: cell.body;
                                            active: cell.index == root.active-slide-index;
                                            card-height: root.slide-card-size == 0 ? 78px : (root.slide-card-size == 2 ? 128px : 98px);
                                            body-font-size: root.slide-card-size == 0 ? 11px : (root.slide-card-size == 2 ? 13.5px : 12px);
                                            clicked => {
                                                main-keys.focus();
                                                root.active-slide-index = cell.index;
                                                root.slide-clicked(cell.index);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── Mode 4: Diseño (Estilos de Letras, Shaders/EQ, Transiciones, Tiles) ──
                    if root.active-tab == 4 : VerticalLayout {
                        spacing: 10px;
                        vertical-stretch: 1;

                        HorizontalLayout {
                            spacing: 6px;
                            GlassButton { label: "Estilos";      icon: @image-url("icons/palette.svg"); has-icon: true; primary: root.design-subtab == 0; clicked => { root.design-subtab = 0; } }
                            GlassButton { label: "Shaders / EQ"; icon: @image-url("icons/sliders.svg"); has-icon: true; primary: root.design-subtab == 1; clicked => { root.design-subtab = 1; } }
                            GlassButton { label: "Transiciones"; icon: @image-url("icons/shuffle.svg"); has-icon: true; primary: root.design-subtab == 2; clicked => { root.design-subtab = 2; } }
                            GlassButton { label: "Tiles";        icon: @image-url("icons/columns.svg"); has-icon: true; primary: root.design-subtab == 3; clicked => { root.design-subtab = 3; } }
                        }

                        // Subtab 0A: SELECTOR / GALERÍA DE ESTILOS DEL USUARIO (sin presets hardcodeados — FULL como ImGui)
                        if root.design-subtab == 0 && !root.style-editor-open : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 11px;
                                padding-right: 8px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Mis Estilos de Letras (" + root.saved-style-cards.length + ")"; color: Theme.text-primary; font-size: 15px; font-weight: 700; }
                                        Text { text: "Define estilos propios (.theme) y elige a qué pantalla enviar cada estilo de letra (ej. letras gigantes solo para LAN)."; color: Theme.text-muted; font-size: 11.5px; }
                                    }
                                    GlassButton {
                                        label: "Crear Nuevo Estilo";
                                        icon: @image-url("icons/plus.svg");
                                        has-icon: true;
                                        primary: true;
                                        clicked => { root.open-new-style-editor(); }
                                    }
                                }

                                // Selector de Pantalla Destino para Estilos de Letra + Estado actual por pantalla
                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: "Enviar estilo a:";
                                                color: Theme.text-secondary;
                                                font-size: 11px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                            GlassButton {
                                                label: "Todas";
                                                compact: true;
                                                primary: root.style-target-mode == 0;
                                                clicked => { root.select-style-target(0); }
                                            }
                                            for scr in root.screen-matrix-items : GlassButton {
                                                label: scr.id == 0 ? "Público" : (scr.id == 1 ? "LAN" : (scr.id == 2 ? "Stage" : scr.name));
                                                compact: true;
                                                primary: root.style-target-mode == (scr.id + 1);
                                                clicked => { root.select-style-target(scr.id + 1); }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: "Activo:";
                                                color: Theme.text-muted;
                                                font-size: 10px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                            for scr in root.screen-matrix-items : Rectangle {
                                                height: 22px;
                                                border-radius: 4px;
                                                background: root.style-target-mode == (scr.id + 1) ? Theme.accent-soft : Theme.bg-surface-0;
                                                border-width: 1px;
                                                border-color: root.style-target-mode == (scr.id + 1) ? Theme.border-accent : Theme.border-subtle;
                                                animate background   { duration: 130ms; easing: ease-out; }
                                                animate border-color { duration: 130ms; easing: ease-out; }
                                                HorizontalLayout {
                                                    padding-left: 7px;
                                                    padding-right: 7px;
                                                    Text {
                                                        text: (scr.id == 0 ? "Público" : (scr.id == 1 ? "LAN" : (scr.id == 2 ? "Stage" : scr.name)))
                                                            + ": " + scr.style-name + " (" + Math.round(scr.text-size) + "px)"
                                                            + (scr.use-own-style ? " · Propio" : "");
                                                        color: scr.use-own-style ? #38bdf8 : Theme.text-secondary;
                                                        font-size: 10px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.select-style-target(scr.id + 1); }
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.saved-style-cards.length == 0 : Rectangle {
                                    height: 180px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    VerticalLayout {
                                        padding: 24px;
                                        alignment: center;
                                        spacing: 12px;
                                        Text {
                                            text: "No tienes estilos guardados todavía.\nPulsa '+ Crear Nuevo Estilo' para abrir el editor completo y diseñar tu primer estilo.";
                                            color: Theme.text-secondary;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            alignment: center;
                                            GlassButton {
                                                label: "Abrir Editor de Estilos";
                                                icon: @image-url("icons/palette.svg");
                                                has-icon: true;
                                                primary: true;
                                                clicked => { root.open-new-style-editor(); }
                                            }
                                        }
                                    }
                                }

                                for sc[sidx] in root.saved-style-cards : StyleGalleryCard {
                                    style-name: sc.name;
                                    style-summary: sc.summary;
                                    preview-text-color: sc.text-color;
                                    preview-box-bg: sc.box-bg;
                                    preview-font-family: sc.font-family-name;
                                    preview-font-weight: sc.font-weight-val;
                                    active: sc.active-on-target;
                                    apply-label: root.style-target-mode == 0 ? "Aplicar a Todas" : ("Aplicar a " + root.style-target-label);
                                    assigned-screens-label: sc.assigned-screens-label;
                                    screen-targets: sc.screen-targets;
                                    apply-style => {
                                        root.active-saved-style-idx = sidx;
                                        root.load-custom-style(sidx);
                                    }
                                    apply-to-screen(scrId) => {
                                        root.active-saved-style-idx = sidx;
                                        root.apply-style-to-screen(sidx, scrId);
                                    }
                                    edit-style => { root.open-edit-style-editor(sidx); }
                                    duplicate-style => { root.duplicate-custom-style(sidx); }
                                    delete-style => { root.delete-custom-style(sidx); }
                                }
                            }
                        }

                        // Subtab 0B: EDITOR COMPLETO DE ESTILOS A PANTALLA COMPLETA (Letras + Índice Biblia 100% independientes)
                        if root.design-subtab == 0 && root.style-editor-open : VerticalLayout {
                            spacing: 10px;
                            vertical-stretch: 1;

                            // Editor Header Bar
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Editor de Estilo:"; color: Theme.text-secondary; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                LineEdit {
                                    horizontal-stretch: 1;
                                    placeholder-text: "Nombre del estilo (ej. Alabanza Principal, LAN Gigante, Biblia)...";
                                    text <=> root.editing-style-name;
                                }
                                Rectangle {
                                    height: 30px;
                                    border-radius: 6px;
                                    background: Theme.accent-soft;
                                    border-width: 1px;
                                    border-color: Theme.border-accent;
                                    HorizontalLayout {
                                        padding-left: 9px;
                                        padding-right: 9px;
                                        Text {
                                            text: "Destino: " + root.style-target-label;
                                            color: Theme.accent-strong;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                GlassButton {
                                    label: "Cancelar";
                                    clicked => { root.cancel-style-editor(); }
                                }
                                GlassButton {
                                    label: "Guardar y Aplicar";
                                    icon: @image-url("icons/save.svg");
                                    has-icon: true;
                                    primary: true;
                                    clicked => { root.save-style-editor(root.editing-style-name); }
                                }
                            }

                            // Split Editor Body: Left Live 16:9 WYSIWYG Canvas + Box Position | Right Independent Inspector
                            HorizontalLayout {
                                spacing: 12px;
                                vertical-stretch: 1;

                                // Left: Live 16:9 WYSIWYG Canvas + Box Selector & Position
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 10px;

                                    style-canvas := Rectangle {
                                        height: 306px;
                                        border-radius: 3px;
                                        background: root.live-bg-solid-color;
                                        border-width: 1px;
                                        border-color: Theme.border-medium;
                                        clip: true;

                                        if root.has-live-preview-image : Image {
                                            x: 0px;
                                            y: 0px;
                                            width: 100%;
                                            height: 100%;
                                            source: root.live-preview-image;
                                            image-fit: root.bg-scale-mode == 1 ? fill : (root.bg-scale-mode == 2 ? contain : cover);
                                        }

                                        // Lyrics Bounded Box on Canvas — resizing space wraps/clips text WITHOUT changing font size!
                                        lyr-box := Rectangle {
                                            width: Math.clamp(root.lyrics-width, 0.15, 1.0) * style-canvas.width;
                                            height: Math.clamp(root.lyrics-height, 0.08, 1.0) * style-canvas.height;
                                            x: Math.clamp(root.lyrics-pos-x * style-canvas.width - self.width / 2, 0px, Math.max(0px, style-canvas.width - self.width));
                                            y: Math.clamp(root.lyrics-pos-y * style-canvas.height - self.height / 2, 0px, Math.max(0px, style-canvas.height - self.height));
                                            border-radius: 4px;
                                            border-width: root.style-editor-box == 0 ? 2px : 1px;
                                            border-color: root.style-editor-box == 0 ? Theme.accent-strong : #ffffff40;
                                            clip: true;

                                            lyrics-preview := StyledTextBlock {
                                                width: 100%;
                                                height: 100%;
                                                text-body: root.live-text == "" ? "Porque de tal manera amó Dios al mundo que ha dado a su Hijo unigénito, para que todo aquel que en él cree no se pierda" : root.live-text;
                                                text-size: Math.max(8.0, root.text-size * (style-canvas.width / 1280px));
                                                text-fit-mode: root.text-fit-mode;
                                                fit-box-height: Math.clamp(root.lyrics-height, 0.08, 1.0) * style-canvas.height;
                                                text-align: root.text-align;
                                                text-valign: root.text-valign;
                                                text-color: root.text-color;
                                                font-family-name: root.font-family-name;
                                                font-weight-val: root.font-weight-idx == 0 ? 400 : (root.font-weight-idx == 2 ? 900 : 700);
                                                text-shadow: root.text-shadow;
                                                text-outline: root.text-outline;
                                                text-glow: root.text-glow;
                                                text-neon: root.text-neon;
                                                text-3d: root.text-3d;
                                                text-underline: root.text-underline;
                                                text-box-bg: root.text-box-bg;
                                                box-padding: 8px;
                                            }

                                            // Bottom-right corner resize handle (visual indicator, handled by stationary canvas-ta!)
                                            if root.style-editor-box == 0 : Rectangle {
                                                x: parent.width - 14px;
                                                y: parent.height - 14px;
                                                width: 14px;
                                                height: 14px;
                                                border-radius: 3px;
                                                background: Theme.accent-strong;
                                                border-width: 1px;
                                                border-color: #09090b;
                                            }
                                        }

                                        // Independent Bible Index Bounded Box on Canvas (100% own style & bounds!)
                                        idx-box := Rectangle {
                                            visible: root.index-box-enabled;
                                            width: Math.clamp(root.index-width, 0.12, 1.0) * style-canvas.width;
                                            height: Math.clamp(root.index-height, 0.06, 0.60) * style-canvas.height;
                                            x: Math.clamp(root.index-pos-x * style-canvas.width - self.width / 2, 0px, Math.max(0px, style-canvas.width - self.width));
                                            y: Math.clamp(root.index-pos-y * style-canvas.height - self.height / 2, 0px, Math.max(0px, style-canvas.height - self.height));
                                            border-radius: 4px;
                                            border-width: root.style-editor-box == 1 ? 2px : 1px;
                                            border-color: root.style-editor-box == 1 ? Theme.stage-amber : #ffffff40;
                                            clip: true;

                                            idx-preview := StyledTextBlock {
                                                width: 100%;
                                                height: 100%;
                                                text-body: root.index-uppercase ? "JUAN 3:16" : "Juan 3:16";
                                                text-size: Math.max(7.0, root.index-size * (style-canvas.width / 1280px));
                                                text-align: root.index-align;
                                                text-valign: 1;
                                                text-color: root.index-color;
                                                font-family-name: root.index-font-family-name;
                                                font-weight-val: root.index-font-weight-idx == 0 ? 400 : (root.index-font-weight-idx == 2 ? 900 : 700);
                                                text-shadow: root.index-shadow;
                                                text-outline: root.index-outline;
                                                text-glow: root.index-glow;
                                                glow-color: root.index-color;
                                                text-box-bg: root.index-box-bg;
                                                box-padding: 5px;
                                            }

                                            if root.style-editor-box == 1 : Rectangle {
                                                x: parent.width - 14px;
                                                y: parent.height - 14px;
                                                width: 14px;
                                                height: 14px;
                                                border-radius: 3px;
                                                background: Theme.stage-amber;
                                                border-width: 1px;
                                                border-color: #09090b;
                                            }
                                        }

                                        // Stationary Canvas TouchArea (fixes coordinate feedback loop / flicker when dragging or resizing!)
                                        canvas-ta := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            property <int> drag-mode: 0; // 0=none, 1=move lyr, 2=resize lyr, 3=move idx, 4=resize idx
                                            property <float> start-px;
                                            property <float> start-py;
                                            property <float> start-w;
                                            property <float> start-h;

                                            property <bool> hover-lyr-res: root.style-editor-box == 0
                                                && self.mouse-x >= lyr-box.x + lyr-box.width - 20px && self.mouse-x <= lyr-box.x + lyr-box.width + 6px
                                                && self.mouse-y >= lyr-box.y + lyr-box.height - 20px && self.mouse-y <= lyr-box.y + lyr-box.height + 6px;
                                            property <bool> hover-idx-res: root.index-box-enabled && root.style-editor-box == 1
                                                && self.mouse-x >= idx-box.x + idx-box.width - 20px && self.mouse-x <= idx-box.x + idx-box.width + 6px
                                                && self.mouse-y >= idx-box.y + idx-box.height - 20px && self.mouse-y <= idx-box.y + idx-box.height + 6px;

                                            mouse-cursor: (self.drag-mode == 2 || self.drag-mode == 4 || self.hover-lyr-res || self.hover-idx-res)
                                                ? nwse-resize
                                                : (self.drag-mode == 1 || self.drag-mode == 3 ? move : pointer);

                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                                    if (self.hover-lyr-res) {
                                                        self.drag-mode = 2;
                                                        self.start-w = root.lyrics-width;
                                                        self.start-h = root.lyrics-height;
                                                    } else if (self.hover-idx-res) {
                                                        self.drag-mode = 4;
                                                        self.start-w = root.index-width;
                                                        self.start-h = root.index-height;
                                                    } else if (root.index-box-enabled
                                                        && self.mouse-x >= idx-box.x && self.mouse-x <= idx-box.x + idx-box.width
                                                        && self.mouse-y >= idx-box.y && self.mouse-y <= idx-box.y + idx-box.height) {
                                                        root.style-editor-box = 1;
                                                        self.drag-mode = 3;
                                                        self.start-px = root.index-pos-x;
                                                        self.start-py = root.index-pos-y;
                                                    } else if (self.mouse-x >= lyr-box.x && self.mouse-x <= lyr-box.x + lyr-box.width
                                                        && self.mouse-y >= lyr-box.y && self.mouse-y <= lyr-box.y + lyr-box.height) {
                                                        root.style-editor-box = 0;
                                                        self.drag-mode = 1;
                                                        self.start-px = root.lyrics-pos-x;
                                                        self.start-py = root.lyrics-pos-y;
                                                    } else {
                                                        self.drag-mode = 0;
                                                    }
                                                } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                                    if (self.drag-mode != 0) {
                                                        self.drag-mode = 0;
                                                        root.style-changed();
                                                    }
                                                }
                                            }
                                            moved => {
                                                if (self.pressed && style-canvas.width > 1px && style-canvas.height > 1px) {
                                                    if (self.drag-mode == 1) {
                                                        root.lyrics-pos-x = Math.clamp(self.start-px + (self.mouse-x - self.pressed-x) / style-canvas.width, 0.05, 0.95);
                                                        root.lyrics-pos-y = Math.clamp(self.start-py + (self.mouse-y - self.pressed-y) / style-canvas.height, 0.05, 0.95);
                                                    } else if (self.drag-mode == 2) {
                                                        root.lyrics-width = Math.clamp(self.start-w + 2.0 * (self.mouse-x - self.pressed-x) / style-canvas.width, 0.15, 1.0);
                                                        root.lyrics-height = Math.clamp(self.start-h + 2.0 * (self.mouse-y - self.pressed-y) / style-canvas.height, 0.08, 1.0);
                                                    } else if (self.drag-mode == 3) {
                                                        root.index-pos-x = Math.clamp(self.start-px + (self.mouse-x - self.pressed-x) / style-canvas.width, 0.05, 0.95);
                                                        root.index-pos-y = Math.clamp(self.start-py + (self.mouse-y - self.pressed-y) / style-canvas.height, 0.05, 0.95);
                                                    } else if (self.drag-mode == 4) {
                                                        root.index-width = Math.clamp(self.start-w + 2.0 * (self.mouse-x - self.pressed-x) / style-canvas.width, 0.12, 1.0);
                                                        root.index-height = Math.clamp(self.start-h + 2.0 * (self.mouse-y - self.pressed-y) / style-canvas.height, 0.06, 0.60);
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // Box Geometry Controls
                                    Rectangle {
                                        vertical-stretch: 1;
                                        border-radius: Theme.radius-md;
                                        background: Theme.bg-surface-1;
                                        border-width: 1px;
                                        border-color: Theme.border-subtle;

                                        ScrollView {
                                            VerticalLayout {
                                                padding: 12px;
                                                spacing: 7px;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    GlassButton { label: "Caja: Letras"; horizontal-stretch: 1; primary: root.style-editor-box == 0; clicked => { root.style-editor-box = 0; } }
                                                    GlassButton { label: "Caja: Índice (Solo Biblia)"; horizontal-stretch: 1; primary: root.style-editor-box == 1; clicked => { root.style-editor-box = 1; } }
                                                }

                                                Text {
                                                    text: "Arrastra la caja para moverla o su esquina inferior derecha para redimensionar el área sin alterar el tamaño de fuente.";
                                                    color: Theme.text-muted;
                                                    font-size: 10.5px;
                                                    wrap: word-wrap;
                                                }

                                                if root.style-editor-box == 0 : VerticalLayout {
                                                    spacing: 4px;
                                                    HorizontalLayout { alignment: space-between; Text { text: "Posición X (Letras)"; color: Theme.text-secondary; font-size: 11.5px; } Text { text: Math.round(root.lyrics-pos-x * 100) + "%"; color: Theme.text-primary; font-size: 11.5px; } }
                                                    Slider { minimum: 0.05; maximum: 0.95; value <=> root.lyrics-pos-x; changed(v) => { root.style-changed(); } }
                                                    HorizontalLayout { alignment: space-between; Text { text: "Posición Y (Letras)"; color: Theme.text-secondary; font-size: 11.5px; } Text { text: Math.round(root.lyrics-pos-y * 100) + "%"; color: Theme.text-primary; font-size: 11.5px; } }
                                                    Slider { minimum: 0.05; maximum: 0.95; value <=> root.lyrics-pos-y; changed(v) => { root.style-changed(); } }
                                                    HorizontalLayout { alignment: space-between; Text { text: "Ancho de Espacio (Salto de línea)"; color: Theme.text-secondary; font-size: 11.5px; } Text { text: Math.round(root.lyrics-width * 100) + "%"; color: Theme.accent-strong; font-size: 11.5px; font-weight: 700; } }
                                                    Slider { minimum: 0.15; maximum: 1.00; value <=> root.lyrics-width; changed(v) => { root.style-changed(); } }
                                                    HorizontalLayout { alignment: space-between; Text { text: "Alto de Espacio (Límite vertical)"; color: Theme.text-secondary; font-size: 11.5px; } Text { text: Math.round(root.lyrics-height * 100) + "%"; color: Theme.accent-strong; font-size: 11.5px; font-weight: 700; } }
                                                    Slider { minimum: 0.08; maximum: 1.00; value <=> root.lyrics-height; changed(v) => { root.style-changed(); } }
                                                }

                                                if root.style-editor-box == 1 : VerticalLayout {
                                                    spacing: 4px;
                                                    SwitchRow {
                                                        title: "Mostrar Índice en Versículos de Biblia";
                                                        subtitle: "Las canciones no muestran índice; solo se usa para citas bíblicas";
                                                        checked <=> root.index-box-enabled;
                                                        toggled(v) => { root.style-changed(); }
                                                    }
                                                    HorizontalLayout { alignment: space-between; Text { text: "Posición X (Índice)"; color: Theme.text-secondary; font-size: 11.5px; } Text { text: Math.round(root.index-pos-x * 100) + "%"; color: Theme.text-primary; font-size: 11.5px; } }
                                                    Slider { minimum: 0.05; maximum: 0.95; value <=> root.index-pos-x; changed(v) => { root.style-changed(); } }
                                                    HorizontalLayout { alignment: space-between; Text { text: "Posición Y (Índice)"; color: Theme.text-secondary; font-size: 11.5px; } Text { text: Math.round(root.index-pos-y * 100) + "%"; color: Theme.text-primary; font-size: 11.5px; } }
                                                    Slider { minimum: 0.05; maximum: 0.95; value <=> root.index-pos-y; changed(v) => { root.style-changed(); } }
                                                    HorizontalLayout { alignment: space-between; Text { text: "Ancho de Espacio (Índice)"; color: Theme.text-secondary; font-size: 11.5px; } Text { text: Math.round(root.index-width * 100) + "%"; color: Theme.stage-amber; font-size: 11.5px; font-weight: 700; } }
                                                    Slider { minimum: 0.12; maximum: 1.00; value <=> root.index-width; changed(v) => { root.style-changed(); } }
                                                    HorizontalLayout { alignment: space-between; Text { text: "Alto de Espacio (Índice)"; color: Theme.text-secondary; font-size: 11.5px; } Text { text: Math.round(root.index-height * 100) + "%"; color: Theme.stage-amber; font-size: 11.5px; font-weight: 700; } }
                                                    Slider { minimum: 0.06; maximum: 0.60; value <=> root.index-height; changed(v) => { root.style-changed(); } }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Right: Independent Inspector (Letras vs Índice Solo Biblia)
                                Rectangle {
                                    width: 440px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    ScrollView {
                                        VerticalLayout {
                                            padding: 13px;
                                            spacing: 9px;

                                            // Inspector Target Header
                                            Rectangle {
                                                height: 28px;
                                                border-radius: 6px;
                                                background: root.style-editor-box == 0 ? Theme.accent-soft : #f59e0b22;
                                                border-width: 1px;
                                                border-color: root.style-editor-box == 0 ? Theme.border-accent : #f59e0b66;
                                                Text {
                                                    text: root.style-editor-box == 0 ? "Editando Estilo de: LETRAS" : "Editando Estilo de: ÍNDICE (SOLO BIBLIA)";
                                                    color: root.style-editor-box == 0 ? Theme.accent-strong : Theme.stage-amber;
                                                    font-size: 11.5px;
                                                    font-weight: 800;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // ── PANEL A: ESTILO DE LETRAS ──
                                            if root.style-editor-box == 0 : VerticalLayout {
                                                spacing: 8px;

                                                Text { text: "Tipografía y Tamaño (Letras)"; color: Theme.text-secondary; font-size: 12px; font-weight: 700; }
                                                GlassButton {
                                                    label: "Fuente: " + (root.font-family-name == "" ? "Predeterminada" : root.font-family-name) + "  ▾";
                                                    compact: true;
                                                    clicked => {
                                                        root.font-picker-target = 0;
                                                        root.font-picker-search = "";
                                                        root.font-search-changed("");
                                                        root.font-picker-open = true;
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    GlassButton { label: "Default"; compact: true; horizontal-stretch: 1; primary: root.font-family-idx == 0; clicked => { root.font-preset-selected(0, 0); } }
                                                    GlassButton { label: "Sans";    compact: true; horizontal-stretch: 1; primary: root.font-family-idx == 1; clicked => { root.font-preset-selected(0, 1); } }
                                                    GlassButton { label: "Serif";   compact: true; horizontal-stretch: 1; primary: root.font-family-idx == 2; clicked => { root.font-preset-selected(0, 2); } }
                                                    GlassButton { label: "Mono";    compact: true; horizontal-stretch: 1; primary: root.font-family-idx == 3; clicked => { root.font-preset-selected(0, 3); } }
                                                }
                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    GlassButton { label: "Normal";  compact: true; horizontal-stretch: 1; primary: root.font-weight-idx == 0; clicked => { root.font-weight-idx = 0; root.style-changed(); } }
                                                    GlassButton { label: "Negrita"; compact: true; horizontal-stretch: 1; primary: root.font-weight-idx == 1; clicked => { root.font-weight-idx = 1; root.style-changed(); } }
                                                    GlassButton { label: "Extra";   compact: true; horizontal-stretch: 1; primary: root.font-weight-idx == 2; clicked => { root.font-weight-idx = 2; root.style-changed(); } }
                                                }

                                                HorizontalLayout { alignment: space-between; Text { text: "Tamaño de Fuente"; color: Theme.text-primary; font-size: 12px; } Text { text: Math.round(root.text-size) + " px"; color: Theme.accent-strong; font-size: 12px; font-weight: 700; } }
                                                Slider { minimum: 20; maximum: 220; value <=> root.text-size; changed(v) => { root.style-changed(); } }

                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    GlassButton { label: "Izq";    compact: true; horizontal-stretch: 1; primary: root.text-align == 0; clicked => { root.text-align = 0; root.style-changed(); } }
                                                    GlassButton { label: "Centro"; compact: true; horizontal-stretch: 1; primary: root.text-align == 1; clicked => { root.text-align = 1; root.style-changed(); } }
                                                    GlassButton { label: "Der";    compact: true; horizontal-stretch: 1; primary: root.text-align == 2; clicked => { root.text-align = 2; root.style-changed(); } }
                                                }
                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    GlassButton { label: "Arriba"; compact: true; horizontal-stretch: 1; primary: root.text-valign == 0; clicked => { root.text-valign = 0; root.style-changed(); } }
                                                    GlassButton { label: "Medio";  compact: true; horizontal-stretch: 1; primary: root.text-valign == 1; clicked => { root.text-valign = 1; root.style-changed(); } }
                                                    GlassButton { label: "Abajo";  compact: true; horizontal-stretch: 1; primary: root.text-valign == 2; clicked => { root.text-valign = 2; root.style-changed(); } }
                                                }

                                                Text { text: "Color de Letras (RGB Libre)"; color: Theme.text-secondary; font-size: 12px; font-weight: 700; }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Rectangle { width: 28px; height: 28px; border-radius: 6px; background: root.text-color; border-width: 1px; border-color: Theme.border-medium; }
                                                    GlassButton { label: "Blanco";   compact: true; horizontal-stretch: 1; clicked => { root.text-color-selected(0); } }
                                                    GlassButton { label: "Crema";    compact: true; horizontal-stretch: 1; clicked => { root.text-color-selected(1); } }
                                                    GlassButton { label: "Dorado";   compact: true; horizontal-stretch: 1; clicked => { root.text-color-selected(3); } }
                                                    GlassButton { label: "Amarillo"; compact: true; horizontal-stretch: 1; clicked => { root.text-color-selected(4); } }
                                                }
                                                HorizontalLayout { alignment: space-between; Text { text: "R"; color: #f87171; font-size: 11px; width: 16px; } Slider { horizontal-stretch: 1; minimum: 0; maximum: 255; value <=> root.text-color-r; changed(v) => { root.text-color-rgb-changed(root.text-color-r, root.text-color-g, root.text-color-b); } } Text { text: Math.round(root.text-color-r); color: Theme.text-muted; font-size: 11px; width: 28px; } }
                                                HorizontalLayout { alignment: space-between; Text { text: "G"; color: #4ade80; font-size: 11px; width: 16px; } Slider { horizontal-stretch: 1; minimum: 0; maximum: 255; value <=> root.text-color-g; changed(v) => { root.text-color-rgb-changed(root.text-color-r, root.text-color-g, root.text-color-b); } } Text { text: Math.round(root.text-color-g); color: Theme.text-muted; font-size: 11px; width: 28px; } }
                                                HorizontalLayout { alignment: space-between; Text { text: "B"; color: #60a5fa; font-size: 11px; width: 16px; } Slider { horizontal-stretch: 1; minimum: 0; maximum: 255; value <=> root.text-color-b; changed(v) => { root.text-color-rgb-changed(root.text-color-r, root.text-color-g, root.text-color-b); } } Text { text: Math.round(root.text-color-b); color: Theme.text-muted; font-size: 11px; width: 28px; } }

                                                Text { text: "Efectos Visuales (Letras)"; color: Theme.text-secondary; font-size: 12px; font-weight: 700; }
                                                SwitchRow { title: "Sombra de Texto"; checked <=> root.text-shadow; toggled(v) => { root.style-changed(); } }
                                                SwitchRow { title: "Contorno / Borde Negro"; checked <=> root.text-outline; toggled(v) => { root.style-changed(); } }
                                                SwitchRow { title: "Resplandor / Glow"; checked <=> root.text-glow; toggled(v) => { root.style-changed(); } }
                                                SwitchRow { title: "Efecto Neón"; checked <=> root.text-neon; toggled(v) => { root.style-changed(); } }
                                                SwitchRow { title: "Texto 3D (Extrusión)"; checked <=> root.text-3d; toggled(v) => { root.style-changed(); } }
                                                SwitchRow { title: "Subrayado"; checked <=> root.text-underline; toggled(v) => { root.style-changed(); } }
                                                SwitchRow { title: "TODO EN MAYÚSCULAS"; checked <=> root.text-uppercase; toggled(v) => { root.style-changed(); } }
                                                SwitchRow { title: "Caja Oscura detrás del Texto"; checked <=> root.text-box-bg; toggled(v) => { root.style-changed(); } }

                                                Rectangle { height: 1px; background: Theme.border-subtle; }
                                                Text { text: "Ajuste Automático si el Texto No Cabe (Biblia / Letras)"; color: Theme.text-secondary; font-size: 12px; font-weight: 700; }
                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    GlassButton { label: "Normal";       compact: true; horizontal-stretch: 1; primary: root.text-fit-mode == 0; clicked => { root.text-fit-mode = 0; root.style-changed(); } }
                                                    GlassButton { label: "Auto-Achicar"; compact: true; horizontal-stretch: 1; primary: root.text-fit-mode == 1; clicked => { root.text-fit-mode = 1; root.style-changed(); } }
                                                    GlassButton { label: "Auto-Cortar";  compact: true; horizontal-stretch: 1; primary: root.text-fit-mode == 2; clicked => { root.text-fit-mode = 2; root.style-changed(); } }
                                                }
                                                Text {
                                                    text: root.text-fit-mode == 1 ? "Reduce automáticamente el tamaño de la fuente cuando un versículo o estrofa supera el alto del área."
                                                        : (root.text-fit-mode == 2 ? "Divide automáticamente versículos largos en diapositivas consecutivas para que sigan abajo sin cortarse."
                                                        : "Usa el tamaño de fuente exacto sin reescalar ni dividir bloques.");
                                                    color: Theme.text-muted;
                                                    font-size: 10.5px;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            // ── PANEL B: ESTILO INDEPENDIENTE DE ÍNDICE (SOLO BIBLIA) ──
                                            if root.style-editor-box == 1 : VerticalLayout {
                                                spacing: 8px;

                                                Text { text: "Tipografía y Tamaño (Índice Biblia)"; color: Theme.text-secondary; font-size: 12px; font-weight: 700; }
                                                GlassButton {
                                                    label: "Fuente Índice: " + (root.index-font-family-name == "" ? "Predeterminada" : root.index-font-family-name) + "  ▾";
                                                    compact: true;
                                                    clicked => {
                                                        root.font-picker-target = 1;
                                                        root.font-picker-search = "";
                                                        root.font-search-changed("");
                                                        root.font-picker-open = true;
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    GlassButton { label: "Default"; compact: true; horizontal-stretch: 1; primary: root.index-font-family-idx == 0; clicked => { root.font-preset-selected(1, 0); } }
                                                    GlassButton { label: "Sans";    compact: true; horizontal-stretch: 1; primary: root.index-font-family-idx == 1; clicked => { root.font-preset-selected(1, 1); } }
                                                    GlassButton { label: "Serif";   compact: true; horizontal-stretch: 1; primary: root.index-font-family-idx == 2; clicked => { root.font-preset-selected(1, 2); } }
                                                    GlassButton { label: "Mono";    compact: true; horizontal-stretch: 1; primary: root.index-font-family-idx == 3; clicked => { root.font-preset-selected(1, 3); } }
                                                }
                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    GlassButton { label: "Normal";  compact: true; horizontal-stretch: 1; primary: root.index-font-weight-idx == 0; clicked => { root.index-font-weight-idx = 0; root.style-changed(); } }
                                                    GlassButton { label: "Negrita"; compact: true; horizontal-stretch: 1; primary: root.index-font-weight-idx == 1; clicked => { root.index-font-weight-idx = 1; root.style-changed(); } }
                                                    GlassButton { label: "Extra";   compact: true; horizontal-stretch: 1; primary: root.index-font-weight-idx == 2; clicked => { root.index-font-weight-idx = 2; root.style-changed(); } }
                                                }

                                                HorizontalLayout { alignment: space-between; Text { text: "Tamaño del Índice"; color: Theme.text-primary; font-size: 12px; } Text { text: Math.round(root.index-size) + " px"; color: Theme.stage-amber; font-size: 12px; font-weight: 700; } }
                                                Slider { minimum: 14; maximum: 72; value <=> root.index-size; changed(v) => { root.style-changed(); } }

                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    GlassButton { label: "Izq";    compact: true; horizontal-stretch: 1; primary: root.index-align == 0; clicked => { root.index-align = 0; root.style-changed(); } }
                                                    GlassButton { label: "Centro"; compact: true; horizontal-stretch: 1; primary: root.index-align == 1; clicked => { root.index-align = 1; root.style-changed(); } }
                                                    GlassButton { label: "Der";    compact: true; horizontal-stretch: 1; primary: root.index-align == 2; clicked => { root.index-align = 2; root.style-changed(); } }
                                                }

                                                Text { text: "Color del Índice (RGB Independiente)"; color: Theme.text-secondary; font-size: 12px; font-weight: 700; }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Rectangle { width: 28px; height: 28px; border-radius: 6px; background: root.index-color; border-width: 1px; border-color: Theme.border-medium; }
                                                    GlassButton { label: "Blanco"; compact: true; horizontal-stretch: 1; clicked => { root.index-color-selected(0); } }
                                                    GlassButton { label: "Dorado"; compact: true; horizontal-stretch: 1; clicked => { root.index-color-selected(1); } }
                                                    GlassButton { label: "Celeste"; compact: true; horizontal-stretch: 1; clicked => { root.index-color-selected(2); } }
                                                    GlassButton { label: "Plata";  compact: true; horizontal-stretch: 1; clicked => { root.index-color-selected(3); } }
                                                }
                                                HorizontalLayout { alignment: space-between; Text { text: "R"; color: #f87171; font-size: 11px; width: 16px; } Slider { horizontal-stretch: 1; minimum: 0; maximum: 255; value <=> root.index-color-r; changed(v) => { root.index-color-rgb-changed(root.index-color-r, root.index-color-g, root.index-color-b); } } Text { text: Math.round(root.index-color-r); color: Theme.text-muted; font-size: 11px; width: 28px; } }
                                                HorizontalLayout { alignment: space-between; Text { text: "G"; color: #4ade80; font-size: 11px; width: 16px; } Slider { horizontal-stretch: 1; minimum: 0; maximum: 255; value <=> root.index-color-g; changed(v) => { root.index-color-rgb-changed(root.index-color-r, root.index-color-g, root.index-color-b); } } Text { text: Math.round(root.index-color-g); color: Theme.text-muted; font-size: 11px; width: 28px; } }
                                                HorizontalLayout { alignment: space-between; Text { text: "B"; color: #60a5fa; font-size: 11px; width: 16px; } Slider { horizontal-stretch: 1; minimum: 0; maximum: 255; value <=> root.index-color-b; changed(v) => { root.index-color-rgb-changed(root.index-color-r, root.index-color-g, root.index-color-b); } } Text { text: Math.round(root.index-color-b); color: Theme.text-muted; font-size: 11px; width: 28px; } }

                                                Text { text: "Efectos Propios del Índice"; color: Theme.text-secondary; font-size: 12px; font-weight: 700; }
                                                SwitchRow { title: "Sombra del Índice"; checked <=> root.index-shadow; toggled(v) => { root.style-changed(); } }
                                                SwitchRow { title: "Contorno Negro del Índice"; checked <=> root.index-outline; toggled(v) => { root.style-changed(); } }
                                                SwitchRow { title: "Resplandor / Glow del Índice"; checked <=> root.index-glow; toggled(v) => { root.style-changed(); } }
                                                SwitchRow { title: "ÍNDICE EN MAYÚSCULAS"; checked <=> root.index-uppercase; toggled(v) => { root.style-changed(); } }
                                                SwitchRow { title: "Fondo Oscuro tras el Índice"; checked <=> root.index-box-bg; toggled(v) => { root.style-changed(); } }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Subtab 1: Shaders / Filtros de Video + Ecualizador de Audio (libmpv)
                        if root.design-subtab == 1 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 12px;
                                padding-right: 8px;

                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text { text: "Shaders y Color Grading en Vivo (libmpv)"; color: Theme.text-primary; font-size: 13.5px; font-weight: 700; vertical-alignment: center; }
                                            GlassButton { label: "Restablecer"; icon: @image-url("icons/refresh.svg"); has-icon: true; clicked => { root.reset-shaders(); } }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            GlassButton { label: "Normal"; horizontal-stretch: 1; primary: root.shader-preset == 0; clicked => { root.shader-preset = 0; root.shaders-changed(); } }
                                            GlassButton { label: "Cálido"; horizontal-stretch: 1; primary: root.shader-preset == 1; clicked => { root.shader-preset = 1; root.shaders-changed(); } }
                                            GlassButton { label: "Cine";   horizontal-stretch: 1; primary: root.shader-preset == 2; clicked => { root.shader-preset = 2; root.shaders-changed(); } }
                                            GlassButton { label: "Noir B&W"; horizontal-stretch: 1; primary: root.shader-preset == 3; clicked => { root.shader-preset = 3; root.shaders-changed(); } }
                                            GlassButton { label: "Sepia";  horizontal-stretch: 1; primary: root.shader-preset == 4; clicked => { root.shader-preset = 4; root.shaders-changed(); } }
                                            GlassButton { label: "Contraste"; horizontal-stretch: 1; primary: root.shader-preset == 5; clicked => { root.shader-preset = 5; root.shaders-changed(); } }
                                        }

                                        HorizontalLayout { alignment: space-between; Text { text: "Brillo"; color: Theme.text-secondary; font-size: 12px; } Text { text: Math.round(root.shader-brightness); color: Theme.text-primary; font-size: 12px; } }
                                        Slider { minimum: -50; maximum: 50; value <=> root.shader-brightness; changed(v) => { root.shaders-changed(); } }

                                        HorizontalLayout { alignment: space-between; Text { text: "Contraste"; color: Theme.text-secondary; font-size: 12px; } Text { text: Math.round(root.shader-contrast); color: Theme.text-primary; font-size: 12px; } }
                                        Slider { minimum: -50; maximum: 50; value <=> root.shader-contrast; changed(v) => { root.shaders-changed(); } }

                                        HorizontalLayout { alignment: space-between; Text { text: "Saturación"; color: Theme.text-secondary; font-size: 12px; } Text { text: Math.round(root.shader-saturation); color: Theme.text-primary; font-size: 12px; } }
                                        Slider { minimum: -100; maximum: 100; value <=> root.shader-saturation; changed(v) => { root.shaders-changed(); } }

                                        HorizontalLayout { alignment: space-between; Text { text: "Gamma"; color: Theme.text-secondary; font-size: 12px; } Text { text: Math.round(root.shader-gamma); color: Theme.text-primary; font-size: 12px; } }
                                        Slider { minimum: -50; maximum: 50; value <=> root.shader-gamma; changed(v) => { root.shaders-changed(); } }

                                        SwitchRow { title: "Desenfoque de Fondo (Gaussian Blur)"; subtitle: "Suaviza videos de fondo para resaltar las letras"; checked <=> root.shader-blur; toggled(v) => { root.shaders-changed(); } }
                                        SwitchRow { title: "Viñeta Cinemática"; subtitle: "Oscurece suavemente los bordes de la proyección"; checked <=> root.shader-vignette; toggled(v) => { root.shaders-changed(); } }
                                    }
                                }

                                // Audio Equalizer (libmpv lavfi)
                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 9px;

                                        SwitchRow { title: "Ecualizador de Audio (libmpv)"; subtitle: "Ajusta Graves, Medios y Agudos en tiempo real"; checked <=> root.eq-enabled; toggled(v) => { root.eq-changed(); } }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            GlassButton { label: "Plano";     horizontal-stretch: 1; clicked => { root.apply-eq-preset(0); } }
                                            GlassButton { label: "Voz / Pred."; horizontal-stretch: 1; clicked => { root.apply-eq-preset(1); } }
                                            GlassButton { label: "Alabanza";  horizontal-stretch: 1; clicked => { root.apply-eq-preset(2); } }
                                            GlassButton { label: "Acústico";  horizontal-stretch: 1; clicked => { root.apply-eq-preset(3); } }
                                        }

                                        HorizontalLayout { alignment: space-between; Text { text: "Graves (100 Hz)"; color: Theme.text-secondary; font-size: 12px; } Text { text: Math.round(root.eq-bass) + " dB"; color: Theme.text-primary; font-size: 12px; } }
                                        Slider { minimum: -12; maximum: 12; value <=> root.eq-bass; changed(v) => { root.eq-changed(); } }

                                        HorizontalLayout { alignment: space-between; Text { text: "Medios (1 kHz)"; color: Theme.text-secondary; font-size: 12px; } Text { text: Math.round(root.eq-mid) + " dB"; color: Theme.text-primary; font-size: 12px; } }
                                        Slider { minimum: -12; maximum: 12; value <=> root.eq-mid; changed(v) => { root.eq-changed(); } }

                                        HorizontalLayout { alignment: space-between; Text { text: "Agudos (8 kHz)"; color: Theme.text-secondary; font-size: 12px; } Text { text: Math.round(root.eq-treble) + " dB"; color: Theme.text-primary; font-size: 12px; } }
                                        Slider { minimum: -12; maximum: 12; value <=> root.eq-treble; changed(v) => { root.eq-changed(); } }
                                    }
                                }
                            }
                        }

                        // Subtab 2: Transiciones animadas (Presets integrados + Preview 16:9 en vivo)
                        if root.design-subtab == 2 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 12px;
                                padding-right: 8px;

                                // Live 16:9 Transition Preview Box
                                Rectangle {
                                    height: 204px;
                                    border-radius: Theme.radius-md;
                                    background: @linear-gradient(135deg, #090c14 0%, #161b2e 52%, #0c0d14 100%);
                                    border-width: 1px;
                                    border-color: Theme.border-medium;
                                    clip: true;

                                    // Animated sample text layer mirroring ProjectorWindow transitions (0..4)
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        opacity: root.transition-type == 0 ? 1.0 : (root.trans-preview-visible ? 1.0 : 0.0);
                                        x: root.transition-type == 2 ? (root.trans-preview-visible ? 0px : 90px)
                                         : root.transition-type == 4 ? (root.trans-preview-visible ? 0px : -90px)
                                         : 0px;
                                        y: root.transition-type == 3 ? (root.trans-preview-visible ? 0px : 54px) : 0px;

                                        animate opacity { duration: root.trans-preview-dur; easing: ease-out; }
                                        animate x { duration: root.trans-preview-dur; easing: ease-out; }
                                        animate y { duration: root.trans-preview-dur; easing: ease-out; }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            padding: 20px;
                                            Text {
                                                text: "Cuan grande es Dios\nCántale cuan grande es Dios";
                                                color: #ffffff;
                                                font-size: 22px;
                                                font-weight: 800;
                                                horizontal-alignment: center;
                                            }
                                            Text {
                                                text: "Salmos 145:3  •  Vista Previa de Transición";
                                                color: Theme.accent-strong;
                                                font-size: 12px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }

                                    // Top-left preview badge
                                    Rectangle {
                                        x: 10px;
                                        y: 10px;
                                        height: 22px;
                                        width: tp-lbl.preferred-width + 16px;
                                        border-radius: 5px;
                                        background: #08080ad0;
                                        border-width: 1px;
                                        border-color: #ffffff1c;
                                        tp-lbl := Text {
                                            x: 8px;
                                            height: parent.height;
                                            text: "PREVIEW 16:9  •  " + Math.round(root.transition-duration-ms) + " ms";
                                            color: Theme.accent-strong;
                                            font-size: 10.5px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Click preview box to replay animation
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.replay-transition-preview(); }
                                    }
                                }

                                // 6 Built-in Default Transition Presets
                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text { text: "Transiciones Incluidas (Haz clic para previsualizar y aplicar)"; color: Theme.text-primary; font-size: 13.5px; font-weight: 700; vertical-alignment: center; }
                                            GlassButton {
                                                label: "Repetir Preview";
                                                icon: @image-url("icons/play.svg");
                                                has-icon: true;
                                                clicked => { root.replay-transition-preview(); }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            GlassButton { label: "Corte Directo (0ms)"; horizontal-stretch: 1; primary: root.active-transition-preset == 0; clicked => { root.select-transition-preset(0); } }
                                            GlassButton { label: "Fundido Suave (350ms)"; horizontal-stretch: 1; primary: root.active-transition-preset == 1; clicked => { root.select-transition-preset(1); } }
                                            GlassButton { label: "Fundido Cine (900ms)"; horizontal-stretch: 1; primary: root.active-transition-preset == 2; clicked => { root.select-transition-preset(2); } }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            GlassButton { label: "Deslizar Izq (400ms)"; horizontal-stretch: 1; primary: root.active-transition-preset == 3; clicked => { root.select-transition-preset(3); } }
                                            GlassButton { label: "Deslizar Arriba (420ms)"; horizontal-stretch: 1; primary: root.active-transition-preset == 4; clicked => { root.select-transition-preset(4); } }
                                            GlassButton { label: "Deslizar Der (400ms)"; horizontal-stretch: 1; primary: root.active-transition-preset == 5; clicked => { root.select-transition-preset(5); } }
                                        }
                                    }
                                }

                                // Fine-tune custom controls
                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;

                                        Text { text: "Ajuste Manual"; color: Theme.text-primary; font-size: 13px; font-weight: 700; }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            GlassButton { label: "Ninguna"; horizontal-stretch: 1; primary: root.transition-type == 0; clicked => { root.transition-type = 0; root.active-transition-preset = -1; root.transition-changed(); root.replay-transition-preview(); } }
                                            GlassButton { label: "Fade"; horizontal-stretch: 1; primary: root.transition-type == 1; clicked => { root.transition-type = 1; root.active-transition-preset = -1; root.transition-changed(); root.replay-transition-preview(); } }
                                            GlassButton { label: "Izq"; horizontal-stretch: 1; primary: root.transition-type == 2; clicked => { root.transition-type = 2; root.active-transition-preset = -1; root.transition-changed(); root.replay-transition-preview(); } }
                                            GlassButton { label: "Arriba"; horizontal-stretch: 1; primary: root.transition-type == 3; clicked => { root.transition-type = 3; root.active-transition-preset = -1; root.transition-changed(); root.replay-transition-preview(); } }
                                            GlassButton { label: "Der"; horizontal-stretch: 1; primary: root.transition-type == 4; clicked => { root.transition-type = 4; root.active-transition-preset = -1; root.transition-changed(); root.replay-transition-preview(); } }
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text { text: "Duración de la Transición"; color: Theme.text-secondary; font-size: 12.5px; font-weight: 600; }
                                            Text { text: Math.round(root.transition-duration-ms) + " ms"; color: Theme.accent-strong; font-size: 12.5px; font-weight: 700; }
                                        }
                                        Slider {
                                            minimum: 100;
                                            maximum: 1500;
                                            value <=> root.transition-duration-ms;
                                            changed(v) => { root.active-transition-preset = -1; root.transition-changed(); }
                                            released(v) => { root.replay-transition-preview(); }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            GlassButton {
                                                label: "Probar Transición en Pantalla";
                                                icon: @image-url("icons/tv.svg");
                                                has-icon: true;
                                                primary: true;
                                                clicked => { root.test-transition(); root.replay-transition-preview(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Subtab 3: Tiles (Pantalla Dividida)
                        if root.design-subtab == 3 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 12px;
                                padding-right: 8px;

                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 12px;

                                        Text { text: "Tiles — Pantalla Dividida en Vivo"; color: Theme.text-primary; font-size: 14px; font-weight: 700; }

                                        SwitchRow {
                                            title: "Activar Modo Tiles (Pantalla Dividida)";
                                            subtitle: "Divide la salida Público en 2 paneles para mostrar continuidad o dos bloques";
                                            checked <=> root.tiles-enabled;
                                            toggled(v) => { root.tiles-changed(); }
                                        }

                                        Text { text: "Distribución"; color: Theme.text-secondary; font-size: 12px; font-weight: 600; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            GlassButton { label: "2 Columnas (Izq / Der)"; horizontal-stretch: 1; primary: root.tiles-layout == 0; clicked => { root.tiles-layout = 0; root.tiles-changed(); } }
                                            GlassButton { label: "2 Filas (Sup / Inf)";    horizontal-stretch: 1; primary: root.tiles-layout == 1; clicked => { root.tiles-layout = 1; root.tiles-changed(); } }
                                        }

                                        Text { text: "Modo de Continuidad en Panel 2"; color: Theme.text-secondary; font-size: 12px; font-weight: 600; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            GlassButton { label: "Actual + Siguiente"; horizontal-stretch: 1; primary: root.tiles-continuity == 0; clicked => { root.tiles-continuity = 0; root.tiles-changed(); } }
                                            GlassButton { label: "Actual + Anterior";  horizontal-stretch: 1; primary: root.tiles-continuity == 1; clicked => { root.tiles-continuity = 1; root.tiles-changed(); } }
                                        }

                                        SwitchRow {
                                            title: "Mostrar Línea Divisora";
                                            checked <=> root.tiles-divider;
                                            toggled(v) => { root.tiles-changed(); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── Mode 5: Centro de Redes Unificado (Servicios 100% independientes) ──
                    if root.active-tab == 5 : VerticalLayout {
                        spacing: 10px;
                        vertical-stretch: 1;

                        HorizontalLayout {
                            spacing: 5px;
                            GlassButton { label: root.lan-running ? "● LAN" : "LAN";          compact: true; icon: @image-url("icons/radio.svg");      has-icon: true; primary: root.net-subtab == 0; clicked => { root.net-subtab = 0; } }
                            GlassButton { label: root.chat-running ? "● Chat" : "Chat";       compact: true; icon: @image-url("icons/chat.svg");       has-icon: true; primary: root.net-subtab == 1; clicked => { root.net-subtab = 1; } }
                            GlassButton { label: root.mobile-running ? "● Celular" : "Celular"; compact: true; icon: @image-url("icons/smartphone.svg"); has-icon: true; primary: root.net-subtab == 2; clicked => { root.net-subtab = 2; } }
                            GlassButton { label: "Reloj";                                     compact: true; icon: @image-url("icons/clock.svg");      has-icon: true; primary: root.net-subtab == 3; clicked => { root.net-subtab = 3; } }
                            GlassButton { label: "Luces OSC";                                 compact: true; icon: @image-url("icons/zap.svg");        has-icon: true; primary: root.net-subtab == 4; clicked => { root.net-subtab = 4; } }
                        }

                        // Subtab 0: Transmisión LAN (Video / Letras / OBS — Puerto 8080, SIN Chat)
                        if root.net-subtab == 0 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 12px;
                                padding-right: 8px;

                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: root.lan-running ? Theme.live-green.transparentize(0.4) : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 10px;
                                            Text { text: "Transmisión en Red Local — Motor Completo (OBS / Navegador / Smart TV)"; color: Theme.text-primary; font-size: 14px; font-weight: 700; }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Text { text: root.lan-url; color: root.lan-running ? Theme.live-green : Theme.text-secondary; font-size: 13px; font-weight: 600; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                                                if root.lan-running : GlassButton {
                                                    label: root.lan-copy-feedback;
                                                    compact: true;
                                                    clicked => { root.copy-lan-url(); }
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 8px;
                                                LineEdit { horizontal-stretch: 2; placeholder-text: "IP de red local (auto)"; text <=> root.lan-host-ip; }
                                                LineEdit { horizontal-stretch: 1; placeholder-text: "Puerto (8080)"; text <=> root.lan-port-input; }
                                            }

                                            Text {
                                                text: "Abre esta dirección en OBS Studio (Fuente de Navegador), otra PC, celular o navegador de tu Smart TV. Utiliza el mismo servidor HTTP/MJPEG y codificador en segundo plano que la versión clásica.";
                                                color: Theme.text-muted;
                                                font-size: 11.5px;
                                                wrap: word-wrap;
                                            }
                                            HorizontalLayout {
                                                alignment: start;
                                                GlassButton {
                                                    label: root.lan-running ? "Detener Transmisión LAN" : "Iniciar Transmisión LAN";
                                                    icon: @image-url("icons/radio.svg");
                                                    has-icon: true;
                                                    primary: !root.lan-running;
                                                    danger: root.lan-running;
                                                    clicked => { root.toggle-lan-stream(); }
                                                }
                                            }
                                        }

                                        if root.has-lan-qr : Rectangle {
                                            width: 146px;
                                            height: 146px;
                                            border-radius: 6px;
                                            background: #fafafa;
                                            Image {
                                                source: root.lan-qr-image;
                                                width: 136px;
                                                height: 136px;
                                                x: 5px;
                                                y: 5px;
                                                image-fit: contain;
                                            }
                                        }
                                    }
                                }

                                // ImGui StreamingPanel Parity: Contenido (Capas)
                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 6px;
                                        Text { text: "CONTENIDO (CAPAS)"; color: Theme.text-secondary; font-size: 11.5px; font-weight: 700; }
                                        SwitchRow {
                                            title: "Fondo";
                                            subtitle: "Envía video o imagen de fondo (desactivado muestra fondo negro)";
                                            checked <=> root.lan-send-bg;
                                            toggled(v) => {
                                                if (v) { root.lan-transparent = false; }
                                                root.lan-config-changed();
                                            }
                                        }
                                        SwitchRow {
                                            title: "Transparencia (Canal Alpha para OBS)";
                                            subtitle: "Envía solo texto sobre fondo transparente (desactiva Fondo automáticamente)";
                                            checked <=> root.lan-transparent;
                                            toggled(v) => {
                                                if (v) { root.lan-send-bg = false; }
                                                root.lan-config-changed();
                                            }
                                        }
                                        SwitchRow {
                                            title: "Textos";
                                            subtitle: "Muestra letras de canciones y versículos en vivo sobre el stream";
                                            checked <=> root.lan-send-text;
                                            toggled(v) => { root.lan-config-changed(); }
                                        }
                                        SwitchRow {
                                            title: "Overlay";
                                            subtitle: "Incluye capas gráficas activas en la transmisión";
                                            checked <=> root.lan-send-overlay;
                                            toggled(v) => { root.lan-config-changed(); }
                                        }
                                    }
                                }

                                // Estilo de Letra Independiente para LAN (no afecta a Público ni Público afecta a LAN)
                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: root.lan-own-style ? #38bdf866 : Theme.border-subtle;
                                    animate border-color { duration: 160ms; easing: ease-out; }

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 9px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            spacing: 8px;
                                            HorizontalLayout {
                                                spacing: 7px;
                                                Image {
                                                    source: @image-url("icons/palette.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    y: (parent.height - self.height) / 2;
                                                    colorize: root.lan-own-style ? #38bdf8 : Theme.text-secondary;
                                                    animate colorize { duration: 150ms; }
                                                }
                                                Text {
                                                    text: "ESTILO DE LETRAS PARA LAN";
                                                    color: root.lan-own-style ? #38bdf8 : Theme.text-secondary;
                                                    font-size: 11.5px;
                                                    font-weight: 800;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            GlassButton {
                                                label: "Crear / Editar Estilos";
                                                icon: @image-url("icons/edit.svg");
                                                has-icon: true;
                                                compact: true;
                                                clicked => {
                                                    root.select-style-target(2);
                                                    root.active-tab = 4;
                                                    root.design-subtab = 0;
                                                }
                                            }
                                        }

                                        SwitchRow {
                                            title: "Usar estilo de letra independiente en LAN";
                                            subtitle: "LAN mantiene su propio tamaño/fuente (ej. letras gigantes) sin afectar ni ser afectado por Público";
                                            checked <=> root.lan-own-style;
                                            toggled(v) => { root.set-screen-own-style(1, v); }
                                        }

                                        if !root.lan-own-style : Rectangle {
                                            height: 32px;
                                            border-radius: Theme.radius-sm;
                                            background: Theme.bg-surface-0;
                                            border-width: 1px;
                                            border-color: Theme.border-subtle;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                Text {
                                                    text: "Actualmente siguiendo el estilo de Público (" + root.lan-style-summary + ")";
                                                    color: Theme.text-muted;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }

                                        if root.lan-own-style : VerticalLayout {
                                            spacing: 6px;

                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text {
                                                    text: "Elige el estilo de letra exclusivo para LAN:";
                                                    color: Theme.text-secondary;
                                                    font-size: 11.5px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: "Activo: " + root.lan-style-summary;
                                                    color: #38bdf8;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            if root.saved-style-cards.length == 0 : Rectangle {
                                                height: 44px;
                                                border-radius: Theme.radius-sm;
                                                background: Theme.bg-surface-0;
                                                border-width: 1px;
                                                border-color: Theme.border-subtle;
                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 10px;
                                                    alignment: space-between;
                                                    Text {
                                                        text: "Aún no tienes estilos guardados. Crea uno (ej. 'LAN Gigante 140px').";
                                                        color: Theme.text-muted;
                                                        font-size: 11px;
                                                        vertical-alignment: center;
                                                    }
                                                    GlassButton {
                                                        label: "Crear Estilo LAN";
                                                        compact: true;
                                                        primary: true;
                                                        clicked => {
                                                            root.select-style-target(2);
                                                            root.active-tab = 4;
                                                            root.design-subtab = 0;
                                                            root.open-new-style-editor();
                                                        }
                                                    }
                                                }
                                            }

                                            for st[stIdx] in root.saved-style-cards : Rectangle {
                                                height: 40px;
                                                border-radius: Theme.radius-sm;
                                                background: stIdx == root.lan-assigned-style-idx
                                                    ? #0284c72a
                                                    : (lan-st-ta.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-0);
                                                border-width: 1px;
                                                border-color: stIdx == root.lan-assigned-style-idx
                                                    ? #38bdf8
                                                    : (lan-st-ta.has-hover ? Theme.border-medium : Theme.border-subtle);
                                                animate background   { duration: 130ms; easing: ease-out; }
                                                animate border-color { duration: 130ms; easing: ease-out; }

                                                lan-st-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.apply-style-to-screen(stIdx, 1); }
                                                }

                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    spacing: 10px;

                                                    Rectangle {
                                                        width: 14px;
                                                        height: 14px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 7px;
                                                        background: st.text-color;
                                                        border-width: 1px;
                                                        border-color: Theme.border-medium;
                                                    }
                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        alignment: center;
                                                        Text {
                                                            text: st.name;
                                                            color: stIdx == root.lan-assigned-style-idx ? #ffffff : Theme.text-primary;
                                                            font-size: 12px;
                                                            font-weight: 700;
                                                            overflow: elide;
                                                        }
                                                        Text {
                                                            text: st.summary;
                                                            color: Theme.text-muted;
                                                            font-size: 10px;
                                                            overflow: elide;
                                                        }
                                                    }
                                                    if stIdx == root.lan-assigned-style-idx : Rectangle {
                                                        height: 20px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 4px;
                                                        background: #0284c7;
                                                        HorizontalLayout {
                                                            padding-left: 7px;
                                                            padding-right: 7px;
                                                            Text {
                                                                text: "ACTIVO EN LAN";
                                                                color: #ffffff;
                                                                font-size: 9px;
                                                                font-weight: 800;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // ImGui StreamingPanel Parity: Calidad (Tamaño, Fluidez y Nitidez JPEG)
                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 9px;
                                        Text { text: "CALIDAD DE TRANSMISIÓN"; color: Theme.text-secondary; font-size: 11.5px; font-weight: 700; }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text { text: "Tamaño de Video"; color: Theme.text-primary; font-size: 12px; }
                                            Text { text: root.lan-res-preset == 0 ? "640 × 360" : (root.lan-res-preset == 2 ? "1920 × 1080" : "1280 × 720"); color: Theme.text-muted; font-size: 11.5px; }
                                        }
                                        HorizontalLayout {
                                            spacing: 5px;
                                            GlassButton { label: "Básica (360p)";   compact: true; horizontal-stretch: 1; primary: root.lan-res-preset == 0; clicked => { root.lan-res-preset = 0; root.lan-config-changed(); } }
                                            GlassButton { label: "Estándar (720p)"; compact: true; horizontal-stretch: 1; primary: root.lan-res-preset == 1; clicked => { root.lan-res-preset = 1; root.lan-config-changed(); } }
                                            GlassButton { label: "Alta (1080p)";    compact: true; horizontal-stretch: 1; primary: root.lan-res-preset == 2; clicked => { root.lan-res-preset = 2; root.lan-config-changed(); } }
                                        }

                                        Text { text: "Fluidez"; color: Theme.text-primary; font-size: 12px; }
                                        HorizontalLayout {
                                            spacing: 5px;
                                            GlassButton { label: "Ahorro (8 FPS)";     compact: true; horizontal-stretch: 1; primary: root.lan-video-mode == 0; clicked => { root.lan-video-mode = 0; root.lan-high-quality = false; root.lan-config-changed(); } }
                                            GlassButton { label: "Normal (MJPEG 30)";  compact: true; horizontal-stretch: 1; primary: root.lan-video-mode == 1; clicked => { root.lan-video-mode = 1; root.lan-high-quality = true;  root.lan-config-changed(); } }
                                            GlassButton { label: "Máxima (UltraEstable)"; compact: true; horizontal-stretch: 1; primary: root.lan-video-mode == 2; clicked => { root.lan-video-mode = 2; root.lan-high-quality = true; if (root.lan-jpeg-quality < 92) { root.lan-jpeg-quality = 95; } root.lan-config-changed(); } }
                                        }

                                        if root.lan-video-mode == 2 : HorizontalLayout {
                                            spacing: 6px;
                                            Text { text: "Velocidad objetivo:"; color: Theme.text-secondary; font-size: 11.5px; vertical-alignment: center; horizontal-stretch: 1; }
                                            GlassButton { label: "30 FPS"; compact: true; primary: root.lan-target-fps != 60; clicked => { root.lan-target-fps = 30; root.lan-config-changed(); } }
                                            GlassButton { label: "60 FPS"; compact: true; primary: root.lan-target-fps == 60; clicked => { root.lan-target-fps = 60; root.lan-config-changed(); } }
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text { text: "Calidad de imagen JPEG"; color: Theme.text-primary; font-size: 12px; }
                                            Text { text: Math.round(root.lan-jpeg-quality) + "%"; color: Theme.accent-strong; font-size: 12px; font-weight: 700; }
                                        }
                                        Slider { minimum: 20; maximum: 100; value <=> root.lan-jpeg-quality; changed(v) => { root.lan-config-changed(); } }
                                    }
                                }

                                // Smart TV Screen Sharing / DLNA Cast + IP directa
                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    VerticalLayout {
                                        padding: 15px;
                                        spacing: 10px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Image {
                                                    source: @image-url("icons/tv.svg");
                                                    width: 16px;
                                                    height: 16px;
                                                    y: (parent.height - self.height) / 2;
                                                    colorize: Theme.accent-strong;
                                                }
                                                Text {
                                                    text: "Enviar a Smart TV / Screen Sharing (DLNA / Wi-Fi)";
                                                    color: Theme.text-primary;
                                                    font-size: 13.5px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            GlassButton {
                                                label: root.smart-tv-scanning ? "Buscando..." : "Buscar Smart TVs";
                                                icon: @image-url("icons/refresh.svg");
                                                has-icon: true;
                                                primary: true;
                                                clicked => { root.scan-smart-tvs(); }
                                            }
                                        }

                                        // Direct IP cast input for Smart TVs
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                horizontal-stretch: 1;
                                                placeholder-text: "IP directa de Smart TV (ej. 192.168.1.50)";
                                                text <=> root.smart-tv-manual-ip;
                                                accepted(ip) => {
                                                    if (ip != "") { root.cast-to-smart-tv-ip(ip); }
                                                }
                                            }
                                            GlassButton {
                                                label: "Enviar a IP";
                                                icon: @image-url("icons/tv.svg");
                                                has-icon: true;
                                                clicked => {
                                                    if (root.smart-tv-manual-ip != "") {
                                                        root.cast-to-smart-tv-ip(root.smart-tv-manual-ip);
                                                    }
                                                }
                                            }
                                        }

                                        if root.smart-tv-devices.length > 0 : VerticalLayout {
                                            spacing: 6px;
                                            for tv[tidx] in root.smart-tv-devices : Rectangle {
                                                height: 46px;
                                                border-radius: Theme.radius-sm;
                                                background: tv.active ? Theme.live-green-soft : Theme.bg-surface-0;
                                                border-width: 1px;
                                                border-color: tv.active ? Theme.live-green : Theme.border-subtle;

                                                HorizontalLayout {
                                                    padding-left: 11px;
                                                    padding-right: 8px;
                                                    spacing: 8px;
                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        alignment: center;
                                                        Text { text: tv.name; color: Theme.text-primary; font-size: 12.5px; font-weight: 700; overflow: elide; }
                                                        Text { text: tv.info; color: Theme.text-muted; font-size: 10.5px; overflow: elide; }
                                                    }
                                                    GlassButton {
                                                        label: tv.active ? "Reenviar" : "Enviar a TV";
                                                        icon: @image-url("icons/tv.svg");
                                                        has-icon: true;
                                                        compact: true;
                                                        primary: !tv.active;
                                                        clicked => { root.cast-to-smart-tv(tidx); }
                                                    }
                                                    if tv.active : GlassButton {
                                                        label: "Detener";
                                                        compact: true;
                                                        danger: true;
                                                        clicked => { root.stop-smart-tv-cast(tidx); }
                                                    }
                                                }
                                            }
                                        }

                                        Text {
                                            text: root.smart-tv-status;
                                            color: Theme.text-secondary;
                                            font-size: 11.5px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // Firewall / Wi-Fi Diagnostics Card
                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: root.lan-firewall-warning ? #78350f38 : Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: root.lan-firewall-warning ? #f59e0b88 : Theme.border-subtle;

                                    VerticalLayout {
                                        padding: 13px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text { text: "Acceso Wi-Fi / Firewall del Sistema"; color: root.lan-firewall-warning ? Theme.stage-amber : Theme.text-primary; font-size: 12.5px; font-weight: 700; vertical-alignment: center; }
                                            GlassButton {
                                                label: "Abrir Puertos (8080, 8082, 8090)";
                                                compact: true;
                                                primary: root.lan-firewall-warning;
                                                clicked => { root.open-firewall-ports(); }
                                            }
                                        }
                                        Text {
                                            text: root.lan-firewall-status;
                                            color: Theme.text-secondary;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }

                        // Subtab 1: Chat de Equipo LAN Independiente (Puerto 8082 — SIN Video, consumo ~0%)
                        if root.net-subtab == 1 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 12px;
                                padding-right: 8px;

                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: root.chat-running ? Theme.live-green.transparentize(0.4) : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 10px;
                                            Text { text: "Chat de Equipo en Red Local (Independiente, sin Video)"; color: Theme.text-primary; font-size: 14px; font-weight: 700; }
                                            Text { text: root.chat-url; color: root.chat-running ? Theme.live-green : Theme.text-secondary; font-size: 13px; font-weight: 600; wrap: word-wrap; }
                                            Text {
                                                text: "Servidor ligero solo para texto en el puerto 8082. No codifica ni transmite video, así que casi no consume recursos.";
                                                color: Theme.text-muted;
                                                font-size: 11.5px;
                                                wrap: word-wrap;
                                            }
                                            HorizontalLayout {
                                                alignment: start;
                                                GlassButton {
                                                    label: root.chat-running ? "Detener Chat LAN" : "Iniciar Chat LAN (Puerto 8082)";
                                                    icon: @image-url("icons/chat.svg");
                                                    has-icon: true;
                                                    primary: !root.chat-running;
                                                    danger: root.chat-running;
                                                    clicked => { root.toggle-chat-server(); }
                                                }
                                            }
                                        }

                                        if root.has-chat-qr : Rectangle {
                                            width: 136px;
                                            height: 136px;
                                            border-radius: 10px;
                                            background: #fafafa;
                                            Image {
                                                source: root.chat-qr-image;
                                                width: 126px;
                                                height: 126px;
                                                x: 5px;
                                                y: 5px;
                                                image-fit: contain;
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 9px;
                                        Text { text: "Mensajes del Equipo"; color: Theme.text-secondary; font-size: 12px; font-weight: 700; }
                                        Rectangle {
                                            min-height: 150px;
                                            border-radius: Theme.radius-sm;
                                            background: Theme.bg-input;
                                            border-width: 1px;
                                            border-color: Theme.border-subtle;
                                            VerticalLayout {
                                                padding: 10px;
                                                Text {
                                                    text: root.chat-log;
                                                    color: Theme.text-primary;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                horizontal-stretch: 1;
                                                placeholder-text: "Escribe un mensaje para el equipo...";
                                                text <=> root.chat-input;
                                                accepted(txt) => {
                                                    if (txt != "") {
                                                        root.send-chat-message(txt);
                                                        root.chat-input = "";
                                                    }
                                                }
                                            }
                                            GlassButton {
                                                label: "Enviar";
                                                icon: @image-url("icons/chat.svg");
                                                has-icon: true;
                                                primary: true;
                                                clicked => {
                                                    if (root.chat-input != "") {
                                                        root.send-chat-message(root.chat-input);
                                                        root.chat-input = "";
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Subtab 2: Conectar Celular (ProyecThor Mobile + Control Remoto Web — Puerto 8090)
                        if root.net-subtab == 2 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 12px;
                                padding-right: 8px;

                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: root.mobile-running ? Theme.live-green.transparentize(0.4) : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 16px;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 10px;
                                            Text { text: "Conectar Celular (ProyecThor Mobile & Control Remoto)"; color: Theme.text-primary; font-size: 14px; font-weight: 700; }
                                            Text { text: root.mobile-url; color: root.mobile-running ? Theme.live-green : Theme.text-secondary; font-size: 13px; font-weight: 600; wrap: word-wrap; }
                                            HorizontalLayout {
                                                spacing: 10px;
                                                Rectangle {
                                                    height: 32px;
                                                    border-radius: Theme.radius-md;
                                                    background: Theme.bg-surface-2;
                                                    border-width: 1px;
                                                    border-color: Theme.border-medium;
                                                    HorizontalLayout {
                                                        padding-left: 14px;
                                                        padding-right: 14px;
                                                        Text {
                                                            text: "PIN: " + root.mobile-pin;
                                                            color: Theme.text-primary;
                                                            font-size: 14px;
                                                            font-weight: 800;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                GlassButton {
                                                    label: "Regenerar PIN";
                                                    icon: @image-url("icons/refresh.svg");
                                                    has-icon: true;
                                                    clicked => { root.regenerate-mobile-pin(); }
                                                }
                                            }
                                            Text {
                                                text: "Escanea el QR desde tu celular para abrir el Control Remoto en el navegador o emparejar la app ProyecThor Mobile (UDP 47990 + HTTP 8090).";
                                                color: Theme.text-muted;
                                                font-size: 11.5px;
                                                wrap: word-wrap;
                                            }
                                            HorizontalLayout {
                                                alignment: start;
                                                GlassButton {
                                                    label: root.mobile-running ? "Detener Servidor Móvil" : "Iniciar Servidor Móvil (Puerto 8090)";
                                                    icon: @image-url("icons/smartphone.svg");
                                                    has-icon: true;
                                                    primary: !root.mobile-running;
                                                    danger: root.mobile-running;
                                                    clicked => { root.toggle-mobile-server(); }
                                                }
                                            }
                                        }

                                        if root.has-mobile-qr : Rectangle {
                                            width: 156px;
                                            height: 156px;
                                            border-radius: 10px;
                                            background: #fafafa;
                                            Image {
                                                source: root.mobile-qr-image;
                                                width: 146px;
                                                height: 146px;
                                                x: 5px;
                                                y: 5px;
                                                image-fit: contain;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Subtab 3: Reloj y Temporizador
                        if root.net-subtab == 3 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 12px;
                                padding-right: 8px;

                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 98px;
                                        border-radius: Theme.radius-md;
                                        background: Theme.bg-surface-1;
                                        border-width: 1px;
                                        border-color: Theme.border-subtle;
                                        VerticalLayout {
                                            padding: 12px;
                                            alignment: center;
                                            Text { text: "HORA ACTUAL"; color: Theme.text-muted; font-size: 10.5px; font-weight: 700; horizontal-alignment: center; }
                                            Text { text: root.clock-now-text; color: Theme.text-primary; font-size: 32px; font-weight: 800; horizontal-alignment: center; }
                                        }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 98px;
                                        border-radius: Theme.radius-md;
                                        background: Theme.bg-surface-1;
                                        border-width: 1px;
                                        border-color: root.timer-running ? Theme.stage-amber : Theme.border-subtle;
                                        VerticalLayout {
                                            padding: 12px;
                                            alignment: center;
                                            Text { text: "CUENTA REGRESIVA"; color: Theme.stage-amber; font-size: 10.5px; font-weight: 700; horizontal-alignment: center; }
                                            Text { text: root.timer-display-text; color: Theme.text-primary; font-size: 32px; font-weight: 800; horizontal-alignment: center; }
                                        }
                                    }
                                }

                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            GlassButton { label: "1m";  compact: true; horizontal-stretch: 1; clicked => { root.timer-set-minutes(1); } }
                                            GlassButton { label: "3m";  compact: true; horizontal-stretch: 1; clicked => { root.timer-set-minutes(3); } }
                                            GlassButton { label: "5m";  compact: true; horizontal-stretch: 1; clicked => { root.timer-set-minutes(5); } }
                                            GlassButton { label: "10m"; compact: true; horizontal-stretch: 1; clicked => { root.timer-set-minutes(10); } }
                                            GlassButton { label: "15m"; compact: true; horizontal-stretch: 1; clicked => { root.timer-set-minutes(15); } }
                                            GlassButton {
                                                label: root.timer-running ? "Pausar" : "Iniciar";
                                                icon: root.timer-running ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                                                has-icon: true;
                                                primary: true;
                                                clicked => { root.timer-toggle(); }
                                            }
                                            IconButton { icon: @image-url("icons/refresh.svg"); clicked => { root.timer-reset(); } }
                                        }
                                        SwitchRow {
                                            title: "Proyectar Reloj / Cuenta Regresiva en Salida Público";
                                            checked <=> root.show-clock-on-public;
                                            toggled(v) => { root.clock-overlay-toggled(v); }
                                        }
                                        SwitchRow {
                                            title: "Mostrar Cuenta Regresiva (desactivado = Hora Actual)";
                                            checked <=> root.timer-mode-countdown;
                                            toggled(v) => { root.clock-overlay-toggled(root.show-clock-on-public); }
                                        }
                                    }
                                }
                            }
                        }

                        // Subtab 4: Luces OSC (Yggdrasil)
                        if root.net-subtab == 4 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 12px;
                                padding-right: 8px;

                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 11px;
                                        Text { text: "Yggdrasil — Control de Luces y Consolas por OSC (UDP)"; color: Theme.text-primary; font-size: 14px; font-weight: 700; }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit { horizontal-stretch: 2; placeholder-text: "IP Destino (ej. 127.0.0.1)"; text <=> root.osc-host; }
                                            LineEdit { horizontal-stretch: 1; placeholder-text: "Puerto (9000)"; text <=> root.osc-port; }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit { horizontal-stretch: 2; placeholder-text: "Dirección OSC (ej. /cue/1)"; text <=> root.osc-address; }
                                            LineEdit { horizontal-stretch: 1; placeholder-text: "Args (ej. 1, 0.5)"; text <=> root.osc-args; }
                                            GlassButton {
                                                label: "Enviar OSC";
                                                icon: @image-url("icons/zap.svg");
                                                has-icon: true;
                                                primary: true;
                                                clicked => { root.send-osc(root.osc-host, root.osc-port, root.osc-address, root.osc-args); }
                                            }
                                        }

                                        Text { text: "Disparos Rápidos"; color: Theme.text-secondary; font-size: 12px; font-weight: 600; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            GlassButton { label: "Cue 1 (/cue/1)"; compact: true; horizontal-stretch: 1; clicked => { root.send-osc(root.osc-host, root.osc-port, "/cue/1", "1"); } }
                                            GlassButton { label: "Cue 2 (/cue/2)"; compact: true; horizontal-stretch: 1; clicked => { root.send-osc(root.osc-host, root.osc-port, "/cue/2", "1"); } }
                                            GlassButton { label: "Cue 3 (/cue/3)"; compact: true; horizontal-stretch: 1; clicked => { root.send-osc(root.osc-host, root.osc-port, "/cue/3", "1"); } }
                                            GlassButton { label: "Blackout";       compact: true; horizontal-stretch: 1; danger: true; clicked => { root.send-osc(root.osc-host, root.osc-port, "/blackout", "1"); } }
                                        }

                                        Text { text: root.osc-status; color: Theme.text-secondary; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }

                    // ── Mode 6: Pads de Escena Rápida (8 Pads) ──
                    if root.active-tab == 6 : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 10px;
                            padding-right: 8px;

                            // 2 rows x 4 pads
                            HorizontalLayout {
                                spacing: 10px;
                                for idx in [0, 1, 2, 3] : PadTile {
                                    horizontal-stretch: 1;
                                    name: root.pads[idx].name;
                                    summary: root.pads[idx].summary;
                                    assigned: root.pads[idx].assigned;
                                    trigger => { root.pad-triggered(idx); }
                                    save-here => { root.pad-saved(idx); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                for idx in [4, 5, 6, 7] : PadTile {
                                    horizontal-stretch: 1;
                                    name: root.pads[idx].name;
                                    summary: root.pads[idx].summary;
                                    assigned: root.pads[idx].assigned;
                                    trigger => { root.pad-triggered(idx); }
                                    save-here => { root.pad-saved(idx); }
                                }
                            }
                        }
                    }

                    // ── Mode 7: Ajustes Estilo Apple (Pantalla Completa, Secciones, Animaciones y Preview de 14 Temas) ──
                    if root.active-tab == 7 : AppleSettingsView {
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        app-version: root.app-version;
                        logo-image: root.logo-image;
                        has-logo: root.has-logo;

                        active-theme-idx <=> root.active-theme-idx;
                        bg-scale-mode <=> root.bg-scale-mode;
                        output-res-preset <=> root.output-res-preset;
                        target-fps <=> root.target-fps;
                        gpu-hwdec-mode <=> root.gpu-hwdec-mode;
                        nvenc-enabled <=> root.nvenc-enabled;
                        gpu-status-label: root.gpu-status-label;
                        upscaler-mode <=> root.upscaler-mode;
                        upscaler-sharpness <=> root.upscaler-sharpness;
                        smooth-motion-60 <=> root.smooth-motion-60;
                        performance-mode <=> root.performance-mode;
                        fullscreen-output <=> root.fullscreen-output;
                        enable-glass-translucency <=> root.enable-glass-translucency;
                        enable-glass-sheen <=> root.enable-glass-sheen;
                        enable-ambient-bg <=> root.enable-ambient-bg;
                        show-tutorial-on-start <=> root.show-tutorial-on-start;

                        music-scan-folders: root.music-scan-folders;
                        music-folder-input <=> root.music-folder-input;

                        debug-fps-text: root.debug-fps-text;
                        debug-video-fps-text: root.debug-video-fps-text;
                        debug-cpu-text: root.debug-cpu-text;
                        debug-ram-text: root.debug-ram-text;
                        debug-peak-ram-text: root.debug-peak-ram-text;
                        debug-paths: root.debug-paths;
                        update-status: root.update-status;

                        theme-selected(idx) => { root.theme-selected(idx); }
                        scale-mode-changed(m) => { root.scale-mode-changed(m); }
                        output-res-changed(p) => { root.output-res-changed(p); }
                        target-fps-changed(f) => { root.target-fps-changed(f); }
                        gpu-config-changed => { root.gpu-config-changed(); }
                        apply-low-spec-preset => { root.apply-low-spec-preset(); }
                        purge-ram-cache => { root.purge-ram-cache(); }
                        performance-mode-changed(v) => { root.performance-mode-changed(v); }
                        fullscreen-changed(v) => { root.fullscreen-changed(v); }
                        visual-effects-changed => { root.visual-effects-changed(); }
                        tutorial-preference-changed(v) => { root.tutorial-preference-changed(v); }
                        browse-music-folder => { root.browse-music-folder(); }
                        add-music-folder(p) => { root.add-music-folder(p); }
                        remove-music-folder(i) => { root.remove-music-folder(i); }
                        scan-libraries => { root.scan-libraries(); }
                        import-file-clicked => { root.import-file-clicked(); }
                        import-background-clicked => { root.import-background-clicked(); }
                        import-overlay-clicked => { root.import-overlay-clicked(); }
                        check-github-updates => { root.check-github-updates(); }
                        open-legacy-imgui => { root.open-legacy-imgui(); }
                        open-kofi-donations => { root.open-kofi-donations(); }
                        navigate-to-tab(t) => { root.active-tab = t; }
                    }

                    // ── Mode 8: Capturadora de Video y Cámaras (USB / HDMI / V4L2) ──
                    if root.active-tab == 8 : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 12px;
                            padding-right: 8px;

                            // Card: Capturadora / Cámaras USB & HDMI
                            Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.bg-surface-1;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                VerticalLayout {
                                    padding: 15px;
                                    spacing: 10px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Image {
                                                source: @image-url("icons/camera.svg");
                                                width: 16px;
                                                height: 16px;
                                                y: (parent.height - self.height) / 2;
                                                colorize: Theme.accent-strong;
                                            }
                                            Text {
                                                text: "Capturadoras y Cámaras Detectadas (USB / HDMI / V4L2)";
                                                color: Theme.text-primary;
                                                font-size: 13.5px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            GlassButton {
                                                label: "Refrescar";
                                                icon: @image-url("icons/refresh.svg");
                                                has-icon: true;
                                                clicked => { root.refresh-capture-devices(); }
                                            }
                                            GlassButton {
                                                label: "Detener";
                                                icon: @image-url("icons/stop.svg");
                                                has-icon: true;
                                                danger: true;
                                                clicked => { root.stop-capture-or-url(); }
                                            }
                                        }
                                    }

                                    if root.capture-devices.length == 0 : Text {
                                        text: "No se detectaron cámaras o capturadoras USB conectadas. Conecta tu capturadora HDMI/USB y pulsa 'Refrescar Cámaras'.";
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }

                                    for dev[didx] in root.capture-devices : Rectangle {
                                        height: 46px;
                                        border-radius: Theme.radius-sm;
                                        background: didx == root.selected-capture-idx
                                            ? Theme.bg-surface-hover
                                            : (dev-ta.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-0);
                                        border-width: 1px;
                                        border-color: didx == root.selected-capture-idx
                                            ? Theme.live-green
                                            : Theme.border-subtle;

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            alignment: space-between;
                                            VerticalLayout {
                                                alignment: center;
                                                Text { text: dev.name; color: Theme.text-primary; font-size: 13px; font-weight: 600; }
                                                Text { text: dev.uri;  color: Theme.text-muted;   font-size: 10.5px; }
                                            }
                                            Text {
                                                text: didx == root.selected-capture-idx ? "● EN VIVO" : "Clic para proyectar";
                                                color: didx == root.selected-capture-idx ? Theme.live-green : Theme.text-secondary;
                                                font-size: 11.5px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }

                                        dev-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.selected-capture-idx = didx;
                                                root.start-capture-device(didx);
                                            }
                                        }
                                    }

                                    Text {
                                        text: root.capture-status;
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }

                    // ── Mode 9: Música (Grid de Audio — el reproductor vive en la Isla Flotante central) ──
                    if root.active-tab == 9 : VerticalLayout {
                        spacing: 8px;
                        vertical-stretch: 1;

                        HorizontalLayout {
                            alignment: end;
                            GlassButton {
                                label: "Importar Audio";
                                icon: @image-url("icons/upload.svg");
                                has-icon: true;
                                compact: true;
                                primary: true;
                                clicked => { root.import-music-clicked(); }
                            }
                        }

                        // Music Album Cover Art Grid (4 columns, full height!)
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: 8px;
                                padding-right: 6px;

                                if root.music-tracks.length == 0 : Rectangle {
                                    height: 130px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    Text {
                                        text: "Sin archivos de audio en assets/audio/ ni carpetas configuradas.\nPulsa 'Importar Audio' o agrega tus carpetas de música en Ajustes → Carpetas de Escaneo de Música.";
                                        color: Theme.text-muted;
                                        font-size: 12.5px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }

                                for mrow in root.music-grid-rows : HorizontalLayout {
                                    spacing: 8px;
                                    height: 164px;
                                    for cell in mrow.cells : Rectangle {
                                        horizontal-stretch: 1;
                                        height: 100%;
                                        if cell.valid : Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            border-radius: Theme.radius-sm;
                                            background: cell.playing ? Theme.live-green-soft : (mg-ta.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-1);
                                            border-width: cell.playing ? 1.5px : 1px;
                                            border-color: cell.playing ? Theme.live-green : (mg-ta.has-hover ? Theme.border-accent : Theme.border-subtle);
                                            clip: true;
                                            animate background { duration: 110ms; }
                                            animate border-color { duration: 110ms; }

                                            mg-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.music-track-clicked(cell.index); }
                                                pointer-event(ev) => {
                                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                        root.open-item-modal(0, 3, cell.title, cell.subtitle, cell.path);
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                padding: 7px;
                                                spacing: 6px;

                                                // Cover Art Square
                                                Rectangle {
                                                    vertical-stretch: 1;
                                                    border-radius: 3px;
                                                    background: Theme.bg-surface-0;
                                                    border-width: 1px;
                                                    border-color: Theme.border-subtle;
                                                    clip: true;

                                                    if cell.has-cover : Image {
                                                        x: 0px;
                                                        y: 0px;
                                                        width: 100%;
                                                        height: 100%;
                                                        source: cell.cover;
                                                        image-fit: cover;
                                                    }
                                                    if !cell.has-cover : Text {
                                                        text: cell.playing ? "▶" : "♫";
                                                        color: cell.playing ? Theme.live-green : Theme.text-muted;
                                                        font-size: 28px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    if cell.playing : Rectangle {
                                                        x: 5px;
                                                        y: 5px;
                                                        width: 22px;
                                                        height: 18px;
                                                        border-radius: 3px;
                                                        background: #09090be0;
                                                        Text { text: "▶"; color: Theme.live-green; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                                    }

                                                    // Floating studio action strip (Queue / Options / Delete)
                                                    Rectangle {
                                                        x: parent.width - self.width - 4px;
                                                        y: 4px;
                                                        width: 76px;
                                                        height: 26px;
                                                        border-radius: 7px;
                                                        background: #09090bcc;
                                                        border-width: 1px;
                                                        border-color: #ffffff1a;
                                                        HorizontalLayout {
                                                            padding: 1px;
                                                            spacing: 1px;
                                                            alignment: center;
                                                            ItemRowActionBtn {
                                                                icon: @image-url("icons/list.svg");
                                                                y: (parent.height - self.height) / 2;
                                                                clicked => { root.item-action-queue(3, cell.path); }
                                                            }
                                                            ItemMoreBtn {
                                                                y: (parent.height - self.height) / 2;
                                                                clicked => { root.open-item-modal(0, 3, cell.title, cell.subtitle, cell.path); }
                                                            }
                                                            ItemRowActionBtn {
                                                                icon: @image-url("icons/trash.svg");
                                                                danger: true;
                                                                y: (parent.height - self.height) / 2;
                                                                clicked => { root.open-item-modal(2, 3, cell.title, cell.subtitle, cell.path); }
                                                            }
                                                        }
                                                    }
                                                }

                                                Text {
                                                    text: cell.title;
                                                    color: cell.playing ? Theme.live-green : Theme.text-primary;
                                                    font-size: 11.5px;
                                                    font-weight: 700;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: cell.subtitle;
                                                    color: Theme.text-muted;
                                                    font-size: 9.5px;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── Mode 13: BIBLIOTECA PRINCIPAL (Hub Dinámico y Limpio) ──
                    if root.active-tab == 13 : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            spacing: 12px;
                            padding-right: 8px;

                            // Quick Studio Action Strip
                            HorizontalLayout {
                                alignment: space-between;
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 1px;
                                    Text { text: "Biblioteca"; color: Theme.text-primary; font-size: 15px; font-weight: 700; }
                                    Text { text: "Acceso directo a todo tu contenido en vivo"; color: Theme.text-muted; font-size: 11px; }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    GlassButton {
                                        label: "Nueva Canción";
                                        icon: @image-url("icons/plus.svg");
                                        has-icon: true;
                                        compact: true;
                                        primary: true;
                                        clicked => { root.active-tab = 0; root.new-song-clicked(); }
                                    }
                                    GlassButton {
                                        label: "Importar";
                                        icon: @image-url("icons/upload.svg");
                                        has-icon: true;
                                        compact: true;
                                        clicked => { root.import-file-clicked(); }
                                    }
                                    GlassButton {
                                        label: "Escanear";
                                        icon: @image-url("icons/refresh.svg");
                                        has-icon: true;
                                        compact: true;
                                        clicked => { root.scan-libraries(); }
                                    }
                                }
                            }

                            // 5 Quick Category Cards with SVG icons & smooth transitions
                            HorizontalLayout {
                                spacing: 8px;
                                height: 86px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: Theme.radius-md;
                                    background: hc0.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: hc0.has-hover ? #38bdf8 : Theme.border-subtle;
                                    clip: true;
                                    animate background   { duration: 150ms; easing: ease-out; }
                                    animate border-color { duration: 150ms; easing: ease-out; }
                                    Rectangle { y: 0; width: 100%; height: hc0.has-hover ? 3px : 2px; background: #38bdf8; animate height { duration: 140ms; } }
                                    VerticalLayout {
                                        padding: 11px;
                                        alignment: center;
                                        spacing: 5px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Image { source: @image-url("icons/music.svg"); width: 15px; height: 15px; y: (parent.height - self.height) / 2; colorize: #38bdf8; }
                                            Text { text: "Canciones"; color: Theme.text-primary; font-size: 12.5px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        Text { text: root.hub-songs-count + " elementos"; color: Theme.text-muted; font-size: 11px; }
                                    }
                                    hc0 := TouchArea { mouse-cursor: pointer; clicked => { root.active-tab = 0; } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: Theme.radius-md;
                                    background: hc1.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: hc1.has-hover ? #fbbf24 : Theme.border-subtle;
                                    clip: true;
                                    animate background   { duration: 150ms; easing: ease-out; }
                                    animate border-color { duration: 150ms; easing: ease-out; }
                                    Rectangle { y: 0; width: 100%; height: hc1.has-hover ? 3px : 2px; background: #fbbf24; animate height { duration: 140ms; } }
                                    VerticalLayout {
                                        padding: 11px;
                                        alignment: center;
                                        spacing: 5px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Image { source: @image-url("icons/book.svg"); width: 15px; height: 15px; y: (parent.height - self.height) / 2; colorize: #fbbf24; }
                                            Text { text: "Biblia"; color: Theme.text-primary; font-size: 12.5px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        Text { text: root.hub-bibles-count + " versiones"; color: Theme.text-muted; font-size: 11px; }
                                    }
                                    hc1 := TouchArea { mouse-cursor: pointer; clicked => { root.active-tab = 1; } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: Theme.radius-md;
                                    background: hc2.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: hc2.has-hover ? #ec4899 : Theme.border-subtle;
                                    clip: true;
                                    animate background   { duration: 150ms; easing: ease-out; }
                                    animate border-color { duration: 150ms; easing: ease-out; }
                                    Rectangle { y: 0; width: 100%; height: hc2.has-hover ? 3px : 2px; background: #ec4899; animate height { duration: 140ms; } }
                                    VerticalLayout {
                                        padding: 11px;
                                        alignment: center;
                                        spacing: 5px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Image { source: @image-url("icons/film.svg"); width: 15px; height: 15px; y: (parent.height - self.height) / 2; colorize: #ec4899; }
                                            Text { text: "Multimedia"; color: Theme.text-primary; font-size: 12.5px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        Text { text: root.hub-media-count + " videos/img"; color: Theme.text-muted; font-size: 11px; }
                                    }
                                    hc2 := TouchArea { mouse-cursor: pointer; clicked => { root.active-tab = 2; } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: Theme.radius-md;
                                    background: hc3.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: hc3.has-hover ? #22c55e : Theme.border-subtle;
                                    clip: true;
                                    animate background   { duration: 150ms; easing: ease-out; }
                                    animate border-color { duration: 150ms; easing: ease-out; }
                                    Rectangle { y: 0; width: 100%; height: hc3.has-hover ? 3px : 2px; background: #22c55e; animate height { duration: 140ms; } }
                                    VerticalLayout {
                                        padding: 11px;
                                        alignment: center;
                                        spacing: 5px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Image { source: @image-url("icons/headphones.svg"); width: 15px; height: 15px; y: (parent.height - self.height) / 2; colorize: #22c55e; }
                                            Text { text: "Música"; color: Theme.text-primary; font-size: 12.5px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        Text { text: root.hub-music-count + " pistas"; color: Theme.text-muted; font-size: 11px; }
                                    }
                                    hc3 := TouchArea { mouse-cursor: pointer; clicked => { root.active-tab = 9; } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: Theme.radius-md;
                                    background: hc4.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: hc4.has-hover ? #a78bfa : Theme.border-subtle;
                                    clip: true;
                                    animate background   { duration: 150ms; easing: ease-out; }
                                    animate border-color { duration: 150ms; easing: ease-out; }
                                    Rectangle { y: 0; width: 100%; height: hc4.has-hover ? 3px : 2px; background: #a78bfa; animate height { duration: 140ms; } }
                                    VerticalLayout {
                                        padding: 11px;
                                        alignment: center;
                                        spacing: 5px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Image { source: @image-url("icons/file_text.svg"); width: 15px; height: 15px; y: (parent.height - self.height) / 2; colorize: #a78bfa; }
                                            Text { text: "Documentos"; color: Theme.text-primary; font-size: 12.5px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        Text { text: root.hub-docs-count + " archivos"; color: Theme.text-muted; font-size: 11px; }
                                    }
                                    hc4 := TouchArea { mouse-cursor: pointer; clicked => { root.active-tab = 10; } }
                                }
                            }

                            // Unified Section 1: Canciones / Letras
                            Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.bg-surface-1;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 7px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Canciones y Letras"; color: Theme.text-primary; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                        GlassButton { label: "Abrir Canciones ›"; compact: true; clicked => { root.active-tab = 0; } }
                                    }
                                    if root.hub-recent-songs.length == 0 : Text { text: "Sin canciones todavía."; color: Theme.text-muted; font-size: 11.5px; }
                                    for s in root.hub-recent-songs : Rectangle {
                                        height: 36px;
                                        border-radius: Theme.radius-sm;
                                        background: hs-ta.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-0;
                                        border-width: 1px;
                                        border-color: hs-ta.has-hover ? Theme.border-medium : Theme.border-subtle;
                                        animate background   { duration: 130ms; easing: ease-out; }
                                        animate border-color { duration: 130ms; easing: ease-out; }
                                        hs-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.hub-open-song(s.path); }
                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                    root.open-item-modal(0, 0, s.title, s.subtitle, s.path);
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 6px;
                                            spacing: 6px;
                                            Text { text: s.title; color: Theme.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                            Text { text: s.subtitle; color: Theme.text-muted; font-size: 10.5px; vertical-alignment: center; }
                                            ItemMoreBtn {
                                                y: (parent.height - self.height) / 2;
                                                clicked => { root.open-item-modal(0, 0, s.title, s.subtitle, s.path); }
                                            }
                                            ItemRowActionBtn {
                                                icon: @image-url("icons/trash.svg");
                                                danger: true;
                                                y: (parent.height - self.height) / 2;
                                                clicked => { root.open-item-modal(2, 0, s.title, s.subtitle, s.path); }
                                            }
                                        }
                                    }
                                }
                            }

                            // Unified Section 2: Música (Audio)
                            Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.bg-surface-1;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 7px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Música y Pistas de Audio"; color: Theme.text-primary; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                        GlassButton { label: "Abrir Música ›"; compact: true; clicked => { root.active-tab = 9; } }
                                    }
                                    if root.hub-recent-music.length == 0 : Text { text: "Sin pistas de audio. Puedes agregar carpetas de música en Ajustes."; color: Theme.text-muted; font-size: 11.5px; }
                                    for mt[midx] in root.hub-recent-music : Rectangle {
                                        height: 40px;
                                        border-radius: Theme.radius-sm;
                                        background: hm-ta.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-0;
                                        border-width: 1px;
                                        border-color: hm-ta.has-hover ? Theme.border-medium : Theme.border-subtle;
                                        animate background   { duration: 130ms; easing: ease-out; }
                                        animate border-color { duration: 130ms; easing: ease-out; }
                                        hm-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.hub-play-music(midx); }
                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                    root.open-item-modal(0, 3, mt.title, mt.subtitle, mt.path);
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 7px;
                                            Rectangle {
                                                width: 30px; height: 30px; y: (parent.height - self.height) / 2;
                                                border-radius: 3px; background: Theme.bg-surface-1; clip: true;
                                                if mt.has-cover : Image { x: 0; y: 0; width: 100%; height: 100%; source: mt.cover; image-fit: cover; }
                                                if !mt.has-cover : Text { text: "♫"; color: Theme.text-muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                            Text { text: mt.title; color: Theme.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                            Text { text: mt.subtitle; color: Theme.text-muted; font-size: 10px; vertical-alignment: center; }
                                            ItemMoreBtn {
                                                y: (parent.height - self.height) / 2;
                                                clicked => { root.open-item-modal(0, 3, mt.title, mt.subtitle, mt.path); }
                                            }
                                            ItemRowActionBtn {
                                                icon: @image-url("icons/trash.svg");
                                                danger: true;
                                                y: (parent.height - self.height) / 2;
                                                clicked => { root.open-item-modal(2, 3, mt.title, mt.subtitle, mt.path); }
                                            }
                                        }
                                    }
                                }
                            }

                            // Unified Section 3: Multimedia & Documentos (2 columns)
                            HorizontalLayout {
                                spacing: 10px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 7px;
                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text { text: "Multimedia"; color: Theme.text-primary; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                            GlassButton { label: "Abrir ›"; compact: true; clicked => { root.active-tab = 2; } }
                                        }
                                        if root.hub-recent-media.length == 0 : Text { text: "Sin videos ni imágenes."; color: Theme.text-muted; font-size: 11px; }
                                        for md in root.hub-recent-media : Rectangle {
                                            height: 36px;
                                            border-radius: Theme.radius-sm;
                                            background: hmd-ta.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-0;
                                            border-width: 1px;
                                            border-color: hmd-ta.has-hover ? Theme.border-medium : Theme.border-subtle;
                                            animate background   { duration: 130ms; easing: ease-out; }
                                            animate border-color { duration: 130ms; easing: ease-out; }
                                            hmd-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.hub-open-media(md.path); }
                                                pointer-event(ev) => {
                                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                        root.open-item-modal(0, 1, md.title, md.subtitle, md.path);
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                padding-left: 10px; padding-right: 6px; spacing: 5px;
                                                Text { text: md.title; color: Theme.text-primary; font-size: 11.5px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                                Text { text: md.subtitle; color: Theme.text-muted; font-size: 10px; vertical-alignment: center; }
                                                ItemMoreBtn {
                                                    y: (parent.height - self.height) / 2;
                                                    clicked => { root.open-item-modal(0, 1, md.title, md.subtitle, md.path); }
                                                }
                                                ItemRowActionBtn {
                                                    icon: @image-url("icons/trash.svg");
                                                    danger: true;
                                                    y: (parent.height - self.height) / 2;
                                                    clicked => { root.open-item-modal(2, 1, md.title, md.subtitle, md.path); }
                                                }
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 7px;
                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text { text: "Documentos"; color: Theme.text-primary; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                            GlassButton { label: "Abrir ›"; compact: true; clicked => { root.active-tab = 10; } }
                                        }
                                        if root.hub-recent-docs.length == 0 : Text { text: "Sin documentos PDF."; color: Theme.text-muted; font-size: 11px; }
                                        for dc in root.hub-recent-docs : Rectangle {
                                            height: 36px;
                                            border-radius: Theme.radius-sm;
                                            background: hdc-ta.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-0;
                                            border-width: 1px;
                                            border-color: hdc-ta.has-hover ? Theme.border-medium : Theme.border-subtle;
                                            animate background   { duration: 130ms; easing: ease-out; }
                                            animate border-color { duration: 130ms; easing: ease-out; }
                                            hdc-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.hub-open-doc(dc.path); }
                                                pointer-event(ev) => {
                                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                        root.open-item-modal(0, 2, dc.title, dc.subtitle, dc.path);
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                padding-left: 10px; padding-right: 6px; spacing: 5px;
                                                Text { text: dc.title; color: Theme.text-primary; font-size: 11.5px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                                Text { text: dc.subtitle; color: Theme.text-muted; font-size: 10px; vertical-alignment: center; }
                                                ItemMoreBtn {
                                                    y: (parent.height - self.height) / 2;
                                                    clicked => { root.open-item-modal(0, 2, dc.title, dc.subtitle, dc.path); }
                                                }
                                                ItemRowActionBtn {
                                                    icon: @image-url("icons/trash.svg");
                                                    danger: true;
                                                    y: (parent.height - self.height) / 2;
                                                    clicked => { root.open-item-modal(2, 2, dc.title, dc.subtitle, dc.path); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── Mode 10: Documentos (PDF / Presentaciones en Páginas) ──
                    if root.active-tab == 10 : VerticalLayout {
                        spacing: 8px;
                        vertical-stretch: 1;

                        HorizontalLayout {
                            alignment: space-between;
                            spacing: 6px;
                            Text { text: root.doc-title; color: Theme.text-primary; font-size: 13.5px; font-weight: 700; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            HorizontalLayout {
                                spacing: 5px;
                                if root.selected-library-index >= 0 && root.selected-library-path != "" : GlassButton {
                                    label: "A Cola";
                                    icon: @image-url("icons/list.svg");
                                    has-icon: true;
                                    compact: true;
                                    clicked => { root.item-action-queue(2, root.selected-library-path); }
                                }
                                if root.selected-library-index >= 0 && root.selected-library-path != "" : GlassButton {
                                    label: "Renombrar";
                                    icon: @image-url("icons/edit.svg");
                                    has-icon: true;
                                    compact: true;
                                    clicked => { root.open-item-modal(1, 2, root.doc-title, "Documento", root.selected-library-path); }
                                }
                                if root.selected-library-index >= 0 && root.selected-library-path != "" : IconButton {
                                    icon: @image-url("icons/trash.svg");
                                    danger: true;
                                    clicked => { root.open-item-modal(2, 2, root.doc-title, "Documento", root.selected-library-path); }
                                }
                                IconButton { icon: @image-url("icons/prev.svg"); clicked => { root.doc-prev-page(); } }
                                IconButton { icon: @image-url("icons/next.svg"); clicked => { root.doc-next-page(); } }
                                GlassButton {
                                    label: "Importar PDF";
                                    icon: @image-url("icons/upload.svg");
                                    has-icon: true;
                                    compact: true;
                                    primary: true;
                                    clicked => { root.import-document-clicked(); }
                                }
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 10px;
                                padding-right: 6px;

                                if root.doc-pages.length == 0 : Rectangle {
                                    height: 200px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    Text {
                                        text: "Selecciona un documento PDF o imagen a la izquierda.\nCada página aparecerá aquí lista para proyectar con un clic.";
                                        color: Theme.text-muted;
                                        font-size: 12.5px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }

                                for pg[pidx] in root.doc-pages : Rectangle {
                                    height: 196px;
                                    border-radius: Theme.radius-md;
                                    background: pidx == root.active-doc-page-idx ? Theme.bg-surface-hover : Theme.bg-surface-1;
                                    border-width: pidx == root.active-doc-page-idx ? 2px : 1px;
                                    border-color: pidx == root.active-doc-page-idx ? Theme.live-green : (dp-ta.has-hover ? Theme.border-medium : Theme.border-subtle);
                                    clip: true;

                                    if pg.has-preview : Image {
                                        source: pg.preview;
                                        image-fit: contain;
                                    }

                                    Rectangle {
                                        x: 8px;
                                        y: 8px;
                                        height: 22px;
                                        width: pg-lbl.preferred-width + 16px;
                                        border-radius: 5px;
                                        background: pidx == root.active-doc-page-idx ? Theme.live-green : #08080ad8;
                                        pg-lbl := Text {
                                            x: 8px;
                                            height: parent.height;
                                            text: pidx == root.active-doc-page-idx ? ("● EN VIVO — Página " + pg.number) : ("Página " + pg.number);
                                            color: pidx == root.active-doc-page-idx ? #04130b : #ffffff;
                                            font-size: 10.5px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    dp-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.active-doc-page-idx = pidx;
                                            root.doc-page-clicked(pidx);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── Mode 11: Ayuda, Atajos y Novedades (Changelog) ──
                    if root.active-tab == 11 : VerticalLayout {
                        spacing: 10px;
                        vertical-stretch: 1;

                        HorizontalLayout {
                            spacing: 6px;
                            GlassButton { label: "Guía Rápida"; primary: root.help-subtab == 0; clicked => { root.help-subtab = 0; } }
                            GlassButton { label: "Novedades / Changelog"; primary: root.help-subtab == 1; clicked => { root.help-subtab = 1; } }
                        }

                        if root.help-subtab == 0 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 10px;
                                padding-right: 8px;

                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    VerticalLayout {
                                        padding: 15px;
                                        spacing: 10px;
                                        Text { text: "Soporte Oficial y Comunidad"; color: Theme.accent-strong; font-size: 14px; font-weight: 700; }
                                        Text {
                                            text: "¿Tienes alguna duda o necesitas ayuda? Toca cualquiera de estos botones para abrir nuestra página oficial o hablar con la comunidad:";
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }

                                        SupportLinkCard {
                                            title: "Sitio Web Oficial";
                                            subtitle: "Descargas, novedades y guía completa";
                                            icon: @image-url("icons/globe.svg");
                                            accent: #3b82f6;
                                            clicked => { root.open-website(); }
                                        }
                                        SupportLinkCard {
                                            title: "Discord — Soporte y Ayuda";
                                            subtitle: "Resuelve dudas en vivo con nosotros y otros usuarios";
                                            icon: @image-url("icons/discord.svg");
                                            accent: #5865f2;
                                            clicked => { root.open-discord(); }
                                        }
                                        SupportLinkCard {
                                            title: "Instagram — @theproyecthor";
                                            subtitle: "Novedades, capturas y tutoriales rápidos";
                                            icon: @image-url("icons/instagram.svg");
                                            accent: #e1306c;
                                            clicked => { root.open-instagram(); }
                                        }
                                        SupportLinkCard {
                                            title: "WhatsApp — Canal Oficial";
                                            subtitle: "Avisos de nuevas versiones directo a tu celular";
                                            icon: @image-url("icons/whatsapp.svg");
                                            accent: #25d366;
                                            clicked => { root.open-whatsapp(); }
                                        }
                                        SupportLinkCard {
                                            title: "Apoyar el Proyecto (Ko-fi)";
                                            subtitle: "Ayuda a mantener ProyecThor 100% gratis para todos";
                                            icon: @image-url("icons/coffee.svg");
                                            accent: #ff5e5b;
                                            action-label: "Apoyar";
                                            clicked => { root.open-kofi-donations(); }
                                        }
                                    }
                                }

                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    HorizontalLayout {
                                        padding: 15px;
                                        spacing: 14px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 8px;
                                            Text { text: "Abrir desde tu Celular (Código QR)"; color: Theme.accent-strong; font-size: 13.5px; font-weight: 700; }
                                            Text {
                                                text: "Elige una opción y apunta con la cámara de tu teléfono al código blanco de la derecha:";
                                                color: Theme.text-secondary;
                                                font-size: 11.5px;
                                                wrap: word-wrap;
                                            }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                GlassButton { label: "Sitio Web"; horizontal-stretch: 1; primary: root.help-qr-idx == 0; clicked => { root.help-qr-idx = 0; root.select-help-qr(0); } }
                                                GlassButton { label: "Discord";   horizontal-stretch: 1; primary: root.help-qr-idx == 1; clicked => { root.help-qr-idx = 1; root.select-help-qr(1); } }
                                            }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                GlassButton { label: "Instagram"; horizontal-stretch: 1; primary: root.help-qr-idx == 2; clicked => { root.help-qr-idx = 2; root.select-help-qr(2); } }
                                                GlassButton { label: "WhatsApp";  horizontal-stretch: 1; primary: root.help-qr-idx == 3; clicked => { root.help-qr-idx = 3; root.select-help-qr(3); } }
                                            }
                                            Text {
                                                text: root.help-qr-url;
                                                color: Theme.text-muted;
                                                font-size: 10.5px;
                                                wrap: word-wrap;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 6px;
                                            alignment: center;
                                            Rectangle {
                                                width: 124px;
                                                height: 124px;
                                                border-radius: Theme.radius-md;
                                                background: #ffffff;
                                                border-width: 1px;
                                                border-color: Theme.border-subtle;
                                                Image {
                                                    width: 112px;
                                                    height: 112px;
                                                    x: 6px;
                                                    y: 6px;
                                                    source: root.help-qr-image;
                                                    image-fit: contain;
                                                }
                                            }
                                            Text {
                                                text: root.help-qr-label;
                                                color: Theme.text-secondary;
                                                font-size: 10.5px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                width: 124px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    VerticalLayout {
                                        padding: 15px;
                                        spacing: 8px;
                                        Text { text: "Flujo Profesional en Vivo"; color: Theme.accent-strong; font-size: 13.5px; font-weight: 700; }
                                        Text { text: "• Freeze (❄): Congela completamente la ventana secundaria (texto, video, fondos y alertas) mientras buscas la siguiente canción o diapositiva."; color: Theme.text-primary; font-size: 12px; wrap: word-wrap; }
                                        Text { text: "• Escalado / FSR (⤢): Cambia entre Recortar/Llenar, Estirar 16:9 o Tamaño Original, y activa el realce de nitidez FSR."; color: Theme.text-primary; font-size: 12px; wrap: word-wrap; }
                                        Text { text: "• Panel Capas (Derecha): Controla Fondos en Bucle (hover para vista previa), Overlays PNG y Notas/Avisos animados sin cambiar de pestaña."; color: Theme.text-primary; font-size: 12px; wrap: word-wrap; }
                                        Text { text: "• Escanear Bibliotecas (↻): Las bibliotecas se cachean en memoria para ahorrar CPU; pulsa Escanear cuando agregues archivos manualmente."; color: Theme.text-primary; font-size: 12px; wrap: word-wrap; }
                                        Text { text: "• Centro de Redes: Video LAN (8080), Smart TV DLNA, Chat LAN (8082) y Celular (8090) funcionan de forma 100% independiente."; color: Theme.text-primary; font-size: 12px; wrap: word-wrap; }
                                        Text { text: "• Música Independiente (🎧): Reproduce pistas de audio sin cortar ni interferir con tus fondos de video."; color: Theme.text-primary; font-size: 12px; wrap: word-wrap; }
                                    }
                                }
                            }
                        }

                        if root.help-subtab == 1 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 10px;
                                padding-right: 8px;
                                Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    VerticalLayout {
                                        padding: 15px;
                                        Text {
                                            text: root.changelog-text;
                                            color: Theme.text-primary;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── Mode 12: Consola Debug y Diagnóstico ──
                    if root.active-tab == 12 : VerticalLayout {
                        spacing: 10px;
                        vertical-stretch: 1;

                        HorizontalLayout {
                            spacing: 6px;
                            GlassButton { label: "Actualizar"; icon: @image-url("icons/refresh.svg"); has-icon: true; compact: true; clicked => { root.debug-refresh(); } }
                            GlassButton { label: "Re-escanear Todo"; compact: true; clicked => { root.scan-libraries(); } }
                            GlassButton { label: "Limpiar Log"; compact: true; danger: true; clicked => { root.debug-clear-log(); } }
                        }

                        // Telemetry KPI Strip: FPS, CPU % y Consumo de RAM
                        HorizontalLayout {
                            spacing: 8px;
                            height: 66px;

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-surface-1;
                                border-width: 1px;
                                border-color: #22c55e55;
                                VerticalLayout {
                                    padding: 10px;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "FPS (UI / Video)"; color: Theme.text-muted; font-size: 10px; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: root.debug-fps-text; color: #22c55e; font-size: 18px; font-weight: 800; vertical-alignment: center; }
                                        Text { text: root.debug-video-fps-text; color: Theme.text-secondary; font-size: 10.5px; vertical-alignment: center; }
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-surface-1;
                                border-width: 1px;
                                border-color: #38bdf855;
                                VerticalLayout {
                                    padding: 10px;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "USO DE CPU"; color: Theme.text-muted; font-size: 10px; font-weight: 700; }
                                    Text { text: root.debug-cpu-text; color: #38bdf8; font-size: 18px; font-weight: 800; }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: Theme.radius-md;
                                background: Theme.bg-surface-1;
                                border-width: 1px;
                                border-color: #a855f755;
                                VerticalLayout {
                                    padding: 10px;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "CONSUMO RAM"; color: Theme.text-muted; font-size: 10px; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: root.debug-ram-text; color: #c084fc; font-size: 18px; font-weight: 800; vertical-alignment: center; }
                                        Text { text: root.debug-peak-ram-text; color: Theme.text-muted; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            border-radius: Theme.radius-md;
                            background: Theme.bg-surface-1;
                            border-width: 1px;
                            border-color: #ef444444;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;
                                Text { text: "Estado del Motor en Tiempo Real"; color: Theme.accent-strong; font-size: 12px; font-weight: 700; }
                                Text { text: root.debug-stats; color: Theme.text-primary; font-size: 11.5px; wrap: word-wrap; }
                            }
                        }

                        Rectangle {
                            border-radius: Theme.radius-md;
                            background: Theme.bg-surface-1;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 5px;
                                Text { text: "Rutas de Datos (AppPaths)"; color: Theme.text-secondary; font-size: 12px; font-weight: 700; }
                                Text { text: root.debug-paths; color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: Theme.radius-md;
                            background: Theme.bg-input;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            ScrollView {
                                VerticalLayout {
                                    padding: 12px;
                                    Text {
                                        text: root.debug-log == "" ? "Sin eventos registrados aún." : root.debug-log;
                                        color: #a1a1aa;
                                        font-size: 11px;
                                        font-family: "Monospace";
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }

                    // ── Mode 14: MATRIZ MULTI-PANTALLA Y SALAS (Control Independiente tipo ProPresenter) ──
                    if root.active-tab == 14 : VerticalLayout {
                        spacing: 10px;
                        vertical-stretch: 1;

                        // Top Routing & New Room Bar (clean studio style, no emojis)
                        Rectangle {
                            height: 48px;
                            border-radius: Theme.radius-md;
                            background: Theme.bg-surface-1;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;

                                Text {
                                    text: "DESTINO:";
                                    color: Theme.text-muted;
                                    font-size: 10px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }

                                GlassButton {
                                    label: "Todas";
                                    compact: true;
                                    primary: root.output-target-mode == 0;
                                    clicked => { root.select-output-target(0); }
                                }
                                GlassButton {
                                    label: "Público";
                                    icon: @image-url("icons/tv.svg");
                                    has-icon: true;
                                    compact: true;
                                    primary: root.output-target-mode == 1;
                                    clicked => { root.select-output-target(1); }
                                }
                                GlassButton {
                                    label: "LAN";
                                    icon: @image-url("icons/wifi.svg");
                                    has-icon: true;
                                    compact: true;
                                    primary: root.output-target-mode == 2;
                                    clicked => { root.select-output-target(2); }
                                }
                                GlassButton {
                                    label: "Stage";
                                    icon: @image-url("icons/monitor.svg");
                                    has-icon: true;
                                    compact: true;
                                    primary: root.output-target-mode == 3;
                                    clicked => { root.select-output-target(3); }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                LineEdit {
                                    width: 170px;
                                    placeholder-text: "Nueva sala (ej. Sala Niños)...";
                                    text <=> root.new-room-name;
                                    accepted(v) => {
                                        if (v != "") {
                                            root.create-extra-screen(v);
                                            root.new-room-name = "";
                                        }
                                    }
                                }
                                GlassButton {
                                    label: "Nueva Sala";
                                    icon: @image-url("icons/plus.svg");
                                    has-icon: true;
                                    compact: true;
                                    primary: true;
                                    clicked => {
                                        if (root.new-room-name != "") {
                                            root.create-extra-screen(root.new-room-name);
                                            root.new-room-name = "";
                                        } else {
                                            root.create-extra-screen("");
                                        }
                                    }
                                }
                            }
                        }

                        // Multi-Screen Studio Cards Scroll Area
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 12px;
                                padding-right: 6px;

                                for scr[sidx] in root.screen-matrix-items : Rectangle {
                                    border-radius: Theme.radius-md;
                                    background: Theme.bg-surface-1;
                                    border-width: scr.is-targeted ? 1.5px : 1px;
                                    border-color: scr.is-targeted ? #38bdf8 : (scr.is-inspected ? Theme.border-accent : Theme.border-subtle);
                                    animate border-color { duration: 150ms; easing: ease-out; }

                                    VerticalLayout {
                                        padding: 13px;
                                        spacing: 10px;

                                        // Screen Card Header
                                        HorizontalLayout {
                                            alignment: space-between;
                                            spacing: 8px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                Rectangle {
                                                    height: 22px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 4px;
                                                    background: scr.is-live ? Theme.live-green-soft : Theme.bg-surface-2;
                                                    border-width: 1px;
                                                    border-color: scr.is-live ? Theme.live-green.transparentize(0.35) : Theme.border-subtle;
                                                    HorizontalLayout {
                                                        padding-left: 7px;
                                                        padding-right: 7px;
                                                        spacing: 5px;
                                                        Rectangle {
                                                            width: 6px;
                                                            height: 6px;
                                                            y: (parent.height - self.height) / 2;
                                                            border-radius: 3px;
                                                            background: scr.is-live ? Theme.live-green : Theme.text-muted;
                                                        }
                                                        Text {
                                                            text: scr.is-live ? "ACTIVA" : "LISTA";
                                                            color: scr.is-live ? Theme.live-green : Theme.text-muted;
                                                            font-size: 9px;
                                                            font-weight: 800;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                Text {
                                                    text: scr.name;
                                                    color: Theme.text-primary;
                                                    font-size: 13.5px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle {
                                                    height: 20px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 4px;
                                                    background: Theme.bg-surface-2;
                                                    HorizontalLayout {
                                                        padding-left: 7px;
                                                        padding-right: 7px;
                                                        Text {
                                                            text: scr.role-badge;
                                                            color: Theme.text-muted;
                                                            font-size: 9px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 6px;
                                                GlassButton {
                                                    label: scr.is-targeted ? "Destino Activo" : "Enviar Solo Aquí";
                                                    compact: true;
                                                    primary: scr.is-targeted;
                                                    clicked => { root.select-output-target(scr.id + 1); }
                                                }
                                                GlassButton {
                                                    label: scr.is-inspected ? "En Monitor" : "Ver en Monitor";
                                                    compact: true;
                                                    primary: scr.is-inspected;
                                                    clicked => { root.inspect-screen(scr.id); }
                                                }
                                                if scr.is-custom-room : IslandIconButton {
                                                    y: (parent.height - self.height) / 2;
                                                    icon: @image-url("icons/trash.svg");
                                                    danger: true;
                                                    clicked => { root.delete-extra-screen(scr.id); }
                                                }
                                            }
                                        }

                                        // Horizontal split: 16:9 Live Mini-Monitor on Left + Layer & Routing Controls on Right
                                        HorizontalLayout {
                                            spacing: 12px;

                                            // 16:9 Live Preview Canvas for this Screen/Room
                                            Rectangle {
                                                width: 256px;
                                                height: 144px;
                                                border-radius: 5px;
                                                background: scr.bg-color;
                                                border-width: 1px;
                                                border-color: scr.is-targeted ? #38bdf8 : (scr.is-live ? Theme.live-green.transparentize(0.35) : Theme.border-medium);
                                                clip: true;
                                                animate border-color { duration: 150ms; }

                                                if scr.has-bg-image : Image {
                                                    x: 0px;
                                                    y: 0px;
                                                    width: 100%;
                                                    height: 100%;
                                                    source: scr.bg-image;
                                                    image-fit: root.bg-scale-mode == 1 ? fill : (root.bg-scale-mode == 2 ? contain : cover);
                                                }

                                                if scr.has-overlay-image : Image {
                                                    x: 0px;
                                                    y: 0px;
                                                    width: 100%;
                                                    height: 100%;
                                                    source: scr.overlay-image;
                                                    image-fit: contain;
                                                }

                                                if scr.live-text != "" : StyledTextBlock {
                                                    width: Math.clamp(scr.lyrics-width, 0.15, 1.0) * parent.width;
                                                    height: Math.clamp(scr.lyrics-height, 0.08, 1.0) * parent.height;
                                                    x: Math.clamp(scr.lyrics-pos-x * parent.width - self.width / 2, 0px, Math.max(0px, parent.width - self.width));
                                                    y: Math.clamp(scr.lyrics-pos-y * parent.height - self.height / 2, 0px, Math.max(0px, parent.height - self.height));
                                                    text-body: scr.live-text;
                                                    text-size: Math.max(6.5, scr.text-size * 0.20);
                                                    text-align: scr.text-align;
                                                    text-valign: scr.text-valign;
                                                    text-color: scr.text-color;
                                                    font-family-name: scr.font-family-name;
                                                    font-weight-val: scr.font-weight-val;
                                                    text-shadow: scr.text-shadow;
                                                    text-outline: scr.text-outline;
                                                    text-glow: scr.text-glow;
                                                    text-neon: scr.text-neon;
                                                    text-3d: scr.text-3d;
                                                    text-underline: scr.text-underline;
                                                    text-box-bg: scr.text-box-bg;
                                                    box-padding: 3px;
                                                }

                                                if scr.live-text == "" && !scr.show-clock : Text {
                                                    text: "Sin texto en " + scr.name;
                                                    color: Theme.text-muted;
                                                    font-size: 10px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }

                                                if scr.show-clock && scr.clock-text != "" : Rectangle {
                                                    x: parent.width - self.width - 8px;
                                                    y: 7px;
                                                    width: Math.max(58px, scr-clk.preferred-width + 14px);
                                                    height: 22px;
                                                    border-radius: 4px;
                                                    background: #09090be6;
                                                    border-width: 1px;
                                                    border-color: #38bdf866;
                                                    scr-clk := Text {
                                                        text: scr.clock-text;
                                                        color: #ffffff;
                                                        font-size: 10.5px;
                                                        font-weight: 800;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                if scr.show-pleca && scr.pleca-title != "" : Rectangle {
                                                    x: 8px;
                                                    y: parent.height - 32px;
                                                    width: Math.min(parent.width - 16px, 180px);
                                                    height: 24px;
                                                    border-radius: 3px;
                                                    background: #09090be6;
                                                    border-width: 1px;
                                                    border-color: #a855f788;
                                                    HorizontalLayout {
                                                        padding-left: 7px;
                                                        padding-right: 7px;
                                                        Text {
                                                            text: scr.pleca-title;
                                                            color: #ffffff;
                                                            font-size: 9.5px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                            overflow: elide;
                                                        }
                                                    }
                                                }

                                                if scr.alert-text != "" : Rectangle {
                                                    y: root.alert-position == 1 ? 0px : parent.height - 20px;
                                                    width: 100%;
                                                    height: 20px;
                                                    background: #7f1d1df0;
                                                    Text {
                                                        text: scr.alert-text;
                                                        color: #ffffff;
                                                        font-size: 9.5px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                }

                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.inspect-screen(scr.id); }
                                                }
                                            }

                                            // Right Side of Card: Independent Layer Switches & Quick Send Actions
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 8px;
                                                alignment: space-between;

                                                // Active Layer Toggles / Pills for this screen
                                                VerticalLayout {
                                                    spacing: 5px;
                                                    Text {
                                                        text: "CAPAS ACTIVAS";
                                                        color: Theme.text-muted;
                                                        font-size: 9.5px;
                                                        font-weight: 800;
                                                    }

                                                    HorizontalLayout {
                                                        spacing: 5px;
                                                        GlassButton {
                                                            label: scr.show-clock ? (scr.clock-text + "  ✕") : "Tiempo / Reloj";
                                                            icon: @image-url("icons/clock.svg");
                                                            has-icon: true;
                                                            compact: true;
                                                            primary: scr.show-clock;
                                                            horizontal-stretch: 1;
                                                            clicked => { root.screen-toggle-layer(scr.id, "clock"); }
                                                        }
                                                        GlassButton {
                                                            label: scr.live-text != "" ? "Letras  ✕" : "Letras";
                                                            icon: @image-url("icons/file_text.svg");
                                                            has-icon: true;
                                                            compact: true;
                                                            primary: scr.live-text != "";
                                                            horizontal-stretch: 1;
                                                            clicked => { root.screen-toggle-layer(scr.id, "text"); }
                                                        }
                                                    }

                                                    HorizontalLayout {
                                                        spacing: 5px;
                                                        GlassButton {
                                                            label: scr.bg-name != "Sin fondo" ? (scr.bg-name + "  ✕") : "Fondo";
                                                            icon: @image-url("icons/film.svg");
                                                            has-icon: true;
                                                            compact: true;
                                                            primary: scr.bg-name != "Sin fondo";
                                                            horizontal-stretch: 1;
                                                            clicked => { root.screen-toggle-layer(scr.id, "bg"); }
                                                        }
                                                        GlassButton {
                                                            label: scr.alert-text != "" ? "Aviso  ✕" : "Aviso";
                                                            icon: @image-url("icons/bell.svg");
                                                            has-icon: true;
                                                            compact: true;
                                                            primary: scr.alert-text != "";
                                                            horizontal-stretch: 1;
                                                            clicked => { root.screen-toggle-layer(scr.id, "alert"); }
                                                        }
                                                    }

                                                    Text {
                                                        text: scr.queue-summary;
                                                        color: Theme.text-secondary;
                                                        font-size: 10.5px;
                                                        overflow: elide;
                                                    }
                                                }

                                                // Quick Routing Actions Footer for this screen
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    GlassButton {
                                                        label: "Enviar Selección";
                                                        icon: @image-url("icons/play.svg");
                                                        has-icon: true;
                                                        compact: true;
                                                        primary: true;
                                                        horizontal-stretch: 1;
                                                        clicked => { root.screen-send-current(scr.id); }
                                                    }
                                                    if scr.id != 0 : GlassButton {
                                                        label: "Clonar Público";
                                                        compact: true;
                                                        clicked => { root.screen-clone-public(scr.id); }
                                                    }
                                                    GlassButton {
                                                        label: "Limpiar";
                                                        compact: true;
                                                        danger: true;
                                                        clicked => { root.screen-clear-all(scr.id); }
                                                    }
                                                }
                                            }
                                        }

                                        // Per-Screen Independent Font Style (ProPresenter "Look" Override directly in each room card!)
                                        Rectangle {
                                            border-radius: Theme.radius-sm;
                                            background: Theme.bg-surface-0;
                                            border-width: 1px;
                                            border-color: scr.use-own-style ? #38bdf855 : Theme.border-subtle;
                                            animate border-color { duration: 150ms; easing: ease-out; }

                                            VerticalLayout {
                                                padding: 9px;
                                                spacing: 7px;

                                                HorizontalLayout {
                                                    alignment: space-between;
                                                    spacing: 8px;

                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        Image {
                                                            source: @image-url("icons/palette.svg");
                                                            width: 13px;
                                                            height: 13px;
                                                            y: (parent.height - self.height) / 2;
                                                            colorize: (scr.id == 0 || scr.use-own-style) ? #38bdf8 : Theme.text-muted;
                                                        }
                                                        Text {
                                                            text: scr.id == 0
                                                                ? ("Estilo Principal: " + scr.style-name + " (" + Math.round(scr.text-size) + "px)")
                                                                : (scr.use-own-style
                                                                    ? ("Estilo propio: " + scr.style-name + " (" + Math.round(scr.text-size) + "px)")
                                                                    : ("Siguiendo estilo de Público (" + scr.style-name + " · " + Math.round(scr.text-size) + "px)"));
                                                            color: (scr.id == 0 || scr.use-own-style) ? Theme.text-primary : Theme.text-muted;
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                            overflow: elide;
                                                        }
                                                    }

                                                    if scr.id != 0 : Rectangle {
                                                        height: 24px;
                                                        border-radius: 5px;
                                                        background: scr.use-own-style ? #0284c730 : (own-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-2);
                                                        border-width: 1px;
                                                        border-color: scr.use-own-style ? #38bdf8 : Theme.border-subtle;
                                                        animate background   { duration: 130ms; easing: ease-out; }
                                                        animate border-color { duration: 130ms; easing: ease-out; }
                                                        HorizontalLayout {
                                                            padding-left: 9px;
                                                            padding-right: 9px;
                                                            spacing: 6px;
                                                            Rectangle {
                                                                width: 7px;
                                                                height: 7px;
                                                                y: (parent.height - self.height) / 2;
                                                                border-radius: 3.5px;
                                                                background: scr.use-own-style ? #38bdf8 : Theme.text-muted;
                                                            }
                                                            Text {
                                                                text: scr.use-own-style ? "Estilo propio activo" : "Activar estilo propio";
                                                                color: scr.use-own-style ? #38bdf8 : Theme.text-secondary;
                                                                font-size: 10px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                        own-ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.set-screen-own-style(scr.id, !scr.use-own-style); }
                                                        }
                                                    }
                                                }

                                                if (scr.id == 0 || scr.use-own-style) && root.saved-style-cards.length > 0 : HorizontalLayout {
                                                    spacing: 5px;
                                                    for st[stIdx] in root.saved-style-cards : Rectangle {
                                                        height: 24px;
                                                        border-radius: 5px;
                                                        background: scr.assigned-style-idx == stIdx
                                                            ? (scr.id == 1 ? #0284c7 : (scr.id == 2 ? #d97706 : Theme.accent))
                                                            : (rm-st-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-2);
                                                        border-width: 1px;
                                                        border-color: scr.assigned-style-idx == stIdx
                                                            ? (scr.id == 1 ? #38bdf8 : (scr.id == 2 ? #fbbf24 : Theme.accent-strong))
                                                            : Theme.border-subtle;
                                                        animate background   { duration: 120ms; easing: ease-out; }
                                                        animate border-color { duration: 120ms; easing: ease-out; }
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 5px;
                                                            Rectangle {
                                                                width: 7px;
                                                                height: 7px;
                                                                y: (parent.height - self.height) / 2;
                                                                border-radius: 3.5px;
                                                                background: st.text-color;
                                                            }
                                                            Text {
                                                                text: st.name;
                                                                color: scr.assigned-style-idx == stIdx
                                                                    ? (scr.id == 0 ? Theme.accent-fg : #ffffff)
                                                                    : Theme.text-secondary;
                                                                font-size: 10px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                        rm-st-ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.apply-style-to-screen(stIdx, scr.id); }
                                                        }
                                                    }
                                                }

                                                if (scr.id == 0 || scr.use-own-style) && root.saved-style-cards.length == 0 : HorizontalLayout {
                                                    alignment: space-between;
                                                    Text {
                                                        text: "Sin estilos guardados — crea uno en Diseño > Estilos.";
                                                        color: Theme.text-muted;
                                                        font-size: 10px;
                                                        vertical-alignment: center;
                                                    }
                                                    GlassButton {
                                                        label: "Crear Estilo";
                                                        compact: true;
                                                        clicked => {
                                                            root.select-style-target(scr.id + 1);
                                                            root.active-tab = 4;
                                                            root.design-subtab = 0;
                                                            root.open-new-style-editor();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }

            // ═════════════════════════════════════════════════════════════════
            //  COLUMN 3: VISTA EN VIVO + CAPAS EN VIVO (Photoshop) + COLA DE SERVICIO
            // ═════════════════════════════════════════════════════════════════
            if !root.is-style-editor-active && root.active-tab != 7 : VerticalLayout {
                width: 364px;
                spacing: 10px;

                // ── Top Card: ProPresenter-Style Broadcast Monitor + Capas Activas ──
                GlassCard {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: 11px;
                        spacing: 9px;

                        // Single Clean Broadcast Header (Status + Segmented Monitor Switcher + Salas)
                        HorizontalLayout {
                            alignment: space-between;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 7px;
                                Rectangle {
                                    width: 7px;
                                    height: 7px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3.5px;
                                    background: root.audience-frozen ? #38bdf8 : (root.audience-live ? Theme.live-green : Theme.text-muted);
                                    animate background { duration: 180ms; easing: ease-out; }
                                }
                                Text {
                                    text: root.audience-frozen ? "Freeze" : (root.audience-live ? "En Vivo" : "Monitor");
                                    color: root.audience-frozen ? #38bdf8 : (root.audience-live ? Theme.text-primary : Theme.text-secondary);
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            // Unified ProPresenter-style Segmented Screen Switcher (no emojis, crisp track)
                            HorizontalLayout {
                                spacing: 5px;
                                Rectangle {
                                    height: 24px;
                                    border-radius: 6px;
                                    background: Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    HorizontalLayout {
                                        padding: 2px;
                                        spacing: 2px;

                                        Rectangle {
                                            border-radius: 4px;
                                            background: root.inspected-screen-idx == 0 ? Theme.bg-surface-hover : (pv-s0.has-hover ? Theme.bg-surface-2 : transparent);
                                            animate background { duration: 130ms; easing: ease-out; }
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px;
                                                Text {
                                                    text: "Público";
                                                    color: root.inspected-screen-idx == 0 ? Theme.text-primary : Theme.text-muted;
                                                    font-size: 10px;
                                                    font-weight: root.inspected-screen-idx == 0 ? 700 : 500;
                                                    vertical-alignment: center;
                                                    animate color { duration: 130ms; }
                                                }
                                            }
                                            pv-s0 := TouchArea { mouse-cursor: pointer; clicked => { root.inspect-screen(0); } }
                                        }
                                        Rectangle {
                                            border-radius: 4px;
                                            background: root.inspected-screen-idx == 1 ? #0284c740 : (pv-s1.has-hover ? Theme.bg-surface-2 : transparent);
                                            animate background { duration: 130ms; easing: ease-out; }
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px;
                                                Text {
                                                    text: "LAN";
                                                    color: root.inspected-screen-idx == 1 ? #38bdf8 : Theme.text-muted;
                                                    font-size: 10px;
                                                    font-weight: root.inspected-screen-idx == 1 ? 700 : 500;
                                                    vertical-alignment: center;
                                                    animate color { duration: 130ms; }
                                                }
                                            }
                                            pv-s1 := TouchArea { mouse-cursor: pointer; clicked => { root.inspect-screen(1); } }
                                        }
                                        Rectangle {
                                            border-radius: 4px;
                                            background: root.inspected-screen-idx == 2 ? #d9770640 : (pv-s2.has-hover ? Theme.bg-surface-2 : transparent);
                                            animate background { duration: 130ms; easing: ease-out; }
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px;
                                                Text {
                                                    text: "Stage";
                                                    color: root.inspected-screen-idx == 2 ? #fbbf24 : Theme.text-muted;
                                                    font-size: 10px;
                                                    font-weight: root.inspected-screen-idx == 2 ? 700 : 500;
                                                    vertical-alignment: center;
                                                    animate color { duration: 130ms; }
                                                }
                                            }
                                            pv-s2 := TouchArea { mouse-cursor: pointer; clicked => { root.inspect-screen(2); } }
                                        }
                                    }
                                }

                                // Salas / Multi-Screen quick icon button
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 6px;
                                    background: root.active-tab == 14 ? #38bdf828 : (pv-salas.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-1);
                                    border-width: 1px;
                                    border-color: root.active-tab == 14 ? #38bdf888 : Theme.border-subtle;
                                    animate background   { duration: 130ms; easing: ease-out; }
                                    animate border-color { duration: 130ms; easing: ease-out; }
                                    Image {
                                        source: @image-url("icons/layers.svg");
                                        width: 12px;
                                        height: 12px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        colorize: root.active-tab == 14 ? #38bdf8 : Theme.text-secondary;
                                    }
                                    pv-salas := TouchArea { mouse-cursor: pointer; clicked => { root.active-tab = 14; } }
                                }
                            }
                        }

                        // ── Pure 16:9 Broadcast Program Monitor (unobstructed cinematic frame, ProPresenter style) ──
                        Rectangle {
                            height: 188px;
                            border-radius: 6px;
                            background: root.live-bg-solid-color;
                            border-width: 1px;
                            border-color: root.inspected-screen-idx == 1 ? #38bdf880
                                        : root.inspected-screen-idx == 2 ? #fbbf2480
                                        : (root.audience-frozen ? #38bdf880 : (root.audience-live ? Theme.live-green.transparentize(0.45) : Theme.border-medium));
                            clip: true;
                            animate border-color { duration: 180ms; easing: ease-out; }

                            if root.has-live-preview-image : Image {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                height: 100%;
                                source: root.live-preview-image;
                                image-fit: root.bg-scale-mode == 1 ? fill : (root.bg-scale-mode == 2 ? contain : cover);
                            }

                            if root.bg-is-static-image && root.shader-preset != 0 : Rectangle {
                                background: root.shader-preset == 1 ? #f9731628
                                          : root.shader-preset == 2 ? #0284c72b
                                          : root.shader-preset == 3 ? #09090b78
                                          : root.shader-preset == 4 ? #92400e44
                                          : #00000038;
                            }
                            if root.bg-is-static-image && root.shader-brightness < -1.0 : Rectangle {
                                background: #000000;
                                opacity: Math.clamp(-root.shader-brightness / 65.0, 0.0, 0.78);
                            }
                            if root.bg-is-static-image && root.shader-brightness > 1.0 : Rectangle {
                                background: #ffffff;
                                opacity: Math.clamp(root.shader-brightness / 95.0, 0.0, 0.55);
                            }

                            if root.has-live-overlay-image : Image {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                height: 100%;
                                source: root.live-overlay-image;
                                image-fit: contain;
                            }

                            // 1:1 Bounded Lyrics Box matching inspected screen's own text style
                            if root.live-text != "" : StyledTextBlock {
                                width: Math.clamp(root.preview-lyrics-width, 0.15, 1.0) * parent.width;
                                height: Math.clamp(root.preview-lyrics-height, 0.08, 1.0) * parent.height;
                                x: Math.clamp(root.preview-lyrics-pos-x * parent.width - self.width / 2, 0px, Math.max(0px, parent.width - self.width));
                                y: Math.clamp(root.preview-lyrics-pos-y * parent.height - self.height / 2, 0px, Math.max(0px, parent.height - self.height));
                                text-body: root.live-text;
                                text-size: Math.max(7.0, root.preview-text-size * 0.25);
                                text-fit-mode: root.preview-text-fit-mode;
                                fit-box-height: Math.clamp(root.preview-lyrics-height, 0.08, 1.0) * parent.height;
                                text-align: root.preview-text-align;
                                text-valign: root.preview-text-valign;
                                text-color: root.preview-text-color;
                                font-family-name: root.preview-font-family-name;
                                font-weight-val: root.preview-font-weight-val;
                                text-shadow: root.preview-text-shadow;
                                text-outline: root.preview-text-outline;
                                text-glow: root.preview-text-glow;
                                text-neon: root.preview-text-neon;
                                text-3d: root.preview-text-3d;
                                text-underline: root.preview-text-underline;
                                text-box-bg: root.preview-text-box-bg;
                                box-padding: 4px;
                            }

                            if root.live-text == "" && !root.preview-show-clock && !root.has-live-preview-image : Text {
                                text: "Sin señal en " + root.inspected-screen-name;
                                color: Theme.text-muted.transparentize(0.25);
                                font-size: 11px;
                                font-weight: 500;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            if root.preview-index-box-enabled && root.live-is-bible && root.live-ref != "" : StyledTextBlock {
                                width: Math.clamp(root.preview-index-width, 0.12, 1.0) * parent.width;
                                height: Math.clamp(root.preview-index-height, 0.06, 0.60) * parent.height;
                                x: Math.clamp(root.preview-index-pos-x * parent.width - self.width / 2, 0px, Math.max(0px, parent.width - self.width));
                                y: Math.clamp(root.preview-index-pos-y * parent.height - self.height / 2, 0px, Math.max(0px, parent.height - self.height));
                                text-body: root.live-ref;
                                text-size: Math.max(6.5, root.preview-index-size * 0.25);
                                text-align: root.preview-index-align;
                                text-color: root.preview-index-color;
                                font-family-name: root.preview-index-font-family-name;
                                font-weight-val: root.preview-index-font-weight-val;
                                text-shadow: root.preview-index-shadow;
                                text-outline: root.preview-index-outline;
                                text-glow: root.preview-index-glow;
                                glow-color: root.preview-index-color;
                                text-box-bg: root.preview-index-box-bg;
                                box-padding: 3px;
                            }

                            // Clock / Countdown Timer Overlay rendered live inside Vista en Vivo
                            if root.preview-show-clock && root.preview-clock-text != "" : Rectangle {
                                x: parent.width - self.width - 8px;
                                y: 8px;
                                width: Math.max(60px, pv-clk-txt.preferred-width + 16px);
                                height: 22px;
                                border-radius: 4px;
                                background: #09090be0;
                                border-width: 1px;
                                border-color: #38bdf866;
                                pv-clk-txt := Text {
                                    text: root.preview-clock-text;
                                    color: #ffffff;
                                    font-size: 11px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Lower-Third / Pleca Overlay rendered live inside Vista en Vivo
                            if root.preview-show-pleca && root.preview-pleca-title != "" : Rectangle {
                                x: 10px;
                                y: parent.height - 38px;
                                width: Math.min(parent.width - 20px, 230px);
                                height: 30px;
                                border-radius: 4px;
                                background: #09090be8;
                                border-width: 1px;
                                border-color: #a855f788;
                                VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text { text: root.preview-pleca-title; color: #ffffff; font-size: 10px; font-weight: 800; overflow: elide; }
                                    if root.preview-pleca-sub != "" : Text { text: root.preview-pleca-sub; color: #a1a1aa; font-size: 8.5px; overflow: elide; }
                                }
                            }

                            if root.active-public-alert != "" : Rectangle {
                                y: root.alert-position == 1 ? 0px : parent.height - 24px;
                                width: 100%;
                                height: 24px;
                                background: root.alert-theme == 1 ? #7f1d1df0
                                          : root.alert-theme == 2 ? #78350ff0
                                          : root.alert-theme == 3 ? #1e3a8af0
                                          : #111113e8;
                                opacity: root.alert-anim-mode == 3 ? root.alert-pulse-alpha : 1.0;
                                clip: true;

                                if root.alert-anim-mode == 1 : Text {
                                    x: parent.width - root.alert-ticker-pos * (parent.width + self.preferred-width);
                                    y: 0px;
                                    height: parent.height;
                                    text: "  " + root.active-public-alert + "  ";
                                    color: #ffffff;
                                    font-size: 10px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                if root.alert-anim-mode != 1 : Text {
                                    x: 6px;
                                    y: 0px;
                                    width: parent.width - 12px;
                                    height: parent.height;
                                    text: root.active-public-alert;
                                    color: #ffffff;
                                    font-size: 10px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        // ── Studio Monitor Footer: Active Look (Left) + Clean Segmented Routing (Right) ──
                        HorizontalLayout {
                            alignment: space-between;
                            spacing: 6px;

                            // Active Look / Font Style pill for inspected screen
                            Rectangle {
                                height: 22px;
                                horizontal-stretch: 1;
                                border-radius: 5px;
                                background: look-ta.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-1;
                                border-width: 1px;
                                border-color: root.preview-own-style ? #38bdf855 : Theme.border-subtle;
                                animate background   { duration: 130ms; }
                                animate border-color { duration: 130ms; }
                                HorizontalLayout {
                                    padding-left: 7px;
                                    padding-right: 7px;
                                    spacing: 5px;
                                    Image {
                                        source: @image-url("icons/palette.svg");
                                        width: 11px;
                                        height: 11px;
                                        y: (parent.height - self.height) / 2;
                                        colorize: root.preview-own-style ? #38bdf8 : Theme.text-muted;
                                    }
                                    Text {
                                        text: root.preview-style-name + " · " + Math.round(root.preview-text-size) + "px";
                                        color: root.preview-own-style ? #38bdf8 : Theme.text-secondary;
                                        font-size: 9.5px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                look-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (root.inspected-screen-idx == 1) {
                                            root.active-tab = 5;
                                            root.net-subtab = 0;
                                        } else {
                                            root.select-style-target(root.inspected-screen-idx + 1);
                                            root.active-tab = 4;
                                            root.design-subtab = 0;
                                        }
                                    }
                                }
                            }

                            // Clean ProPresenter-style Segmented Output Routing (no emojis!)
                            Rectangle {
                                height: 22px;
                                border-radius: 5px;
                                background: Theme.bg-surface-1;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    padding: 2px;
                                    spacing: 2px;
                                    Rectangle {
                                        border-radius: 3px;
                                        background: root.output-target-mode == 0 ? Theme.live-green.transparentize(0.78) : (rt0.has-hover ? Theme.bg-surface-2 : transparent);
                                        animate background { duration: 120ms; }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px;
                                            Text { text: "Todas"; color: root.output-target-mode == 0 ? Theme.live-green : Theme.text-muted; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        rt0 := TouchArea { mouse-cursor: pointer; clicked => { root.select-output-target(0); } }
                                    }
                                    Rectangle {
                                        border-radius: 3px;
                                        background: root.output-target-mode == 1 ? Theme.bg-surface-hover : (rt1.has-hover ? Theme.bg-surface-2 : transparent);
                                        animate background { duration: 120ms; }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px;
                                            Text { text: "Púb"; color: root.output-target-mode == 1 ? Theme.text-primary : Theme.text-muted; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        rt1 := TouchArea { mouse-cursor: pointer; clicked => { root.select-output-target(1); } }
                                    }
                                    Rectangle {
                                        border-radius: 3px;
                                        background: root.output-target-mode == 2 ? #0284c744 : (rt2.has-hover ? Theme.bg-surface-2 : transparent);
                                        animate background { duration: 120ms; }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px;
                                            Text { text: "LAN"; color: root.output-target-mode == 2 ? #38bdf8 : Theme.text-muted; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        rt2 := TouchArea { mouse-cursor: pointer; clicked => { root.select-output-target(2); } }
                                    }
                                    Rectangle {
                                        border-radius: 3px;
                                        background: root.output-target-mode == 3 ? #d9770644 : (rt3.has-hover ? Theme.bg-surface-2 : transparent);
                                        animate background { duration: 120ms; }
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px;
                                            Text { text: "Stg"; color: root.output-target-mode == 3 ? #fbbf24 : Theme.text-muted; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        rt3 := TouchArea { mouse-cursor: pointer; clicked => { root.select-output-target(3); } }
                                    }
                                }
                            }
                        }

                        // Compact libmpv Media Transport (ONLY visible when a video background is playing — zero wasted space!)
                        if root.preview-has-video-bg : Rectangle {
                            vertical-stretch: 0;
                            border-radius: 3px;
                            background: Theme.bg-surface-1;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 7px;
                                spacing: 5px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "▶ " + root.live-bg-name; color: Theme.text-secondary; font-size: 10px; font-weight: 700; overflow: elide; horizontal-stretch: 1; }
                                    Text { text: root.media-time-label; color: Theme.text-muted; font-size: 9.5px; }
                                }

                                media-scrub := ScrubBar {
                                    value <=> root.media-position;
                                    seeked(v) => { root.seek-changed(v); }
                                    changed dragging => { root.media-seeking = self.dragging; }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    if root.video-queue-items.length > 0 : IconButton {
                                        icon: @image-url("icons/prev.svg");
                                        clicked => { root.prev-video-queue(); }
                                    }
                                    IconButton {
                                        icon: root.media-paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                                        clicked => { root.toggle-pause(); }
                                    }
                                    IconButton {
                                        icon: @image-url("icons/stop.svg");
                                        clicked => { root.stop-media(); }
                                    }
                                    if root.video-queue-items.length > 0 : IconButton {
                                        icon: @image-url("icons/next.svg");
                                        clicked => { root.next-video-queue(); }
                                    }
                                    IconButton {
                                        icon: @image-url("icons/repeat.svg");
                                        active: root.media-loop;
                                        clicked => { root.toggle-loop(); }
                                    }
                                    IconButton {
                                        icon: root.media-muted ? @image-url("icons/volume_off.svg") : @image-url("icons/volume.svg");
                                        active: root.media-muted;
                                        clicked => { root.toggle-mute(); }
                                    }
                                    Slider {
                                        horizontal-stretch: 1;
                                        minimum: 0;
                                        maximum: 150;
                                        value <=> root.media-volume;
                                        changed(v) => { root.volume-changed(v); }
                                    }
                                    Text { text: Math.round(root.media-volume) + "%"; color: Theme.text-muted; font-size: 9.5px; vertical-alignment: center; width: 28px; }
                                }
                            }
                        }

                        // ── PHOTOSHOP-STYLE REAL ACTIVE LAYERS STACK (Capas en Vivo con Preview y '✕') ──
                        Rectangle {
                            vertical-stretch: 0;
                            border-radius: 5px;
                            background: Theme.bg-surface-0;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 7px;
                                spacing: 5px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 5px;
                                        Image {
                                            source: @image-url("icons/layers.svg");
                                            width: 13px;
                                            height: 13px;
                                            y: (parent.height - self.height) / 2;
                                            colorize: Theme.accent-strong;
                                        }
                                        Text {
                                            text: "Capas Activas (" + root.active-layers.length + ")";
                                            color: Theme.text-primary;
                                            font-size: 11px;
                                            font-weight: 800;
                                            vertical-alignment: center;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        // 1-click Time Overlay toggle right on the Active Layers panel (SVG icon, no emoji)
                                        Rectangle {
                                            height: 22px;
                                            border-radius: 5px;
                                            background: root.preview-show-clock ? #0284c738 : (clk-chip-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-1);
                                            border-width: 1px;
                                            border-color: root.preview-show-clock ? #38bdf8 : Theme.border-subtle;
                                            animate background   { duration: 130ms; easing: ease-out; }
                                            animate border-color { duration: 130ms; easing: ease-out; }
                                            HorizontalLayout {
                                                padding-left: 7px;
                                                padding-right: 7px;
                                                spacing: 4px;
                                                Image {
                                                    source: @image-url("icons/clock.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    y: (parent.height - self.height) / 2;
                                                    colorize: root.preview-show-clock ? #38bdf8 : Theme.text-secondary;
                                                }
                                                Text {
                                                    text: root.preview-show-clock ? "Tiempo" : "+ Tiempo";
                                                    color: root.preview-show-clock ? #38bdf8 : Theme.text-secondary;
                                                    font-size: 9.5px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            clk-chip-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.screen-toggle-layer(root.inspected-screen-idx, "clock"); }
                                            }
                                        }

                                        if root.active-layers.length > 0 : Rectangle {
                                            height: 20px;
                                            border-radius: 4px;
                                            background: clr-all-ta.has-hover ? #ef444433 : Theme.bg-surface-1;
                                            border-width: 1px;
                                            border-color: clr-all-ta.has-hover ? #ef4444 : Theme.border-subtle;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: "Limpiar";
                                                    color: clr-all-ta.has-hover ? #f87171 : Theme.text-muted;
                                                    font-size: 9.5px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            clr-all-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.screen-clear-all(root.inspected-screen-idx); }
                                            }
                                        }
                                    }
                                }

                                if root.active-layers.length == 0 : Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: Theme.bg-surface-1;
                                    Text {
                                        text: "Sin capas activas en " + root.inspected-screen-name + " — proyecta letras, video, música o tiempo.";
                                        color: Theme.text-muted;
                                        font-size: 10px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.active-layers.length > 0 : ScrollView {
                                    height: Math.min(168px, root.active-layers.length * 41px);
                                    VerticalLayout {
                                        spacing: 4px;
                                        for lyr in root.active-layers : Rectangle {
                                            height: 37px;
                                            border-radius: 4px;
                                            background: Theme.bg-surface-1;
                                            border-width: 1px;
                                            border-color: Theme.border-subtle;
                                            clip: true;

                                            // Left color accent strip per layer type
                                            Rectangle {
                                                x: 0px;
                                                y: 0px;
                                                width: 3px;
                                                height: 100%;
                                                background: lyr.accent;
                                            }

                                            HorizontalLayout {
                                                padding-left: 7px;
                                                padding-right: 6px;
                                                padding-top: 3px;
                                                padding-bottom: 3px;
                                                spacing: 7px;

                                                // Layer Mini Thumbnail / Real Black-Background Layer Preview Box
                                                Rectangle {
                                                    width: 52px;
                                                    height: 30px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 3px;
                                                    background: #000000;
                                                    border-width: 1px;
                                                    border-color: lyr.accent.transparentize(0.45);
                                                    clip: true;

                                                    if lyr.has-thumbnail : Image {
                                                        x: 0px;
                                                        y: 0px;
                                                        width: 100%;
                                                        height: 100%;
                                                        source: lyr.thumbnail;
                                                        image-fit: lyr.id == "overlay" ? contain : cover;
                                                    }

                                                    // Real miniature preview on pure black background for Text / Bible layer
                                                    if !lyr.has-thumbnail && lyr.id == "text" : Rectangle {
                                                        width: 100%;
                                                        height: 100%;
                                                        background: #000000;
                                                        Text {
                                                            x: 2px;
                                                            y: 1px;
                                                            width: parent.width - 4px;
                                                            height: parent.height - (root.live-is-bible && root.live-ref != "" ? 8px : 2px);
                                                            text: root.live-text;
                                                            color: root.preview-text-color;
                                                            font-family: root.preview-font-family-name;
                                                            font-weight: root.preview-font-weight-val;
                                                            font-size: 5.5px;
                                                            horizontal-alignment: root.preview-text-align == 0 ? left : (root.preview-text-align == 2 ? right : center);
                                                            vertical-alignment: root.preview-text-valign == 0 ? top : (root.preview-text-valign == 2 ? bottom : center);
                                                            wrap: word-wrap;
                                                            overflow: clip;
                                                        }
                                                        if root.live-is-bible && root.live-ref != "" : Text {
                                                            x: 2px;
                                                            y: parent.height - 8px;
                                                            width: parent.width - 4px;
                                                            height: 7px;
                                                            text: root.live-ref;
                                                            color: root.preview-index-color;
                                                            font-size: 4.5px;
                                                            font-weight: 700;
                                                            horizontal-alignment: center;
                                                            overflow: elide;
                                                        }
                                                    }

                                                    // Real miniature preview on pure black background for Clock / Timer layer
                                                    if !lyr.has-thumbnail && lyr.id == "clock" : Rectangle {
                                                        width: 100%;
                                                        height: 100%;
                                                        background: #000000;
                                                        Text {
                                                            text: root.preview-clock-text != "" ? root.preview-clock-text : "00:00";
                                                            color: #38bdf8;
                                                            font-size: 7.5px;
                                                            font-weight: 800;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    // Real miniature preview on pure black background for Alert banner layer
                                                    if !lyr.has-thumbnail && lyr.id == "alert" : Rectangle {
                                                        width: 100%;
                                                        height: 100%;
                                                        background: #000000;
                                                        Rectangle {
                                                            y: root.alert-position == 1 ? 2px : parent.height - 9px;
                                                            width: 100%;
                                                            height: 7px;
                                                            background: root.alert-theme == 1 ? #991b1b
                                                                      : root.alert-theme == 2 ? #92400e
                                                                      : root.alert-theme == 3 ? #1e40af
                                                                      : #27272a;
                                                            Text {
                                                                x: 2px;
                                                                width: parent.width - 4px;
                                                                text: lyr.title;
                                                                color: #ffffff;
                                                                font-size: 4.5px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                                overflow: elide;
                                                            }
                                                        }
                                                    }

                                                    // Real miniature preview on pure black background for Pleca / Lower-Third
                                                    if !lyr.has-thumbnail && lyr.id == "pleca" : Rectangle {
                                                        width: 100%;
                                                        height: 100%;
                                                        background: #000000;
                                                        Rectangle {
                                                            x: 3px;
                                                            y: parent.height - 10px;
                                                            width: parent.width - 6px;
                                                            height: 8px;
                                                            border-radius: 1.5px;
                                                            background: #18181b;
                                                            border-width: 1px;
                                                            border-color: #a855f7aa;
                                                            Text {
                                                                x: 2px;
                                                                width: parent.width - 4px;
                                                                text: root.preview-pleca-title;
                                                                color: #ffffff;
                                                                font-size: 4.5px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                                overflow: elide;
                                                            }
                                                        }
                                                    }

                                                    // Solid color background layer preview
                                                    if !lyr.has-thumbnail && lyr.id == "bg" : Rectangle {
                                                        width: 100%;
                                                        height: 100%;
                                                        background: root.live-bg-solid-color;
                                                    }

                                                    // Music fallback when track has no embedded cover
                                                    if !lyr.has-thumbnail && lyr.id == "music" : Rectangle {
                                                        width: 100%;
                                                        height: 100%;
                                                        background: #000000;
                                                        Text {
                                                            text: "♫";
                                                            color: lyr.accent;
                                                            font-size: 13px;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }

                                                // Layer Title & Live Content Preview
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 1px;
                                                    HorizontalLayout {
                                                        spacing: 5px;
                                                        Text {
                                                            text: lyr.kind;
                                                            color: lyr.accent;
                                                            font-size: 8.5px;
                                                            font-weight: 800;
                                                            vertical-alignment: center;
                                                        }
                                                        Text {
                                                            text: lyr.title;
                                                            color: Theme.text-primary;
                                                            font-size: 11px;
                                                            font-weight: 700;
                                                            overflow: elide;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }
                                                    }
                                                    Text {
                                                        text: lyr.subtitle;
                                                        color: Theme.text-muted;
                                                        font-size: 9.5px;
                                                        overflow: elide;
                                                    }
                                                }

                                                // Photoshop-style '✕' Delete Layer Button
                                                Rectangle {
                                                    width: 24px;
                                                    height: 24px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 4px;
                                                    background: del-lyr-ta.has-hover ? #ef444438 : Theme.bg-surface-2;
                                                    border-width: 1px;
                                                    border-color: del-lyr-ta.has-hover ? #ef4444 : Theme.border-subtle;
                                                    Text {
                                                        text: "✕";
                                                        color: del-lyr-ta.has-hover ? #f87171 : Theme.text-secondary;
                                                        font-size: 10.5px;
                                                        font-weight: 800;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    del-lyr-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.remove-active-layer(lyr.id); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Right Bottom Card: COLA DE SERVICIO (Letras | Videos | Overlays) ──
                GlassCard {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 7px;

                        HorizontalLayout {
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 6px;
                                Image {
                                    source: @image-url("icons/list.svg");
                                    width: 14px;
                                    height: 14px;
                                    y: (parent.height - self.height) / 2;
                                    colorize: Theme.text-secondary;
                                }
                                Text {
                                    text: "Cola de Servicio";
                                    color: Theme.text-primary;
                                    font-size: 12.5px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                if root.queue-category == 1 && root.video-queue-items.length > 0 : IslandIconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: @image-url("icons/prev.svg");
                                    clicked => { root.prev-video-queue(); }
                                }
                                if root.queue-category == 1 && root.video-queue-items.length > 0 : IslandIconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: root.video-queue-playing ? @image-url("icons/stop.svg") : @image-url("icons/play.svg");
                                    active: root.video-queue-playing;
                                    clicked => { root.toggle-video-queue-play(); }
                                }
                                if root.queue-category == 1 && root.video-queue-items.length > 0 : IslandIconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: @image-url("icons/next.svg");
                                    clicked => { root.next-video-queue(); }
                                }
                                if (root.queue-category == 0 && root.queue-items.length > 0)
                                    || (root.queue-category == 1 && root.video-queue-items.length > 0)
                                    || (root.queue-category == 2 && root.overlay-queue-items.length > 0) : IslandIconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: @image-url("icons/trash.svg");
                                    danger: true;
                                    clicked => {
                                        if (root.queue-category == 0) { root.clear-queue(); }
                                        else if (root.queue-category == 1) { root.clear-video-queue(); }
                                        else { root.clear-overlay-queue(); }
                                    }
                                }
                            }
                        }

                        // 3 Queue Category Tabs: Letras | Videos | Overlays
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                border-radius: 6px;
                                background: root.queue-category == 0 ? Theme.accent : (qc0-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-1);
                                border-width: 1px;
                                border-color: root.queue-category == 0 ? Theme.accent-strong : Theme.border-subtle;
                                animate background { duration: 120ms; }
                                Text {
                                    text: "Letras (" + root.queue-items.length + ")";
                                    color: root.queue-category == 0 ? Theme.accent-fg : Theme.text-secondary;
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                qc0-ta := TouchArea { mouse-cursor: pointer; clicked => { root.queue-category = 0; } }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                border-radius: 6px;
                                background: root.queue-category == 1 ? Theme.accent : (qc1-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-1);
                                border-width: 1px;
                                border-color: root.queue-category == 1 ? Theme.accent-strong : Theme.border-subtle;
                                animate background { duration: 120ms; }
                                Text {
                                    text: "Videos (" + root.video-queue-items.length + ")";
                                    color: root.queue-category == 1 ? Theme.accent-fg : Theme.text-secondary;
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                qc1-ta := TouchArea { mouse-cursor: pointer; clicked => { root.queue-category = 1; } }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                border-radius: 6px;
                                background: root.queue-category == 2 ? Theme.accent : (qc2-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-1);
                                border-width: 1px;
                                border-color: root.queue-category == 2 ? Theme.accent-strong : Theme.border-subtle;
                                animate background { duration: 120ms; }
                                Text {
                                    text: "Overlays (" + root.overlay-queue-items.length + ")";
                                    color: root.queue-category == 2 ? Theme.accent-fg : Theme.text-secondary;
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                qc2-ta := TouchArea { mouse-cursor: pointer; clicked => { root.queue-category = 2; } }
                            }
                        }

                        // Category 0: Letras / Canciones / Playlists
                        if root.queue-category == 0 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 3px;
                                if root.queue-items.length == 0 : Text {
                                    text: "Usa '+ Cola' o envía una Playlist de canciones aquí.";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                for qitem[qidx] in root.queue-items : Rectangle {
                                    height: 30px;
                                    border-radius: Theme.radius-sm;
                                    background: q-ta.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: q-ta.has-hover ? Theme.border-medium : Theme.border-subtle;
                                    animate background { duration: 110ms; }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        Text {
                                            text: qitem.kind;
                                            color: Theme.accent-strong;
                                            font-size: 9.5px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: qitem.title;
                                            color: Theme.text-primary;
                                            font-size: 11.5px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    q-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.queue-item-clicked(qidx); }
                                    }
                                }
                            }
                        }

                        // Category 1: Videos
                        if root.queue-category == 1 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 3px;
                                if root.video-queue-items.length == 0 : Text {
                                    text: "En Multimedia, usa '+ Cola Videos' para encolar videos.";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                for vq[vqi] in root.video-queue-items : Rectangle {
                                    height: 30px;
                                    border-radius: Theme.radius-sm;
                                    background: vq.playing ? Theme.live-green.transparentize(0.82) : (qv-ta.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-1);
                                    border-width: 1px;
                                    border-color: vq.playing ? Theme.live-green : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        Text {
                                            text: vq.playing ? "▶" : ((vqi + 1) + ".");
                                            color: vq.playing ? Theme.live-green : Theme.text-muted;
                                            font-size: 10.5px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: vq.title;
                                            color: Theme.text-primary;
                                            font-size: 11.5px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    qv-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.play-video-queue-item(vqi); }
                                    }
                                }
                            }
                        }

                        // Category 2: Overlays PNG quick-toggle queue
                        if root.queue-category == 2 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 3px;
                                if root.overlay-queue-items.length == 0 : Text {
                                    text: "En el panel Capas > Overlays (izquierda), pulsa '+' para añadir aquí.";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                for oitem[oidx] in root.overlay-queue-items : Rectangle {
                                    height: 30px;
                                    border-radius: Theme.radius-sm;
                                    background: qo-ta.has-hover ? Theme.bg-surface-2 : Theme.bg-surface-1;
                                    border-width: 1px;
                                    border-color: qo-ta.has-hover ? Theme.border-medium : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        Text {
                                            text: oitem.kind;
                                            color: Theme.accent-strong;
                                            font-size: 9.5px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: oitem.title;
                                            color: Theme.text-primary;
                                            font-size: 11.5px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    qo-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.overlay-queue-clicked(oidx); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        }
    }

    // ── CLICK-OUTSIDE BACKDROP WHEN DYNAMIC ISLAND IS EXPANDED ──
    if root.island-expanded && !root.island-hidden && !root.is-style-editor-active && !root.song-editor-open : Rectangle {
        background: #00000044;
        TouchArea {
            clicked => { root.island-expanded = false; }
        }
    }

    // ── BOTTOM-DOCKED DYNAMIC ISLAND (Seamless concave Linux-dock corners + smooth spring hide/show/expand) ──
    ctx-island-wrap := Rectangle {
        property <bool> has-any-ctx: !root.is-style-editor-active && !root.song-editor-open && root.active-tab != 7 && (
            root.active-tab == 9
            || root.music-playing
            || root.island-expanded
            || ((root.active-tab == 0 || root.active-tab == 1) && root.slides.length > 0)
            || (root.active-tab == 10 && root.doc-pages.length > 0)
            || root.video-queue-playing
        );
        property <bool> show-music-mode: root.island-expanded || root.active-tab == 9
            || (root.music-playing && (root.island-prefer-music || (!((root.active-tab == 0 || root.active-tab == 1) && root.slides.length > 0) && !(root.active-tab == 10 && root.doc-pages.length > 0))));
        property <bool> has-other-ctx: ((root.active-tab == 0 || root.active-tab == 1) && root.slides.length > 0)
            || (root.active-tab == 10 && root.doc-pages.length > 0)
            || root.video-queue-playing;

        property <color> island-border-col: (self.show-music-mode && root.music-dynamic-eq)
            ? Theme.accent-strong
            : (self.show-music-mode && root.music-playing)
                ? Theme.accent.transparentize(0.25)
                : (root.audience-frozen ? #38bdf8 : Theme.border-medium);

        property <length> dock-w: root.island-hidden ? 156px
                                : (self.show-music-mode && root.island-expanded) ? 678px
                                : self.show-music-mode ? 652px
                                : (root.video-queue-playing && !((root.active-tab == 0 || root.active-tab == 1) && root.slides.length > 0) ? 530px : 386px);
        property <length> dock-h: root.island-hidden ? 24px
                                : (self.show-music-mode && root.island-expanded) ? 396px
                                : self.show-music-mode ? 54px : 44px;

        width: self.dock-w + 36px;
        height: self.dock-h;
        x: (parent.width - self.width) / 2;
        y: self.has-any-ctx ? (parent.height - self.height) : (parent.height + 12px);
        opacity: self.has-any-ctx ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate width   { duration: 280ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
        animate height  { duration: 280ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
        animate y       { duration: 300ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
        animate opacity { duration: 210ms; easing: ease-out; }

        // ── 1. SOLID FILL LAYER (NO borders here -> ZERO cutting lines at the bottom ears!) ──
        // Left concave ear fill
        Path {
            x: 0px;
            y: parent.height - 18px;
            width: 19px;
            height: 18px;
            viewbox-width: 19;
            viewbox-height: 18;
            fill: Theme.bg-surface-0;
            MoveTo { x: 19; y: 0; }
            ArcTo  { x: 0.5; y: 18; radius-x: 18; radius-y: 18; sweep: true; large-arc: false; }
            LineTo { x: 19; y: 18; }
            Close  {}
        }
        // Right concave ear fill
        Path {
            x: parent.width - 19px;
            y: parent.height - 18px;
            width: 19px;
            height: 18px;
            viewbox-width: 19;
            viewbox-height: 18;
            fill: Theme.bg-surface-0;
            MoveTo { x: 0; y: 0; }
            ArcTo  { x: 18.5; y: 18; radius-x: 18; radius-y: 18; sweep: false; large-arc: false; }
            LineTo { x: 0; y: 18; }
            Close  {}
        }

        // Main Body Fill + Content Container (border-width: 0px so it fuses 100% seamlessly with concave ears!)
        ctx-island := Rectangle {
            x: 18px;
            y: 0px;
            width: parent.width - 36px;
            height: parent.height;
            border-top-left-radius: root.island-hidden ? 12px : 20px;
            border-top-right-radius: root.island-hidden ? 12px : 20px;
            border-bottom-left-radius: 0px;
            border-bottom-right-radius: 0px;
            background: Theme.bg-surface-0;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000077;
            drop-shadow-offset-y: -4px;
            clip: true;

            // Specular Liquid Glass top rim on Dynamic Island
            Rectangle {
                y: 0px;
                width: 100%;
                height: 1px;
                background: @linear-gradient(90deg, transparent 0%, Theme.glass-rim-top 20%, Theme.glass-rim-top 80%, transparent 100%);
            }

            TouchArea {} // absorb inner clicks

            // ── STATE 0: HIDDEN PEEK TAB (Sleek miniature bottom notch — click to smoothly pop up!) ──
            if root.island-hidden : Rectangle {
                width: 100%;
                height: 100%;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 7px;
                    alignment: center;

                    Text {
                        text: "⌃";
                        color: peek-ta.has-hover ? Theme.accent-strong : Theme.text-secondary;
                        font-size: 13px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }

                    if root.music-playing && !root.music-paused : HorizontalLayout {
                        spacing: 1.5px;
                        alignment: center;
                        for barAmp[bi] in root.music-live-wave : Rectangle {
                            visible: bi < 6;
                            width: bi < 6 ? 2px : 0px;
                            height: Math.max(3px, Math.clamp(barAmp, 0.08, 1.0) * 14px);
                            y: (parent.height - self.height) / 2;
                            border-radius: 1px;
                            background: root.music-dynamic-eq ? Theme.accent-strong : Theme.accent;
                        }
                    }

                    Text {
                        text: root.music-playing ? "Música"
                            : ((root.active-tab == 0 || root.active-tab == 1) && root.slides.length > 0) ? "Estrofas"
                            : (root.active-tab == 10 && root.doc-pages.length > 0) ? "Páginas"
                            : "Controles";
                        color: peek-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                        font-size: 10.5px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                peek-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.island-hidden = false; }
                }
            }

            // Clickable Top Handle Pill (click to collapse expanded or hide compact!)
            if !root.island-hidden : Rectangle {
                x: (parent.width - 52px) / 2;
                y: 0px;
                width: 52px;
                height: 11px;
                z: 20;

                Rectangle {
                    x: (parent.width - 34px) / 2;
                    y: 4px;
                    width: 34px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: handle-ta.has-hover ? Theme.accent-strong : Theme.border-medium;
                    opacity: handle-ta.has-hover ? 1.0 : 0.72;
                    animate background { duration: 120ms; }
                }

                handle-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.island-expanded) {
                            root.island-expanded = false;
                        } else {
                            root.island-hidden = true;
                        }
                    }
                }
            }

            // ══════════════════════════════════════════════════════════════════
            //  CONTEXT A1: COMPACT MUSIC DYNAMIC ISLAND (Real 12-Band FFT Waves!)
            // ══════════════════════════════════════════════════════════════════
            if !root.island-hidden && ctx-island-wrap.show-music-mode && !root.island-expanded : HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 4px;
                spacing: 8px;

                // Clickable Track Cover + Live Waveform + Title (Click anywhere here to EXPAND!)
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 10px;
                    background: compact-info-ta.has-hover ? Theme.bg-surface-1 : transparent;
                    animate background { duration: 120ms; }

                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 6px;
                        spacing: 8px;

                        // Album Art
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 7px;
                            background: Theme.bg-surface-2;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            clip: true;

                            if root.has-music-now-cover : Image {
                                x: 0px; y: 0px; width: 100%; height: 100%;
                                source: root.music-now-cover;
                                image-fit: cover;
                            }
                            if !root.has-music-now-cover : Text {
                                text: "♫";
                                color: root.music-playing ? Theme.accent-strong : Theme.text-muted;
                                font-size: 15px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Live 12-Bar Audio Waveform Visualizer
                        Rectangle {
                            width: 44px;
                            height: 26px;
                            y: (parent.height - self.height) / 2;
                            background: transparent;

                            HorizontalLayout {
                                spacing: 1.5px;
                                alignment: center;
                                for barAmp in root.music-live-wave : Rectangle {
                                    width: 2.2px;
                                    height: Math.max(3px, Math.clamp(barAmp, 0.08, 1.0) * 24px);
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 1.1px;
                                    background: root.music-dynamic-eq ? Theme.accent-strong
                                              : (root.music-playing && !root.music-paused ? Theme.accent : Theme.text-muted);
                                    animate height { duration: 60ms; }
                                }
                            }
                        }

                        // Title + Time + Mini Scrub
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: root.music-now-playing;
                                    color: Theme.text-primary;
                                    font-size: 11.5px;
                                    font-weight: 700;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                if root.music-dynamic-eq : Rectangle {
                                    height: 15px;
                                    width: 44px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 4px;
                                    background: Theme.accent.transparentize(0.75);
                                    border-width: 1px;
                                    border-color: Theme.accent;
                                    Text { text: "⚡DYN"; color: Theme.accent-strong; font-size: 8.5px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Text {
                                    text: root.music-time-label;
                                    color: Theme.text-muted;
                                    font-size: 9.5px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            music-island-scrub := ScrubBar {
                                value <=> root.music-position;
                                seeked(v) => { root.music-seek-changed(v); }
                                changed dragging => { root.music-seeking = self.dragging; }
                            }
                        }
                    }

                    compact-info-ta := TouchArea {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 22px;
                        mouse-cursor: pointer;
                        clicked => { root.island-expanded = true; }
                    }
                }

                // Perfectly Uniform & Aligned 30x30 Controls
                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;

                    IslandIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("icons/prev.svg");
                        clicked => { root.music-prev(); }
                    }
                    IslandIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: (root.music-paused || !root.music-playing) ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                        accent-filled: root.music-playing && !root.music-paused;
                        clicked => { root.music-toggle-pause(); }
                    }
                    IslandIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("icons/stop.svg");
                        danger: true;
                        clicked => { root.music-stop(); }
                    }
                    IslandIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("icons/next.svg");
                        clicked => { root.music-next(); }
                    }
                    IslandIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("icons/repeat.svg");
                        active: root.music-loop;
                        clicked => { root.music-toggle-loop(); }
                    }
                    IslandIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("icons/sliders.svg");
                        active: root.music-eq-enabled || root.music-dynamic-eq;
                        clicked => { root.island-expanded = true; }
                    }
                    if ctx-island-wrap.has-other-ctx && root.active-tab != 9 : IslandIconButton {
                        y: (parent.height - self.height) / 2;
                        label: "≡";
                        clicked => { root.island-prefer-music = false; }
                    }
                    IslandIconButton {
                        y: (parent.height - self.height) / 2;
                        label: "⌄";
                        clicked => { root.island-hidden = true; }
                    }
                }
            }

            // ══════════════════════════════════════════════════════════════════
            //  CONTEXT A2: EXPANDED DYNAMIC ISLAND AUDIO STUDIO (Real FFT + Waveform + 5-Band EQ + Dynamic EQ)
            // ══════════════════════════════════════════════════════════════════
            if !root.island-hidden && ctx-island-wrap.show-music-mode && root.island-expanded : VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 12px;
                spacing: 10px;

                // Row 1: Large Album Art + Full Readable Track Name + Live Waveform Bars + Collapse Button
                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        width: 62px;
                        height: 62px;
                        border-radius: 10px;
                        background: Theme.bg-surface-2;
                        border-width: 1px;
                        border-color: Theme.border-medium;
                        clip: true;

                        if root.has-music-now-cover : Image {
                            x: 0px; y: 0px; width: 100%; height: 100%;
                            source: root.music-now-cover;
                            image-fit: cover;
                        }
                        if !root.has-music-now-cover : Text {
                            text: "♫";
                            color: root.music-playing ? Theme.accent-strong : Theme.text-muted;
                            font-size: 26px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 3px;

                        Text {
                            text: root.music-now-playing;
                            color: Theme.text-primary;
                            font-size: 14.5px;
                            font-weight: 800;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.music-now-subtitle;
                                color: Theme.text-secondary;
                                font-size: 11px;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.music-time-label;
                                color: Theme.accent-strong;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Live 12-Bar Output Level Visualizer
                    Rectangle {
                        width: 58px;
                        height: 44px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 8px;
                        background: Theme.bg-surface-1;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        HorizontalLayout {
                            padding: 5px;
                            spacing: 2px;
                            alignment: center;
                            for barAmp in root.music-live-wave : Rectangle {
                                width: 2.5px;
                                height: Math.max(4px, Math.clamp(barAmp, 0.08, 1.0) * 32px);
                                y: (parent.height - self.height) / 2;
                                border-radius: 1.25px;
                                background: root.music-dynamic-eq ? Theme.accent-strong : Theme.accent;
                                animate height { duration: 55ms; }
                            }
                        }
                    }

                    IslandIconButton {
                        y: 0px;
                        label: "▼";
                        clicked => { root.island-expanded = false; }
                    }
                }

                // Row 2: Interactive 40-Bar Real Audio Waveform ScrubBar (click/drag anywhere to seek!)
                wave-scrub := Rectangle {
                    height: 44px;
                    border-radius: 9px;
                    background: Theme.bg-surface-1;
                    border-width: 1px;
                    border-color: wave-ta.has-hover ? Theme.border-accent : Theme.border-subtle;
                    clip: true;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 3px;
                        alignment: stretch;

                        for amp[widx] in root.music-track-waveform : Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                            property <bool> is-played: (widx / Math.max(1, root.music-track-waveform.length)) <= root.music-position;

                            Rectangle {
                                width: 100%;
                                height: Math.max(4px, Math.clamp(amp, 0.08, 1.0) * 34px);
                                y: (parent.height - self.height) / 2;
                                border-radius: 2px;
                                background: parent.is-played ? Theme.accent : Theme.text-muted.transparentize(0.55);
                                animate background { duration: 90ms; }
                            }
                        }
                    }

                    // Playhead cursor line
                    Rectangle {
                        x: Math.clamp(root.music-position, 0.0, 1.0) * (parent.width - 16px) + 8px;
                        y: 3px;
                        width: 2px;
                        height: parent.height - 6px;
                        border-radius: 1px;
                        background: Theme.accent-strong;
                    }

                    wave-ta := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down || (ev.kind == PointerEventKind.move && self.pressed)) {
                                root.music-seeking = true;
                                root.music-position = Math.clamp((self.mouse-x - 8px) / Math.max(1px, parent.width - 16px), 0.0, 1.0);
                            } else if (ev.kind == PointerEventKind.up) {
                                root.music-position = Math.clamp((self.mouse-x - 8px) / Math.max(1px, parent.width - 16px), 0.0, 1.0);
                                root.music-seeking = false;
                                root.music-seek-changed(root.music-position);
                            }
                        }
                    }
                }

                // Row 3: Uniform Aligned Transport Controls + Volume Slider
                HorizontalLayout {
                    spacing: 6px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 5px;
                        IslandIconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/prev.svg"); clicked => { root.music-prev(); } }
                        IslandIconButton {
                            y: (parent.height - self.height) / 2;
                            icon: (root.music-paused || !root.music-playing) ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                            accent-filled: root.music-playing && !root.music-paused;
                            clicked => { root.music-toggle-pause(); }
                        }
                        IslandIconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/stop.svg"); danger: true; clicked => { root.music-stop(); } }
                        IslandIconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/next.svg"); clicked => { root.music-next(); } }
                        IslandIconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/repeat.svg"); active: root.music-loop; clicked => { root.music-toggle-loop(); } }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Image {
                            source: root.music-volume <= 1.0 ? @image-url("icons/volume_off.svg") : @image-url("icons/volume.svg");
                            width: 15px;
                            height: 15px;
                            y: (parent.height - self.height) / 2;
                            colorize: Theme.text-secondary;
                        }
                        Slider {
                            width: 150px;
                            minimum: 0;
                            maximum: 150;
                            value <=> root.music-volume;
                            changed(v) => { root.music-volume-changed(v); }
                        }
                        Text {
                            text: Math.round(root.music-volume) + "%";
                            color: Theme.text-secondary;
                            font-size: 11px;
                            font-weight: 700;
                            width: 38px;
                            vertical-alignment: center;
                        }
                    }
                }

                // Row 4: 5-Band Audio Equalizer & ProyecThor Dynamic EQ Engine
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 10px;
                    background: Theme.bg-surface-1;
                    border-width: 1px;
                    border-color: root.music-dynamic-eq ? Theme.border-accent : Theme.border-subtle;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 7px;

                        // EQ Header: 5-Band Toggle + Dynamic EQ Toggle + Presets
                        HorizontalLayout {
                            alignment: space-between;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 5px;
                                GlassButton {
                                    label: root.music-eq-enabled ? "EQ 5 Bandas: ON" : "EQ 5 Bandas: OFF";
                                    icon: @image-url("icons/sliders.svg");
                                    has-icon: true;
                                    compact: true;
                                    primary: root.music-eq-enabled;
                                    clicked => {
                                        root.music-eq-enabled = !root.music-eq-enabled;
                                        root.music-eq-changed();
                                    }
                                }
                                GlassButton {
                                    label: root.music-dynamic-eq ? "⚡ EQ Dinámica: ON" : "⚡ EQ Dinámica";
                                    compact: true;
                                    primary: root.music-dynamic-eq;
                                    clicked => {
                                        root.music-dynamic-eq = !root.music-dynamic-eq;
                                        root.music-dynamic-eq-toggled(root.music-dynamic-eq);
                                    }
                                }
                            }

                            // Instant EQ Presets
                            HorizontalLayout {
                                spacing: 3px;
                                GlassButton { label: "Plano";    compact: true; primary: root.music-eq-enabled && root.music-eq-preset == 0; clicked => { root.music-eq-preset-selected(0); } }
                                GlassButton { label: "Alabanza"; compact: true; primary: root.music-eq-enabled && root.music-eq-preset == 1; clicked => { root.music-eq-preset-selected(1); } }
                                GlassButton { label: "Voz";      compact: true; primary: root.music-eq-enabled && root.music-eq-preset == 2; clicked => { root.music-eq-preset-selected(2); } }
                                GlassButton { label: "Acústico"; compact: true; primary: root.music-eq-enabled && root.music-eq-preset == 3; clicked => { root.music-eq-preset-selected(3); } }
                                GlassButton { label: "Bajos";    compact: true; primary: root.music-eq-enabled && root.music-eq-preset == 4; clicked => { root.music-eq-preset-selected(4); } }
                                GlassButton { label: "Estudio";  compact: true; primary: root.music-eq-enabled && root.music-eq-preset == 5; clicked => { root.music-eq-preset-selected(5); } }
                            }
                        }

                        // Dynamic EQ Live Telemetry Line
                        Text {
                            text: root.music-dynamic-eq-status;
                            color: root.music-dynamic-eq ? Theme.accent-strong : Theme.text-muted;
                            font-size: 10px;
                            font-weight: root.music-dynamic-eq ? 700 : 500;
                            overflow: elide;
                        }

                        // 5 Parametric Frequency Band Sliders
                        HorizontalLayout {
                            spacing: 10px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "60 Hz"; color: Theme.text-secondary; font-size: 10px; font-weight: 700; }
                                    Text { text: Math.round(root.music-eq-60) + " dB"; color: Theme.accent-strong; font-size: 10px; font-weight: 700; }
                                }
                                Slider { minimum: -12; maximum: 12; value <=> root.music-eq-60; changed => { root.music-eq-enabled = true; root.music-eq-preset = -1; root.music-eq-changed(); } }
                                Text { text: "Sub / Graves"; color: Theme.text-muted; font-size: 9px; horizontal-alignment: center; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "230 Hz"; color: Theme.text-secondary; font-size: 10px; font-weight: 700; }
                                    Text { text: Math.round(root.music-eq-230) + " dB"; color: Theme.accent-strong; font-size: 10px; font-weight: 700; }
                                }
                                Slider { minimum: -12; maximum: 12; value <=> root.music-eq-230; changed => { root.music-eq-enabled = true; root.music-eq-preset = -1; root.music-eq-changed(); } }
                                Text { text: "Cuerpo"; color: Theme.text-muted; font-size: 9px; horizontal-alignment: center; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "910 Hz"; color: Theme.text-secondary; font-size: 10px; font-weight: 700; }
                                    Text { text: Math.round(root.music-eq-910) + " dB"; color: Theme.accent-strong; font-size: 10px; font-weight: 700; }
                                }
                                Slider { minimum: -12; maximum: 12; value <=> root.music-eq-910; changed => { root.music-eq-enabled = true; root.music-eq-preset = -1; root.music-eq-changed(); } }
                                Text { text: "Medios / Voz"; color: Theme.text-muted; font-size: 9px; horizontal-alignment: center; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "3.6 kHz"; color: Theme.text-secondary; font-size: 10px; font-weight: 700; }
                                    Text { text: Math.round(root.music-eq-3600) + " dB"; color: Theme.accent-strong; font-size: 10px; font-weight: 700; }
                                }
                                Slider { minimum: -12; maximum: 12; value <=> root.music-eq-3600; changed => { root.music-eq-enabled = true; root.music-eq-preset = -1; root.music-eq-changed(); } }
                                Text { text: "Presencia"; color: Theme.text-muted; font-size: 9px; horizontal-alignment: center; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "12 kHz"; color: Theme.text-secondary; font-size: 10px; font-weight: 700; }
                                    Text { text: Math.round(root.music-eq-12000) + " dB"; color: Theme.accent-strong; font-size: 10px; font-weight: 700; }
                                }
                                Slider { minimum: -12; maximum: 12; value <=> root.music-eq-12000; changed => { root.music-eq-enabled = true; root.music-eq-preset = -1; root.music-eq-changed(); } }
                                Text { text: "Brillo / Aire"; color: Theme.text-muted; font-size: 9px; horizontal-alignment: center; }
                            }
                        }
                    }
                }
            }

            // ══════════════════════════════════════════════════════════════════
            //  CONTEXT B: SLIDES NAVIGATION ISLAND (Canciones / Biblia) — Uniform Aligned Buttons
            // ══════════════════════════════════════════════════════════════════
            if !root.island-hidden && !ctx-island-wrap.show-music-mode && (root.active-tab == 0 || root.active-tab == 1) && root.slides.length > 0 : HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 5px;
                padding-bottom: 3px;
                spacing: 6px;
                alignment: center;

                IslandIconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/prev.svg"); clicked => { root.prev-slide(); } }
                Text {
                    text: (root.active-slide-index >= 0 ? (root.active-slide-index + 1) : 0) + " / " + root.slides.length;
                    color: Theme.text-primary;
                    font-size: 12px;
                    font-weight: 800;
                    vertical-alignment: center;
                    width: 58px;
                    horizontal-alignment: center;
                }
                IslandIconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/next.svg"); clicked => { root.next-slide(); } }
                Rectangle { width: 1px; height: 18px; y: (parent.height - self.height) / 2; background: Theme.border-subtle; }
                IslandIconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/trash.svg"); danger: true; clicked => { root.clear-text(); } }
                IslandIconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/snowflake.svg"); active: root.audience-frozen; clicked => { root.toggle-freeze(); } }
                if root.music-playing : IslandIconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/headphones.svg");
                    accent-filled: true;
                    clicked => { root.island-prefer-music = true; }
                }
                IslandIconButton { y: (parent.height - self.height) / 2; label: "⌄"; clicked => { root.island-hidden = true; } }
            }

            // ══════════════════════════════════════════════════════════════════
            //  CONTEXT C: DOCUMENT PAGES ISLAND (Documentos) — Uniform Aligned Buttons
            // ══════════════════════════════════════════════════════════════════
            if !root.island-hidden && !ctx-island-wrap.show-music-mode && root.active-tab == 10 && root.doc-pages.length > 0 : HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 5px;
                padding-bottom: 3px;
                spacing: 6px;
                alignment: center;

                IslandIconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/prev.svg"); clicked => { root.doc-prev-page(); } }
                Text {
                    text: "Pág. " + (root.active-doc-page-idx >= 0 ? (root.active-doc-page-idx + 1) : 0) + " / " + root.doc-pages.length;
                    color: Theme.text-primary;
                    font-size: 11.5px;
                    font-weight: 800;
                    vertical-alignment: center;
                    width: 82px;
                    horizontal-alignment: center;
                }
                IslandIconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/next.svg"); clicked => { root.doc-next-page(); } }
                Rectangle { width: 1px; height: 18px; y: (parent.height - self.height) / 2; background: Theme.border-subtle; }
                IslandIconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/snowflake.svg"); active: root.audience-frozen; clicked => { root.toggle-freeze(); } }
                if root.music-playing : IslandIconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/headphones.svg");
                    accent-filled: true;
                    clicked => { root.island-prefer-music = true; }
                }
                IslandIconButton { y: (parent.height - self.height) / 2; label: "⌄"; clicked => { root.island-hidden = true; } }
            }

            // ══════════════════════════════════════════════════════════════════
            //  CONTEXT D: VIDEO QUEUE ISLAND — Uniform Aligned Buttons
            // ══════════════════════════════════════════════════════════════════
            if !root.island-hidden && !ctx-island-wrap.show-music-mode && root.video-queue-playing && !((root.active-tab == 0 || root.active-tab == 1) && root.slides.length > 0) && !(root.active-tab == 10 && root.doc-pages.length > 0) : HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                padding-top: 5px;
                padding-bottom: 3px;
                spacing: 8px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: root.live-bg-name; color: Theme.text-primary; font-size: 11px; font-weight: 700; overflow: elide; horizontal-stretch: 1; }
                        Text { text: root.media-time-label; color: Theme.text-muted; font-size: 9.5px; }
                    }
                    vid-island-scrub := ScrubBar {
                        value <=> root.media-position;
                        seeked(v) => { root.seek-changed(v); }
                        changed dragging => { root.media-seeking = self.dragging; }
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    IslandIconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/prev.svg"); clicked => { root.prev-video-queue(); } }
                    IslandIconButton { y: (parent.height - self.height) / 2; icon: root.media-paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg"); accent-filled: !root.media-paused; clicked => { root.toggle-pause(); } }
                    IslandIconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/stop.svg"); danger: true; clicked => { root.stop-media(); } }
                    IslandIconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/next.svg"); clicked => { root.next-video-queue(); } }
                    IslandIconButton { y: (parent.height - self.height) / 2; label: "⌄"; clicked => { root.island-hidden = true; } }
                }
            }
        }

        // ── 2. SEAMLESS OUTER BORDER OVERLAY (Clipped strictly above concave ears — ZERO cutting line!) ──
        Rectangle {
            x: 18px;
            y: 0px;
            width: parent.width - 36px;
            height: Math.max(0px, parent.height - 18px);
            clip: true;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height + 24px;
                border-top-left-radius: root.island-hidden ? 10px : 16px;
                border-top-right-radius: root.island-hidden ? 10px : 16px;
                border-width: 1.25px;
                border-color: ctx-island-wrap.island-border-col;
            }
        }
        // Left concave border stroke (meets clipped left wall tangentially at exact y = H - 18px!)
        Path {
            x: 0px;
            y: parent.height - 18px;
            width: 19px;
            height: 18px;
            viewbox-width: 19;
            viewbox-height: 18;
            stroke: ctx-island-wrap.island-border-col;
            stroke-width: 1.25px;
            MoveTo { x: 18.625; y: 0; }
            ArcTo  { x: 0.625; y: 18; radius-x: 18; radius-y: 18; sweep: true; large-arc: false; }
        }
        // Right concave border stroke (meets clipped right wall tangentially at exact y = H - 18px!)
        Path {
            x: parent.width - 19px;
            y: parent.height - 18px;
            width: 19px;
            height: 18px;
            viewbox-width: 19;
            viewbox-height: 18;
            stroke: ctx-island-wrap.island-border-col;
            stroke-width: 1.25px;
            MoveTo { x: 0.375; y: 0; }
            ArcTo  { x: 18.375; y: 18; radius-x: 18; radius-y: 18; sweep: false; large-arc: false; }
        }
    }

    // ── FLOATING POPOVER: Menú Desplegable de Biblioteca (desde el ícono carpeta superior) ──
    if root.library-menu-open : Rectangle {
        background: #00000030;

        TouchArea {
            clicked => { root.library-menu-open = false; }
        }

        Rectangle {
            x: 16px;
            y: 58px;
            width: 210px;
            height: 244px;
            border-radius: Theme.radius-lg;
            background: Theme.bg-surface-0;
            border-width: 1.5px;
            border-color: Theme.border-medium;
            clip: true;

            TouchArea {} // absorb inner clicks

            VerticalLayout {
                padding: 8px;
                spacing: 5px;

                GlassButton {
                    label: "Biblioteca";
                    icon: @image-url("icons/folder.svg");
                    has-icon: true;
                    primary: root.active-tab == 13;
                    clicked => { root.active-tab = 13; root.library-menu-open = false; }
                }
                GlassButton {
                    label: "Canciones";
                    icon: @image-url("icons/music.svg");
                    has-icon: true;
                    primary: root.active-tab == 0;
                    clicked => { root.active-tab = 0; root.library-menu-open = false; }
                }
                GlassButton {
                    label: "Biblia";
                    icon: @image-url("icons/book.svg");
                    has-icon: true;
                    primary: root.active-tab == 1;
                    clicked => { root.active-tab = 1; root.library-menu-open = false; }
                }
                GlassButton {
                    label: "Multimedia";
                    icon: @image-url("icons/film.svg");
                    has-icon: true;
                    primary: root.active-tab == 2;
                    clicked => { root.active-tab = 2; root.library-menu-open = false; }
                }
                GlassButton {
                    label: "Música";
                    icon: @image-url("icons/headphones.svg");
                    has-icon: true;
                    primary: root.active-tab == 9;
                    clicked => { root.active-tab = 9; root.library-menu-open = false; }
                }
                GlassButton {
                    label: "Documentos";
                    icon: @image-url("icons/file_text.svg");
                    has-icon: true;
                    primary: root.active-tab == 10;
                    clicked => { root.active-tab = 10; root.library-menu-open = false; }
                }
            }
        }
    }

    // ── FLOATING POPOVER: Menú Desplegable de Estilos y Diseño (Estilos, Shaders, Transiciones, Pads) ──
    if root.design-menu-open : Rectangle {
        background: #00000030;

        TouchArea {
            clicked => { root.design-menu-open = false; }
        }

        Rectangle {
            x: 106px;
            y: 58px;
            width: 222px;
            height: 170px;
            border-radius: Theme.radius-lg;
            background: Theme.bg-surface-0;
            border-width: 1.5px;
            border-color: Theme.border-medium;
            clip: true;

            TouchArea {} // absorb inner clicks

            VerticalLayout {
                padding: 8px;
                spacing: 5px;

                GlassButton {
                    label: "Estilos de Letras";
                    icon: @image-url("icons/palette.svg");
                    has-icon: true;
                    primary: root.active-tab == 4 && root.design-subtab == 0;
                    clicked => { root.active-tab = 4; root.design-subtab = 0; root.design-menu-open = false; }
                }
                GlassButton {
                    label: "Shaders y Filtros";
                    icon: @image-url("icons/sliders.svg");
                    has-icon: true;
                    primary: root.active-tab == 4 && root.design-subtab == 1;
                    clicked => { root.active-tab = 4; root.design-subtab = 1; root.design-menu-open = false; }
                }
                GlassButton {
                    label: "Transiciones";
                    icon: @image-url("icons/shuffle.svg");
                    has-icon: true;
                    primary: root.active-tab == 4 && root.design-subtab == 2;
                    clicked => { root.active-tab = 4; root.design-subtab = 2; root.design-menu-open = false; }
                }
                GlassButton {
                    label: "Pads de Escena";
                    icon: @image-url("icons/grid.svg");
                    has-icon: true;
                    primary: root.active-tab == 6;
                    clicked => { root.active-tab = 6; root.design-menu-open = false; }
                }
            }
        }
    }

    // ── FLOATING POPOVER: Menú Desplegable de Redes (LAN, Chat, Celular, Reloj, Luces OSC) ──
    if root.net-menu-open : Rectangle {
        background: #00000030;

        TouchArea {
            clicked => { root.net-menu-open = false; }
        }

        Rectangle {
            x: 196px;
            y: 58px;
            width: 234px;
            height: 207px;
            border-radius: Theme.radius-lg;
            background: Theme.bg-surface-0;
            border-width: 1.5px;
            border-color: Theme.border-medium;
            clip: true;

            TouchArea {} // absorb inner clicks

            VerticalLayout {
                padding: 8px;
                spacing: 5px;

                GlassButton {
                    label: "Video LAN y Smart TV";
                    icon: @image-url("icons/wifi.svg");
                    has-icon: true;
                    primary: root.active-tab == 5 && root.net-subtab == 0;
                    clicked => { root.active-tab = 5; root.net-subtab = 0; root.net-menu-open = false; }
                }
                GlassButton {
                    label: "Chat LAN de Equipo";
                    icon: @image-url("icons/chat.svg");
                    has-icon: true;
                    primary: root.active-tab == 5 && root.net-subtab == 1;
                    clicked => { root.active-tab = 5; root.net-subtab = 1; root.net-menu-open = false; }
                }
                GlassButton {
                    label: "Control Celular";
                    icon: @image-url("icons/smartphone.svg");
                    has-icon: true;
                    primary: root.active-tab == 5 && root.net-subtab == 2;
                    clicked => { root.active-tab = 5; root.net-subtab = 2; root.net-menu-open = false; }
                }
                GlassButton {
                    label: "Reloj y Temporizador";
                    icon: @image-url("icons/clock.svg");
                    has-icon: true;
                    primary: root.active-tab == 5 && root.net-subtab == 3;
                    clicked => { root.active-tab = 5; root.net-subtab = 3; root.net-menu-open = false; }
                }
                GlassButton {
                    label: "Luces OSC";
                    icon: @image-url("icons/zap.svg");
                    has-icon: true;
                    primary: root.active-tab == 5 && root.net-subtab == 4;
                    clicked => { root.active-tab = 5; root.net-subtab = 4; root.net-menu-open = false; }
                }
            }
        }
    }

    // ── FLOATING POPOVER: Modo de Escalado / Aspect Ratio & AMD FSR ──
    if root.scale-menu-open : Rectangle {
        background: #00000038;

        TouchArea {
            clicked => { root.scale-menu-open = false; }
        }

        Rectangle {
            x: Math.max(24px, parent.width - 384px);
            y: 58px;
            width: 368px;
            height: 492px;
            border-radius: Theme.radius-lg;
            background: Theme.bg-surface-0;
            border-width: 1.5px;
            border-color: Theme.border-medium;
            clip: true;

            TouchArea {} // absorb inner clicks

            VerticalLayout {
                padding: 13px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Escalado, Resolución, FPS y Super-Res"; color: Theme.text-primary; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                    GlassButton { label: "✕"; compact: true; clicked => { root.scale-menu-open = false; } }
                }

                GlassButton {
                    label: "Recortar / Llenar (Cover — Sin barras negras)";
                    primary: root.bg-scale-mode == 0;
                    clicked => { root.bg-scale-mode = 0; root.scale-mode-changed(0); }
                }
                GlassButton {
                    label: "Estirar a Pantalla Completa (Fill 16:9)";
                    primary: root.bg-scale-mode == 1;
                    clicked => { root.bg-scale-mode = 1; root.scale-mode-changed(1); }
                }
                GlassButton {
                    label: "Tamaño Original / Ajustar (Contain — Sin recortar)";
                    primary: root.bg-scale-mode == 2;
                    clicked => { root.bg-scale-mode = 2; root.scale-mode-changed(2); }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                Text { text: "Resolución de Salida (Imágenes y Video)"; color: Theme.text-secondary; font-size: 11px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 4px;
                    GlassButton { label: "720p";  compact: true; horizontal-stretch: 1; primary: root.output-res-preset == 0; clicked => { root.output-res-preset = 0; root.output-res-changed(0); } }
                    GlassButton { label: "1080p"; compact: true; horizontal-stretch: 1; primary: root.output-res-preset == 1; clicked => { root.output-res-preset = 1; root.output-res-changed(1); } }
                    GlassButton { label: "2160p"; compact: true; horizontal-stretch: 1; primary: root.output-res-preset == 4; clicked => { root.output-res-preset = 4; root.output-res-changed(4); } }
                    GlassButton { label: "16:10"; compact: true; horizontal-stretch: 1; primary: root.output-res-preset == 2; clicked => { root.output-res-preset = 2; root.output-res-changed(2); } }
                    GlassButton { label: "4:3";   compact: true; horizontal-stretch: 1; primary: root.output-res-preset == 3; clicked => { root.output-res-preset = 3; root.output-res-changed(3); } }
                }

                Text { text: "Límite de FPS de Video (Entrega Asíncrona Directa)"; color: Theme.text-secondary; font-size: 11px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 4px;
                    GlassButton { label: "30 FPS";  compact: true; horizontal-stretch: 1; primary: root.target-fps == 30;  clicked => { root.target-fps = 30;  root.target-fps-changed(30); } }
                    GlassButton { label: "60 FPS";  compact: true; horizontal-stretch: 1; primary: root.target-fps == 60;  clicked => { root.target-fps = 60;  root.target-fps-changed(60); } }
                    GlassButton { label: "120 FPS"; compact: true; horizontal-stretch: 1; primary: root.target-fps == 120; clicked => { root.target-fps = 120; root.target-fps-changed(120); } }
                    GlassButton {
                        label: "24→60";
                        compact: true;
                        primary: root.smooth-motion-60;
                        clicked => {
                            root.smooth-motion-60 = !root.smooth-motion-60;
                            if (root.smooth-motion-60 && root.target-fps < 60) {
                                root.target-fps = 60;
                                root.target-fps-changed(60);
                            }
                            root.gpu-config-changed();
                        }
                    }
                }

                Text { text: "Super-Resolución / Reescalado en Tiempo Real"; color: Theme.text-secondary; font-size: 11px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 4px;
                    GlassButton { label: "Off";     compact: true; horizontal-stretch: 1; primary: root.upscaler-mode == 0; clicked => { root.upscaler-mode = 0; root.gpu-config-changed(); } }
                    GlassButton { label: "FSR 1";   compact: true; horizontal-stretch: 1; primary: root.upscaler-mode == 1; clicked => { root.upscaler-mode = 1; root.gpu-config-changed(); } }
                    GlassButton { label: "CAS+";    compact: true; horizontal-stretch: 1; primary: root.upscaler-mode == 2; clicked => { root.upscaler-mode = 2; root.gpu-config-changed(); } }
                    GlassButton { label: "NIS";     compact: true; horizontal-stretch: 1; primary: root.upscaler-mode == 3; clicked => { root.upscaler-mode = 3; root.gpu-config-changed(); } }
                    GlassButton { label: "Lanczos"; compact: true; horizontal-stretch: 1; primary: root.upscaler-mode == 4; clicked => { root.upscaler-mode = 4; root.gpu-config-changed(); } }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                SwitchRow {
                    title: "Salida Público Pantalla Completa";
                    subtitle: "Pulsa Esc en cualquier momento para cerrar salida";
                    checked <=> root.fullscreen-output;
                    toggled(v) => { root.fullscreen-changed(v); }
                }
            }
        }
    }

    // ── FLOATING DROPDOWN OVERLAY: Selector de Versiones de Biblia (Wayland/Hyprland safe) ──
    if root.bible-version-menu-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000044;

        TouchArea {
            clicked => { root.bible-version-menu-open = false; }
        }

        Rectangle {
            x: Math.max(24px, parent.width - 700px);
            y: 112px;
            width: 340px;
            height: Math.min(390px, Math.max(120px, root.bible-version-names.length * 38px + 54px));
            border-radius: Theme.radius-lg;
            background: Theme.bg-surface-0;
            border-width: 1.5px;
            border-color: Theme.border-medium;
            clip: true;

            TouchArea {} // absorb clicks inside dropdown

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Versiones de Biblia (" + root.bible-version-names.length + ")";
                        color: Theme.text-primary;
                        font-size: 12.5px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    GlassButton {
                        label: "✕";
                        clicked => { root.bible-version-menu-open = false; }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        padding-right: 4px;

                        if root.bible-version-names.length == 0 : Text {
                            text: "No se encontraron archivos .xml en assets/bibles.";
                            color: Theme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        for verName[vidx] in root.bible-version-names : Rectangle {
                            height: 34px;
                            border-radius: Theme.radius-sm;
                            background: vidx == root.selected-bible-version-idx
                                ? Theme.accent
                                : (bv-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-1);
                            border-width: 1px;
                            border-color: vidx == root.selected-bible-version-idx
                                ? Theme.accent-strong
                                : Theme.border-subtle;
                            animate background { duration: 110ms; }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;
                                Text {
                                    text: verName;
                                    color: vidx == root.selected-bible-version-idx ? Theme.accent-fg : Theme.text-primary;
                                    font-size: 12px;
                                    font-weight: vidx == root.selected-bible-version-idx ? 700 : 500;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if vidx == root.selected-bible-version-idx : Text {
                                    text: "✓";
                                    color: Theme.accent-fg;
                                    font-size: 12px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }
                            }

                            bv-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selected-bible-version-idx = vidx;
                                    root.bible-version-menu-open = false;
                                    root.bible-version-selected(vidx);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── FLOATING MODAL: Selector de Fuentes del Sistema (con vista previa real en cada fuente) ──
    if root.font-picker-open : Rectangle {
        background: #00000055;

        TouchArea {
            clicked => { root.font-picker-open = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max(64px, (parent.height - self.height) / 2);
            width: 420px;
            height: Math.min(520px, parent.height - 110px);
            border-radius: Theme.radius-lg;
            background: Theme.bg-surface-0;
            border-width: 1.5px;
            border-color: Theme.border-medium;
            clip: true;

            TouchArea {} // absorb inner clicks

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.font-picker-target == 1 ? "Elegir Fuente — Índice Biblia" : "Elegir Fuente — Letras";
                        color: Theme.text-primary;
                        font-size: 13.5px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    GlassButton { label: "✕"; compact: true; clicked => { root.font-picker-open = false; } }
                }

                LineEdit {
                    placeholder-text: "Buscar fuente instalada (ej. Noto, Serif, DejaVu, Arial)...";
                    text <=> root.font-picker-search;
                    edited(txt) => { root.font-search-changed(txt); }
                }

                GlassButton {
                    label: "Predeterminada del Sistema";
                    compact: true;
                    primary: (root.font-picker-target == 1 ? root.index-font-family-name : root.font-family-name) == "";
                    clicked => {
                        root.system-font-selected(root.font-picker-target, "");
                        root.font-picker-open = false;
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 4px;
                        padding-right: 4px;

                        for fname in root.system-font-names : Rectangle {
                            height: 36px;
                            border-radius: Theme.radius-sm;
                            background: (root.font-picker-target == 1 ? root.index-font-family-name : root.font-family-name) == fname
                                ? Theme.accent
                                : (fp-ta.has-hover ? Theme.bg-surface-hover : Theme.bg-surface-1);
                            border-width: 1px;
                            border-color: (root.font-picker-target == 1 ? root.index-font-family-name : root.font-family-name) == fname
                                ? Theme.accent-strong
                                : Theme.border-subtle;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;
                                Text {
                                    text: fname;
                                    font-family: fname;
                                    color: (root.font-picker-target == 1 ? root.index-font-family-name : root.font-family-name) == fname ? Theme.accent-fg : Theme.text-primary;
                                    font-size: 13.5px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: "Aa";
                                    font-family: fname;
                                    color: (root.font-picker-target == 1 ? root.index-font-family-name : root.font-family-name) == fname ? Theme.accent-fg : Theme.text-muted;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            fp-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.system-font-selected(root.font-picker-target, fname);
                                    root.font-picker-open = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── FLOATING MODAL: Gestión Unificada de Archivo (Acciones / Cambiar Nombre / Eliminar) ──
    if root.item-modal-open : Rectangle {
        background: #00000066;

        TouchArea {
            clicked => { root.item-modal-open = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max(72px, (parent.height - self.height) / 2);
            width: 396px;
            height: root.item-modal-mode == 0 ? 276px : (root.item-modal-mode == 1 ? 210px : 216px);
            border-radius: Theme.radius-lg;
            background: Theme.bg-surface-0;
            border-width: 1.5px;
            border-color: root.item-modal-mode == 2 ? #ef444488 : Theme.border-medium;
            clip: true;
            animate height       { duration: 150ms; easing: ease-out; }
            animate border-color { duration: 150ms; easing: ease-out; }

            TouchArea {} // absorb inner clicks

            VerticalLayout {
                padding: 16px;
                spacing: 11px;

                // Header with category pill + item title + close button
                HorizontalLayout {
                    alignment: space-between;
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                height: 18px;
                                width: im-kind-txt.preferred-width + 12px;
                                border-radius: 4px;
                                background: root.item-modal-mode == 2 ? #ef444428 : Theme.bg-surface-2;
                                border-width: 1px;
                                border-color: root.item-modal-mode == 2 ? #ef444466 : Theme.border-subtle;
                                im-kind-txt := Text {
                                    text: root.item-modal-kind == 0 ? "CANCIÓN"
                                        : root.item-modal-kind == 1 ? "MULTIMEDIA"
                                        : root.item-modal-kind == 2 ? "DOCUMENTO"
                                        : root.item-modal-kind == 3 ? "MÚSICA"
                                        : root.item-modal-kind == 4 ? "FONDO"
                                        : "OVERLAY";
                                    color: root.item-modal-mode == 2 ? #f87171 : Theme.accent-strong;
                                    font-size: 9.5px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.item-modal-mode == 0 ? "Opciones del archivo"
                                    : root.item-modal-mode == 1 ? "Cambiar nombre"
                                    : "Eliminar archivo";
                                color: root.item-modal-mode == 2 ? #f87171 : Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: root.item-modal-title;
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                            overflow: elide;
                        }
                    }
                    GlassButton {
                        label: "✕";
                        compact: true;
                        clicked => { root.item-modal-open = false; }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                // MODE 0: Full Action Sheet (Play / Queue / Rename / Delete)
                if root.item-modal-mode == 0 : VerticalLayout {
                    spacing: 7px;

                    GlassButton {
                        label: root.item-modal-kind == 3 ? "Reproducir pista ahora" : "Enviar a Pantalla / Reproducir";
                        icon: @image-url("icons/play.svg");
                        has-icon: true;
                        primary: true;
                        clicked => {
                            root.item-action-play(root.item-modal-kind, root.item-modal-path);
                            root.item-modal-open = false;
                        }
                    }
                    GlassButton {
                        label: root.item-modal-kind == 1 || root.item-modal-kind == 4 ? "Agregar a Cola de Videos"
                             : root.item-modal-kind == 5 ? "Agregar a Cola de Overlays"
                             : "Agregar a Cola de Servicio";
                        icon: @image-url("icons/list.svg");
                        has-icon: true;
                        clicked => {
                            root.item-action-queue(root.item-modal-kind, root.item-modal-path);
                            root.item-modal-open = false;
                        }
                    }
                    GlassButton {
                        label: "Cambiar Nombre";
                        icon: @image-url("icons/edit.svg");
                        has-icon: true;
                        clicked => {
                            root.item-modal-rename-input = root.item-modal-title;
                            root.item-modal-mode = 1;
                        }
                    }
                    GlassButton {
                        label: "Eliminar de la Biblioteca";
                        icon: @image-url("icons/trash.svg");
                        has-icon: true;
                        danger: true;
                        clicked => {
                            root.item-modal-mode = 2;
                        }
                    }
                }

                // MODE 1: Rename Input
                if root.item-modal-mode == 1 : VerticalLayout {
                    spacing: 9px;
                    LineEdit {
                        placeholder-text: "Nuevo nombre del archivo...";
                        text <=> root.item-modal-rename-input;
                        accepted(txt) => {
                            if (txt != "") {
                                root.item-action-rename(root.item-modal-kind, root.item-modal-path, txt);
                                root.item-modal-open = false;
                            }
                        }
                    }
                    Text {
                        text: "Se conservará la extensión original y se actualizarán colas y listas automáticamente.";
                        color: Theme.text-muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        GlassButton {
                            label: "Cancelar";
                            compact: true;
                            clicked => { root.item-modal-open = false; }
                        }
                        GlassButton {
                            label: "Guardar Nombre";
                            icon: @image-url("icons/save.svg");
                            has-icon: true;
                            compact: true;
                            primary: true;
                            clicked => {
                                if (root.item-modal-rename-input != "") {
                                    root.item-action-rename(root.item-modal-kind, root.item-modal-path, root.item-modal-rename-input);
                                    root.item-modal-open = false;
                                }
                            }
                        }
                    }
                }

                // MODE 2: Confirm Permanent Delete
                if root.item-modal-mode == 2 : VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: "¿Seguro que quieres eliminar este archivo de forma permanente? Si está en reproducción o en cola, se detendrá y quitará automáticamente.";
                        color: Theme.text-secondary;
                        font-size: 11.5px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        GlassButton {
                            label: "Cancelar";
                            compact: true;
                            clicked => { root.item-modal-open = false; }
                        }
                        GlassButton {
                            label: "Eliminar Definitivamente";
                            icon: @image-url("icons/trash.svg");
                            has-icon: true;
                            compact: true;
                            danger: true;
                            clicked => {
                                root.item-action-delete(root.item-modal-kind, root.item-modal-path);
                                root.item-modal-open = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // ═════════════════════════════════════════════════════════════════════════
    //  MODAL DE BIENVENIDA Y TUTORIAL RÁPIDO AL INICIO
    // ═════════════════════════════════════════════════════════════════════════
    if root.tutorial-modal-open : Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: #000000b8;
        z: 120;

        TouchArea { }

        Rectangle {
            width: min(580px, parent.width - 40px);
            height: min(600px, parent.height - 40px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-lg;
            background: Theme.bg-surface-0;
            border-width: 1.5px;
            border-color: Theme.accent.transparentize(0.45);
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000bb;
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: 10px;
                            clip: true;
                            background: root.has-logo ? transparent : @linear-gradient(145deg, #2563eb 0%, #0d9488 100%);
                            if root.has-logo : Image {
                                source: root.logo-image;
                                width: 40px;
                                height: 40px;
                                image-fit: cover;
                            }
                            if !root.has-logo : Image {
                                source: @image-url("icons/zap.svg");
                                width: 22px;
                                height: 22px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: #ffffff;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "¡Bienvenido a ProyecThor!";
                                color: Theme.text-primary;
                                font-size: 16px;
                                font-weight: 800;
                            }
                            Text {
                                text: "Guía rápida para empezar a proyectar en segundos";
                                color: Theme.text-muted;
                                font-size: 11.5px;
                            }
                        }
                    }
                    GlassButton {
                        label: "✕";
                        compact: true;
                        clicked => {
                            root.show-tutorial-on-start = !root.tutorial-dont-show-again;
                            root.tutorial-modal-open = false;
                            root.tutorial-preference-changed(root.show-tutorial-on-start);
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        padding-right: 6px;

                        for item in [
                            {
                                title: "1. Barra Superior de Módulos",
                                desc: "Cambia fácilmente entre Inicio, Canciones, Biblia, Videos, Música independiente, Documentos PDF, Cámara, Estilos, Pantallas, Redes, Ajustes y Ayuda.",
                                icon: @image-url("icons/layers.svg"),
                                accent: #3b82f6
                            },
                            {
                                title: "2. Canciones y Biblia en Tiempo Real",
                                desc: "Escribe cualquier palabra o verso de una canción para encontrarla al instante (el verso coincidente quedará marcado). En Biblia, escribe la primera letra del libro (ej. E → Ester 4:14) para filtrar al momento.",
                                icon: @image-url("icons/music.svg"),
                                accent: #10b981
                            },
                            {
                                title: "3. Monitor en Vivo (Público / LAN / Stage)",
                                desc: "A la derecha ves siempre lo que sale al proyector. Puedes alternar la vista entre Público, transmisión LAN y Stage, y controlar las Capas Activas.",
                                icon: @image-url("icons/monitor.svg"),
                                accent: #f59e0b
                            },
                            {
                                title: "4. Contenido: Fondos, Overlays y Estilos",
                                desc: "Agrega videos en bucle, imágenes, capas PNG transparentes o estilos de texto personalizados sin interrumpir la proyección actual.",
                                icon: @image-url("icons/palette.svg"),
                                accent: #8b5cf6
                            },
                            {
                                title: "5. Redes: LAN, Chat, Celular, Reloj y Luces OSC",
                                desc: "Envía video limpio por red local (OBS o Smart TV), controla la app desde tu celular escaneando el QR, usa el reloj de escenario o sincroniza luces OSC.",
                                icon: @image-url("icons/wifi.svg"),
                                accent: #06b6d4
                            }
                        ] : Rectangle {
                            border-radius: Theme.radius-md;
                            background: Theme.bg-surface-1;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            HorizontalLayout {
                                padding: 12px;
                                spacing: 12px;
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    y: 2px;
                                    border-radius: 9px;
                                    background: item.accent.transparentize(0.82);
                                    border-width: 1px;
                                    border-color: item.accent.transparentize(0.45);
                                    Image {
                                        source: item.icon;
                                        width: 18px;
                                        height: 18px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        colorize: item.accent;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    Text {
                                        text: item.title;
                                        color: Theme.text-primary;
                                        font-size: 12.5px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: item.desc;
                                        color: Theme.text-secondary;
                                        font-size: 11.5px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                HorizontalLayout {
                    alignment: space-between;
                    spacing: 12px;

                    Rectangle {
                        height: 32px;
                        border-radius: Theme.radius-sm;
                        background: tut-chk-ta.has-hover ? Theme.bg-surface-2 : transparent;
                        tut-chk-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.tutorial-dont-show-again = !root.tutorial-dont-show-again; }
                        }
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 10px;
                            spacing: 8px;
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: root.tutorial-dont-show-again ? Theme.accent : Theme.bg-input;
                                border-width: 1.5px;
                                border-color: root.tutorial-dont-show-again ? Theme.accent : Theme.border-medium;
                                if root.tutorial-dont-show-again : Text {
                                    text: "✓";
                                    color: Theme.accent-fg;
                                    font-size: 11px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "No volver a mostrar";
                                color: Theme.text-secondary;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        GlassButton {
                            label: "Cerrar";
                            primary: true;
                            clicked => {
                                root.show-tutorial-on-start = !root.tutorial-dont-show-again;
                                root.tutorial-modal-open = false;
                                root.tutorial-preference-changed(root.show-tutorial-on-start);
                            }
                        }
                    }
                }
            }
        }
    }
}
