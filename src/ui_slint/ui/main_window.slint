    // Set true in modo rendimiento / PCs modestas: pausa animaciones costosas (nieve, etc.)
    in-out property <bool> perf-reduce-motion: false;
    // Temas con fondo animado tipo "shift" (gradiente que respira). variant: 0=DarkShift, 1=AuroraShift
    in-out property <bool> theme-animated: false;
    in-out property <int> theme-anim-variant: 0;
