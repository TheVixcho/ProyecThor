    // Settings, Themes, GPU/NVENC, Upscalers & Updater
    in-out property <int> active-theme-idx: 0;
    in-out property <bool> fsr-enabled: true;
    in-out property <int> gpu-hwdec-mode: 0;        // 0=Auto, 1=NVIDIA(NVDEC/CUDA), 2=D3D11VA, 3=VAAPI/Vulkan, 4=CPU
    in-out property <bool> nvenc-enabled: false;
    in property <string> gpu-status-label: @tr("Detectando aceleración de hardware GPU...");
    in-out property <int> upscaler-mode: 2;         // 0=Off(Bilinear), 1=FSR 1.0, 2=FidelityFX CAS+, 3=NVIDIA NIS, 4=LanczosHQ 4K
    in-out property <float> upscaler-sharpness: 55.0; // 0..100%
    in-out property <bool> smooth-motion-60: false; // Interpolación 24/30 -> 60 FPS
    in-out property <bool> performance-mode: false;

    // ── Ahorro de energía: vista previa del operador y prioridad de salida ──
    // preview-enabled: si es false, el monitor de vista previa de la ventana
    //   del operador NO recibe frames (la salida pública al público sigue
    //   recibiendo el 100%). Ahorra una subida de textura y swap por frame.
    // preview-max-fps: tope duro de FPS para esa vista previa (0 = sin tope
    //   extra, usa la decimación inteligente de siempre; 1/5/15/30 = la vista
    //   previa se actualiza como mucho a esa tasa).
    // prioritize-output: "Modo salida". Fuerza la vista previa a su tasa más
    //   baja y libera el equipo para que el video que ve el público aproveche
    //   todo el CPU/GPU, sin importar qué pestaña del operador esté abierta.
    in-out property <bool> preview-enabled: true;
    in-out property <int>  preview-max-fps: 0;
    in-out property <bool> prioritize-output: false;

    // ── Idioma de la interfaz (i18n) ──────────────────────────────────────
    // Código corto del idioma activo ("es", "en", ...). Lo aplica C++ con
    // slint::select_bundled_translation(code); las cadenas marcadas con
    // @tr("...") en los .slint se re-traducen en vivo. Agregar un idioma a
    // futuro NO requiere tocar este archivo: basta un nuevo .po y sumar su
    // código a la lista de opciones del selector (ver settings_view.slint).
    in-out property <string> ui-language: "es";
    callback language-changed(string);

    in-out property <bool> fullscreen-output: true;

    // Selector de pantalla física para la ventana de proyección (Público).
    // monitor-names: etiquetas listas para mostrar ("Pantalla 1 — 1920×1080", …).
    // projection-monitor-idx: índice elegido; por defecto el backend prioriza
    // la pantalla secundaria para que la ventana no se abra en la equivocada.
    in property <[string]> monitor-names: [];
    in-out property <int> projection-monitor-idx: 0;
    in-out property <bool> enable-glass-translucency: true;
    in-out property <bool> enable-glass-sheen: true;
    in-out property <bool> enable-ambient-bg: true;
    // Christmas festive mode (snow + decorations), activated with theme 14 "Navideño"
