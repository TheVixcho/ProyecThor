// ProyecThor — Dynamic Theme Tokens (14 presets migrados desde ImGui)
export global Theme {
    // Deep Carbon & Neutral Lead Surfaces (default: Oscuro)
    in-out property <color> bg-root:          #08080a;
    in-out property <color> bg-surface-0:     #111113;
    in-out property <color> bg-surface-1:     #17171a;
    in-out property <color> bg-surface-2:     #212125;
    in-out property <color> bg-surface-hover: #2c2c31;
    in-out property <color> bg-glass:         #121215f2;
    in-out property <color> bg-input:         #0c0c0e;

    // Subtle Borders
    in-out property <color> border-subtle:    #ffffff12;
    in-out property <color> border-medium:    #ffffff24;
    in-out property <color> border-accent:    #a1a1aa88;

    // Typography
    in-out property <color> text-primary:     #f4f4f5;
    in-out property <color> text-secondary:   #a1a1aa;
    in-out property <color> text-muted:       #71717a;

    // Accent & Foreground over Accent
    in-out property <color> accent:           #d4d4d8;
    in-out property <color> accent-strong:    #f4f4f5;
    in-out property <color> accent-fg:        #09090b;
    in-out property <color> accent-soft:      #a1a1aa28;

    // Semantic Live & Alert Colors
    in-out property <color> live-green:       #22c55e;
    in-out property <color> live-green-soft:  #22c55e24;
    in-out property <color> stage-amber:      #f59e0b;
    in-out property <color> stage-amber-soft: #f59e0b24;
    in-out property <color> danger:           #ef4444;
    in-out property <color> danger-soft:      #ef444424;

    // Radii
    out property <length> radius-sm:          6px;
    out property <length> radius-md:          10px;
    out property <length> radius-lg:          14px;
    out property <length> radius-pill:        20px;
}
