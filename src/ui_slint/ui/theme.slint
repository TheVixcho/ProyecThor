// ProyecThor — Dynamic Apple Liquid Glass Theme Tokens (14 presets)
export global Theme {
    // Deep Carbon & Translucent Liquid Glass Surfaces (default: Oscuro)
    in-out property <color> bg-root:          #07070a;
    in-out property <color> bg-surface-0:     #121216d6;
    in-out property <color> bg-surface-1:     #1a1a20c8;
    in-out property <color> bg-surface-2:     #24242cd0;
    in-out property <color> bg-surface-hover: #30303ad8;
    in-out property <color> bg-glass:         #14141ac4;
    in-out property <color> bg-input:         #0b0b0ed8;

    // Specular Glass Rims & Borders
    in-out property <color> border-subtle:    #ffffff1c;
    in-out property <color> border-medium:    #ffffff30;
    in-out property <color> border-accent:    #a1a1aa99;
    in-out property <color> glass-rim-top:    #ffffff38;
    in-out property <color> glass-sheen:      #ffffff16;
    in-out property <color> shadow-ambient:   #00000055;

    // Typography
    in-out property <color> text-primary:     #f4f4f5;
    in-out property <color> text-secondary:   #a1a1aa;
    in-out property <color> text-muted:       #71717a;

    // Accent & Foreground over Accent
    in-out property <color> accent:           #d4d4d8;
    in-out property <color> accent-strong:    #f4f4f5;
    in-out property <color> accent-fg:        #09090b;
    in-out property <color> accent-soft:      #a1a1aa2c;

    // Semantic Live & Alert Colors
    in-out property <color> live-green:       #34c759;
    in-out property <color> live-green-soft:  #34c75928;
    in-out property <color> stage-amber:      #ff9f0a;
    in-out property <color> stage-amber-soft: #ff9f0a28;
    in-out property <color> danger:           #ff453a;
    in-out property <color> danger-soft:      #ff453a28;

    // Apple Liquid Glass Radii
    out property <length> radius-sm:          7px;
    out property <length> radius-md:          11px;
    out property <length> radius-lg:          16px;
    out property <length> radius-pill:        20px;
}
