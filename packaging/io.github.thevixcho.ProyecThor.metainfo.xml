<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.thevixcho.ProyecThor</id>
  <name>ProyecThor</name>
  <summary>Software de proyeccion de letras y presentaciones</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      ProyecThor es un software para proyectar letras de canciones,
      anuncios y presentaciones en pantallas externas.
    </p>
  </description>
  <launchable type="desktop-id">io.github.thevixcho.ProyecThor.desktop</launchable>
  <!-- Debe coincidir con MimeType= en io.github.thevixcho.ProyecThor.desktop
       -- esto es lo que hace que "Abrir con" en el explorador de archivos
       ofrezca ProyecThor para estos tipos, ademas de la entrada del .desktop. -->
  <provides>
    <mediatype>audio/mpeg</mediatype>
    <mediatype>audio/flac</mediatype>
    <mediatype>audio/x-wav</mediatype>
    <mediatype>audio/ogg</mediatype>
    <mediatype>audio/aac</mediatype>
    <mediatype>audio/mp4</mediatype>
    <mediatype>audio/x-ms-wma</mediatype>
    <mediatype>audio/opus</mediatype>
    <mediatype>audio/x-aiff</mediatype>
    <mediatype>video/mp4</mediatype>
    <mediatype>video/x-matroska</mediatype>
    <mediatype>video/x-msvideo</mediatype>
    <mediatype>video/quicktime</mediatype>
    <mediatype>video/webm</mediatype>
  </provides>
  <url type="homepage">https://github.com/TheVixcho/ProyecThor</url>
  <url type="bugtracker">https://github.com/TheVixcho/ProyecThor/issues</url>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.3.2" date="2026-01-01" />
  </releases>
</component>
